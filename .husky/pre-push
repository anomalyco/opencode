#!/bin/sh
# Check if bun version matches package.json
EXPECTED_VERSION=$(grep '"packageManager"' package.json | sed 's/.*"bun@\([^"]*\)".*/\1/')
CURRENT_VERSION=$(bun --version)

# Extract major.minor versions
EXPECTED_MAJOR_MINOR=$(echo $EXPECTED_VERSION | cut -d. -f1,2)
CURRENT_MAJOR_MINOR=$(echo $CURRENT_VERSION | cut -d. -f1,2)

if [ "$CURRENT_MAJOR_MINOR" != "$EXPECTED_MAJOR_MINOR" ]; then
  echo "Error: Bun major.minor version $CURRENT_MAJOR_MINOR does not match expected $EXPECTED_MAJOR_MINOR from package.json"
  exit 1
fi

if [ "$CURRENT_VERSION" != "$EXPECTED_VERSION" ]; then
  echo "Warning: Bun version $CURRENT_VERSION differs from expected version $EXPECTED_VERSION (patch difference only)"
fi
bun typecheck
