{
  "$schema": "https://v2-8-13.turborepo.dev/schema.json",
  "globalEnv": ["CI", "LEAKCODE_DISABLE_SHARE"],
  "globalPassThroughEnv": ["CI", "LEAKCODE_DISABLE_SHARE"],
  "tasks": {
    "typecheck": {},
    "build": {
      "dependsOn": [],
      "outputs": ["dist/**"]
    },
    "leak-code#test": {
      "dependsOn": ["^build"],
      "outputs": [],
