    "@leak-code/core#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@leak-code/app#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@leak-code/ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@leak-code/session-ui#test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
