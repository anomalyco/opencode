# Local dev / WebStorm / Vite
WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
COOKIE_PASSWORD=replace-with-32-char-secret
OPENCODE_WORKOS_ENABLED=true
# Staging / AuthKit test user for: bun run staging:test-session  →  my-auth.json
STAGING_TEST_EMAIL=
# Prefer base64 to avoid .env escaping issues: printf %s 'password' | base64
STAGING_TEST_PASSWORD_B64=
# STAGING_TEST_PASSWORD=
# STAGING_COOKIE_DOMAINS=127.0.0.1,localhost,.veritly.co.uk
# Playwright smoke (bun run smoke:browser) — optional:
# SMOKE_BASE_URL=http://127.0.0.1:4444/
# SMOKE_SETTLE_MS=4000
# SMOKE_HEADED=1
# SMOKE_BAD_RESPONSE_MAX_CHARS=16384
# SMOKE_FAIL_ON_BAD_HTTP=0

DATABASE_URL=postgresql://veritly:veritly@localhost:5432/veritly

DEV_FRONTEND_HOST=127.0.0.1
DEV_FRONTEND_PORT=4444
DEV_BACKEND_HOST=127.0.0.1
DEV_BACKEND_PORT=4096

VITE_UNIVER_BACKEND_URL=http://127.0.0.1:8000
VITE_UNIVER_SDK_WS=ws://127.0.0.1:18766/ws
VITE_UNIVER_LICENSE=

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AXIOM_TOKEN=
AXIOM_DATASET=
VITE_PUBLIC_AXIOM_TOKEN=
VITE_PUBLIC_AXIOM_DATASET=
VITE_PUBLIC_AXIOM_URL=https://api.axiom.co
VITE_PUBLIC_OTEL_LOG_LEVEL=warn
OTEL_LOG_LEVEL=warn
OTEL_EXPORTER_OTLP_TIMEOUT=60000
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=60000
VERITLY_OTLP_EXPORT_DEBUG=0

UNIVER_SDK_PORT=18766
VERITLY_WS_DEBUG=0
DEV_PROXY_TARGET=
VERITLY_TUNNEL_PUBLIC_HOST=
