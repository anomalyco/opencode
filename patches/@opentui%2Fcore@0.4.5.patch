+function columnWidth(text) {
+  let width = 0
+  for (const part of graphemes.segment(text)) {
+    width += part.segment === "\n" ? 1 : Bun.stringWidth(part.segment)
+  }
+  return width
+}
+
+function clusterEnd(text, offset, onlyInside) {
+  let col = 0
+  for (const part of graphemes.segment(text)) {
+    const next = col + (part.segment === "\n" ? 1 : Bun.stringWidth(part.segment))
+    if (onlyInside ? offset > col && offset < next : next > offset) return next
+    col = next
+  }
+  return offset
+}
+
