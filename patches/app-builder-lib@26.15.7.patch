diff --git a/templates/nsis/installer.nsi b/templates/nsis/installer.nsi
index 4b1f42e4e96ba2b3e7d6d8d2f9ee19b46779a422..777ae1f2e7b40bfb426c6e1c96eabba7611a968c 100644
--- a/templates/nsis/installer.nsi
+++ b/templates/nsis/installer.nsi
@@ -89,6 +89,168 @@ FunctionEnd
 
 !ifndef BUILD_UNINSTALLER
   !include "installUtil.nsh"
+
+  # OpenCode: drive the install progress bar monotonically inside a Function instead of letting NSIS
+  # update IDC_PROGRESS from section instruction offsets (which causes loops like CHECK_APP_RUNNING
+  # to flicker backwards and staged-update skips or Nsis7z::Extract to reset/jump the bar).
+  Var /GLOBAL progressBarHwnd
+  Var /GLOBAL progressBarPos
+  Var /GLOBAL bannerTextHwnd
+  Var /GLOBAL extractStartMs
+  Var /GLOBAL extractLastTextMs
+
+  Function initInstallProgress
+    StrCpy $progressBarHwnd 0
+    StrCpy $progressBarPos 0
+    StrCpy $bannerTextHwnd 0
+    StrCpy $extractStartMs 0
+    StrCpy $extractLastTextMs 0
+    ${IfNot} ${Silent}
+      FindWindow $0 "#32770" "" $HWNDPARENT
+      ${If} $0 != 0
+        GetDlgItem $progressBarHwnd $0 1004
+        ${If} $progressBarHwnd != 0
+          # Change the hidden control ID (1004 -> 1099) after SpiderBanner subclasses it so plugins
+          # such as Nsis7z cannot look up IDC_PROGRESS and reset the bar back to 0%.
+          System::Call 'user32::SetWindowLongW(p $progressBarHwnd, i -12, i 1099)'
+        ${EndIf}
+        FindWindow $1 "#32770" "" $HWNDPARENT $0
+        ${If} $1 != 0
+          GetDlgItem $bannerTextHwnd $1 1000
+        ${EndIf}
+      ${EndIf}
+    ${EndIf}
+  FunctionEnd
+
+  Function setInstallStatus
+    Exch $0
+    ${If} $bannerTextHwnd != 0
+      SendMessage $bannerTextHwnd ${WM_SETTEXT} 0 "STR:$0"
+    ${EndIf}
+    Pop $0
+  FunctionEnd
+
+  !macro setInstallStatus TEXT
+    Push `${TEXT}`
+    Call setInstallStatus
+  !macroend
+
+  Function setInstallProgress
+    Exch $0
+    ${If} $progressBarHwnd != 0
+      ${If} $0 > 30000
+        StrCpy $0 30000
+      ${EndIf}
+      ${If} $0 > $progressBarPos
+        StrCpy $progressBarPos $0
+        SendMessage $progressBarHwnd 0x0402 $0 0
+      ${EndIf}
+    ${EndIf}
+    Pop $0
+  FunctionEnd
+
+  Function advanceInstallProgress
+    Exch $0
+    Exch
+    Exch $1
+    Push $2
+    ${If} $progressBarHwnd != 0
+      IntOp $2 $progressBarPos + $1
+      ${If} $2 > $0
+        StrCpy $2 $0
+      ${EndIf}
+      Push $2
+      Call setInstallProgress
+    ${EndIf}
+    Pop $2
+    Pop $1
+    Pop $0
+  FunctionEnd
+
+  !macro setInstallProgress POS
+    Push ${POS}
+    Call setInstallProgress
+  !macroend
+
+  !macro advanceInstallProgress STEP CAP
+    Push ${STEP}
+    Push ${CAP}
+    Call advanceInstallProgress
+  !macroend
+
+  !ifndef ZIP_COMPRESSION
+    !ifndef APP_BUILD_DIR
+      Function onExtractProgress
+        Pop $R8
+        Pop $R9
+        Push $0
+        Push $1
+        Push $2
+        Push $3
+        ${If} $R9 != 0
+          # Map 7z extraction progress linearly into 45%..85% (13500..25500, span 12000).
+          System::Int64Op $R8 * 12000
+          Pop $0
+          System::Int64Op $0 / $R9
+          Pop $0
+          IntOp $0 $0 + 13500
+          Push $0
+          Call setInstallProgress
+
+          ${If} $bannerTextHwnd != 0
+            System::Call "kernel32::GetTickCount() i .r0"
+            ${If} $extractStartMs == 0
+              StrCpy $extractStartMs $0
+              StrCpy $extractLastTextMs 0
+            ${EndIf}
+            IntOp $1 $0 - $extractLastTextMs
+            ${If} $extractLastTextMs == 0
+            ${OrIf} $1 >= 80
+            ${OrIf} $R8 == $R9
+              StrCpy $extractLastTextMs $0
+              IntOp $1 $0 - $extractStartMs
+              System::Int64Op $R9 / 1048576
+              Pop $2
+              ${If} $2 > 0
+                System::Int64Op $R8 / 1048576
+                Pop $3
+                ${If} $1 >= 150
+                  System::Int64Op $R8 * 1000
+                  Pop $0
+                  System::Int64Op $1 * 1048576
+                  Pop $1
+                  System::Int64Op $0 / $1
+                  Pop $0
+                  ${If} $0 > 0
+                    Push "$(extracting) $3 / $2 MB ($0 MB/s)"
+                  ${Else}
+                    Push "$(extracting) $3 / $2 MB"
+                  ${EndIf}
+                ${Else}
+                  Push "$(extracting) $3 / $2 MB"
+                ${EndIf}
+              ${Else}
+                System::Int64Op $R9 / 1024
+                Pop $2
+                System::Int64Op $R8 / 1024
+                Pop $3
+                Push "$(extracting) $3 / $2 KB"
+              ${EndIf}
+              Call setInstallStatus
+            ${EndIf}
+          ${EndIf}
+        ${EndIf}
+        Pop $3
+        Pop $2
+        Pop $1
+        Pop $0
+      FunctionEnd
+    !endif
+  !endif
+
+  Function runInstallSection
+    !include "installSection.nsh"
+  FunctionEnd
 !endif
 
 Section "install" INSTALL_SECTION_ID
@@ -119,7 +281,7 @@ Section "install" INSTALL_SECTION_ID
           ${endIf}
       !endif
     !endif
-    !include "installSection.nsh"
+    Call runInstallSection
   !endif
 SectionEnd
 
