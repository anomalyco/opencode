# 派生镜像：在官方 opencode 镜像上 bake 云 CLI + MCP 运行时
# 用法：docker build --build-arg BASE_TAG=<官方tag> -f Dockerfile.tools -t ghcr.io/xieyucheng123/opencode-tools:<tag> .
# 注意：hcloud(KooCLI) 需要 glibc；若官方 base 是 Alpine/musl，hcloud 层会失败，
# 此时改用 --target glibc-variant 或另起 sidecar，见 README。
ARG BASE_TAG=latest
FROM ghcr.io/anomalyco/opencode:${BASE_TAG}

USER root

# 版本 pin（2026-09-30 在 hw41 上验证可用的版本；hcloud/tailscale 见各自小节）
ARG GH_VERSION=2.97.0
ARG ALIYUN_VERSION=3.3.16
# aliyun / gh / hcloud 走官方二进制包；oci 走 pip（版本号以 PyPI 为准，构建时解析）
ARG OCI_SPEC=oci-cli

SHELL ["/bin/sh", "-c"]

# 基础运行时：node（npx 类 MCP）+ python+pip（uvx/pip 类 MCP）+ ca 证书 + git（opencode 会话 checkpoint 必需）
# + openssh-client（ssh 远程运维；私钥走 compose env 注入，不进镜像）
# + msmtp（邮件通知；SMTP 账号密码走 compose .env 注入，不进镜像，见 docker/send-mail.sh）
# 同时兼容 apt（debian/ubuntu）和 apk（alpine）
# 官方底座已实测：Alpine 3.24.2（musl），自带 apk + libgcc/libstdc++。
# apk 注意：v3.24 起 openssh 拆包，openssh-client 为虚拟包（由 openssh-client-default 提供，
# 实测依赖自动带上 openssh-keygen + openssh-client-common，ssh/ssh-keygen/ssh-keyscan 全有）。
# glibc 动态二进制需 gcompat 垫片（hcloud 实测可用；wrangler 仅 API 类命令可用，
# 本地 workerd 调试跑不起来，要本地 dev 请改走 Debian sidecar）。
RUN if command -v apt-get >/dev/null 2>&1; then \
      apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-pip nodejs npm openssh-client msmtp \
      && rm -rf /var/lib/apt/lists/*; \
    elif command -v apk >/dev/null 2>&1; then \
      apk add --no-cache ca-certificates curl git python3 py3-pip nodejs npm gcompat openssh-client msmtp; \
    else echo "unsupported base OS" && exit 1; fi \
 && git --version && ssh -V

# gh：官方 tarball（Go 静态二进制，musl/glibc 通吃）
RUN ARCH="$(uname -m)"; case "$ARCH" in x86_64) GH_ARCH=amd64;; aarch64) GH_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/gh.tar.gz \
      "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_${GH_ARCH}.tar.gz" \
 && tar -xzf /tmp/gh.tar.gz -C /tmp \
 && mv "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}/bin/gh" /usr/local/bin/gh \
 && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_${GH_ARCH}" \
 && gh --version

# aliyun CLI v3：官方 tarball（Go 二进制）
RUN ARCH="$(uname -m)"; case "$ARCH" in x86_64) ALIYUN_ARCH=amd64;; aarch64) ALIYUN_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/aliyun.tgz \
      "https://github.com/aliyun/aliyun-cli/releases/download/v${ALIYUN_VERSION}/aliyun-cli-linux-${ALIYUN_VERSION}-${ALIYUN_ARCH}.tgz" \
 && tar -xzf /tmp/aliyun.tgz -C /tmp \
 && mv /tmp/aliyun /usr/local/bin/aliyun \
 && rm -f /tmp/aliyun.tgz \
 && aliyun --version

# hcloud（华为云 KooCLI）：官方文档推荐的 OBS latest 直链（按架构二选一）。
# 来源：https://support.huaweicloud.com/intl/en-us/qs-hcli/hcli_02_003_02.html
# 注意这是浮动 latest（华为官方即如此发布），如需 pin 请把 latest 换成版本路径。
RUN ARCH="$(uname -m)"; case "$ARCH" in x86_64) HCLOUD_ARCH=amd64;; aarch64) HCLOUD_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/hcloud.tgz \
      "https://ap-southeast-3-hwcloudcli.obs.ap-southeast-3.myhuaweicloud.com/cli/latest/huaweicloud-cli-linux-${HCLOUD_ARCH}.tar.gz" \
 && tar -xzf /tmp/hcloud.tgz -C /tmp \
 && mv /tmp/hcloud /usr/local/bin/hcloud \
 && rm -f /tmp/hcloud.tgz \
 && hcloud version

# oci-cli：pip 安装（Oracle 官方发布到 PyPI）
RUN pip3 install --no-cache-dir --break-system-packages "${OCI_SPEC}" \
 && oci --version

# markitdown：微软官方（PyPI），只装 CLI（markitdown 命令）。
# 来源：https://github.com/microsoft/markitdown
# 注意：曾同时装 markitdown-mcp（MCP 薄包装），两者依赖互斥导致构建失败；
# CLI 与 MCP 功能重叠，按 CLI 优先只留 CLI。
RUN pip3 install --no-cache-dir --break-system-packages markitdown \
 && markitdown --version

# wrangler：Cloudflare 官方 CLI（npm 全局安装，需 node，已备好）
RUN npm install -g wrangler \
 && wrangler --version

# tailscale：官方静态二进制（stable 页已验证存在的版本，按架构二选一）。
# 来源：https://pkgs.tailscale.com/stable/ （注意：GH tag v1.102.5 先行，pkgs 包只到 1.102.4）
# 容器运行时需 --device=/dev/net/tun 并执行 tailscale up 登录。
ARG TAILSCALE_VERSION=1.102.4
RUN ARCH="$(uname -m)"; case "$ARCH" in x86_64) TS_ARCH=amd64;; aarch64) TS_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/tailscale.tgz \
      "https://pkgs.tailscale.com/stable/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}.tgz" \
 && tar -xzf /tmp/tailscale.tgz -C /tmp \
 && mv "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}/tailscale" /usr/local/bin/tailscale \
 && mv "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}/tailscaled" /usr/local/bin/tailscaled \
 && rm -rf /tmp/tailscale.tgz "/tmp/tailscale_${TAILSCALE_VERSION}_${TS_ARCH}" \
 && tailscale version

# lmnr：Laminar 官方 CLI（npm 包 lmnr-cli：鉴权、SQL 查 trace、管数据集），全局安装。
# 来源：https://laminar.sh/docs/platform/cli
# 注意：可观测打点插件（上传 trace）已按要求剔除；MCP 查询与 CLI 功能重叠，按 CLI 优先只留 CLI。
RUN npm install -g lmnr-cli \
 && npx -y lmnr-cli --version

# terraform:HashiCorp official zip (Go static binary, musl/glibc universal; unpack with python, no unzip needed).
ARG TERRAFORM_VERSION=1.16.5
RUN ARCH="$(uname -m)"; case "$ARCH" in x86_64) TF_ARCH=amd64;; aarch64) TF_ARCH=arm64;; *) echo "unsupported arch $ARCH" && exit 1;; esac \
 && curl -fsSL -o /tmp/terraform.zip \
      "https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_${TF_ARCH}.zip" \
 && python3 -c "import zipfile; zipfile.ZipFile('/tmp/terraform.zip').extract('terraform', '/tmp')" \
 && mv /tmp/terraform /usr/local/bin/terraform \
 && chmod +x /usr/local/bin/terraform \
 && rm -f /tmp/terraform.zip \
 && terraform version
# agent-browser：Vercel Labs 出的 agent 浏览器 CLI（Rust 原生，经 CDP 驱浏览器）。
# 来源：https://github.com/vercel-labs/agent-browser
# 注意：只装 CLI，不运行 `agent-browser install`（那会把 Chrome 烘进 tools 镜像）。
# 浏览器由 compose 里独立的 browser sidecar 提供（chrome-cjk 镜像），CLI 经 --cdp 连它。
# release 自带 linux-musl 二进制（agent-browser-linux-musl-x64），Alpine 底座可用。
ARG AGENT_BROWSER_VERSION=0.39.0
RUN npm install -g "agent-browser@${AGENT_BROWSER_VERSION}" \
  && agent-browser --version

# 非涉密默认配置烘入镜像（各机器行为一致；密钥仍走 env/挂载，不进镜像）：
# - opencode.jsonc：默认模型走 LiteLLM 网关，地址/key 由 {env:} 注入
# - AGENTS.md：agent 使用说明（直连模型通用版）
# 注意：部署侧不要再挂载这两个文件，否则会盖住烘入的版本。
COPY docker/opencode.jsonc docker/AGENTS.md /root/.config/opencode/
# - send-mail：msmtp 薄包装（配置全走 SMTP_* 环境变量，见 docker/send-mail.sh）
COPY docker/send-mail.sh /usr/local/bin/send-mail
RUN chmod +x /usr/local/bin/send-mail && msmtp --version && send-mail --help >/dev/null
# - markitdown：local stdio，command ["markitdown-mcp"]（已随上一步装好）
# - cloudflare：远端 Code Mode server（官方 recommended），https://mcp.cloudflare.com/mcp
# - tailscale：官方远端 https://tailscale.mcp.kapa.ai/（零安装，见 https://tailscale.com/docs/develop-with-ai）
# - lmnr：Laminar 可观测是 opencode 插件（lmnr-ai/lmnr-opencode-plugin），非二进制，见 https://laminar.sh/docs/integrations/opencode
