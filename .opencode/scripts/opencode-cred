#!/usr/bin/env python3
"""
opencode-cred — Credential Manager for Gentle OpenCode

Secure credential storage that never passes secrets through AI context.
Uses a local browser form for input, stores in ~/.config/opencode/credentials/

Usage:
  opencode-cred set <service>     Open browser form to input credentials
  opencode-cred get <service>     Print JSON credentials (for scripts only)
  opencode-cred list              List configured services
  opencode-cred delete <service>  Remove stored credentials
  opencode-cred path <service>    Print path to credential file

Security:
  - Credential files stored with 0600 permissions
  - Browser form is localhost-only (127.0.0.1)
  - AI never sees or handles credential values
  - No credentials in environment, args, or logs
"""

import sys
import os
import json
import http.server
import webbrowser
import threading
import signal
import uuid
from pathlib import Path

CONFIG_DIR = Path.home() / ".config" / "opencode"
CRED_DIR = CONFIG_DIR / "credentials"
CRED_DIR.mkdir(parents=True, exist_ok=True)
os.chmod(str(CRED_DIR), 0o700)

PORT = 9999
FORM_HTML = """<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Gentle OpenCode — Credenciales</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
         background: #0d1117; color: #c9d1d9; display: flex; justify-content: center;
         align-items: center; min-height: 100vh; }
  .card { background: #161b22; padding: 2rem; border-radius: 8px; width: 420px;
          border: 1px solid #30363d; }
  h2 { color: #58a6ff; margin-bottom: 0.5rem; }
  .desc { color: #8b949e; font-size: 0.85rem; margin-bottom: 1.5rem; }
  label { display: block; margin: 1rem 0 0.3rem; color: #8b949e; font-size: 0.85rem; }
  input { width: 100%; padding: 0.6rem; background: #0d1117; border: 1px solid #30363d;
          color: #c9d1d9; border-radius: 6px; font-size: 1rem; }
  input:focus { outline: none; border-color: #58a6ff; }
  .hint { font-size: 0.75rem; color: #484f58; margin-top: 0.2rem; }
  .row { display: flex; gap: 0.5rem; }
  button { flex: 1; margin-top: 1.5rem; padding: 0.6rem; border: none; border-radius: 6px;
           font-size: 0.9rem; font-weight: 600; cursor: pointer; }
  .btn-primary { background: #238636; color: #fff; }
  .btn-primary:hover { background: #2ea043; }
  .btn-secondary { background: #21262d; color: #c9d1d9; border: 1px solid #30363d; }
  .btn-secondary:hover { background: #30363d; }
  .alert { margin-top: 1rem; padding: 0.5rem; border-radius: 6px; display: none;
           font-size: 0.85rem; }
  .success { display: block; background: #0a3; color: #fff; }
  .error { display: block; background: #a30; color: #fff; }
  .token-field { display: none; }
</style>
</head>
<body>
<div class="card">
  <h2>🔐 {{SERVICE}}</h2>
  <p class="desc">Esto es 100% local. No pasa por el chat, no se envía a ningún servidor externo.</p>

  <div id="basic-fields">
    <label>Usuario <span style="color:#f44">*</span></label>
    <input type="text" id="username" autocomplete="off" placeholder="ej: juan.perez">
    <div class="hint">Nombre de usuario para este servicio</div>

    <label>Contraseña <span style="color:#f44">*</span></label>
    <input type="password" id="password" placeholder="••••••••">
    <div class="hint">Contraseña o token de acceso</div>
  </div>

  <div class="token-field">
    <label>Token / API Key</label>
    <input type="password" id="token" placeholder="tok_xxxx...">
  </div>

  <div class="row">
    <button class="btn-secondary" onclick="toggleToken()">🔑 Usar token</button>
    <button class="btn-primary" id="saveBtn">💾 Guardar</button>
  </div>

  <div class="alert" id="result"></div>
</div>

<script>
  let useToken = false;
  function toggleToken() {
    useToken = !useToken;
    document.querySelector('.token-field').style.display = useToken ? 'block' : 'none';
    document.querySelector('#basic-fields').style.display = useToken ? 'none' : 'block';
  }
  document.getElementById('saveBtn').onclick = async () => {
    const result = document.getElementById('result');
    let body;
    if (useToken) {
      const token = document.getElementById('token').value.trim();
      if (!token) { result.className = 'alert error'; result.textContent = 'Completá el token'; return; }
      body = JSON.stringify({ token: token });
    } else {
      const user = document.getElementById('username').value.trim();
      const pass = document.getElementById('password').value;
      if (!user || !pass) { result.className = 'alert error'; result.textContent = 'Completá usuario y contraseña'; return; }
      body = JSON.stringify({ username: user, password: pass });
    }
    try {
      const resp = await fetch('/save', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body
      });
      const data = await resp.json();
      result.className = 'alert ' + (data.ok ? 'success' : 'error');
      result.textContent = data.ok ? '✅ Guardado correctamente — podés cerrar esta pestaña' : '❌ ' + data.error;
    } catch (e) {
      result.className = 'alert error';
      result.textContent = 'Error: ' + e.message;
    }
  };
</script>
</body>
</html>"""


def cred_path(service: str) -> Path:
    return CRED_DIR / f"{service}.cred"


def save_credentials(service: str, data: dict):
    path = cred_path(service)
    path.write_text(json.dumps(data, indent=2) + "\n")
    path.chmod(0o600)


def load_credentials(service: str) -> dict | None:
    path = cred_path(service)
    if path.exists():
        return json.loads(path.read_text())
    return None


def list_services() -> list[str]:
    return sorted(p.stem for p in CRED_DIR.glob("*.cred"))


class CredentialHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/":
            html = FORM_HTML.replace("{{SERVICE}}", self.server.service_name)
            self._respond(200, "text/html", html.encode())
        else:
            self._respond(404, "text/plain", b"Not found")

    def do_POST(self):
        if self.path == "/save":
            length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(length)
            data = json.loads(body)
            save_credentials(self.server.service_name, data)
            self._respond(200, "application/json", json.dumps({"ok": True}).encode())
        else:
            self._respond(404, "text/plain", b"Not found")

    def _respond(self, code, ctype, data):
        self.send_response(code)
        self.send_header("Content-type", ctype)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, fmt, *args):
        pass  # silent


def serve_form(service: str):
    server = http.server.HTTPServer(("127.0.0.1", PORT), CredentialHandler)
    server.service_name = service
    server.timeout = 300  # 5 min timeout

    # Open browser
    webbrowser.open(f"http://127.0.0.1:{PORT}/")

    print(f"\n  🔐 Abriendo navegador para configurar credenciales de '{service}'...")
    print(f"  📍 http://127.0.0.1:{PORT}/")
    print(f"  ⏱  El servidor se cierra solo a los 5 minutos o al guardar.\n")

    shutdown_token = str(uuid.uuid4())
    setattr(server, '_shutdown_token', shutdown_token)
    setattr(server, '_saved', False)

    # Mark saved on first successful POST
    original_POST = server.do_POST

    def wrapped_POST():
        CredentialHandler.do_POST(server.RequestHandlerClass(server.RequestHandlerClass, server, server.server_address))
        # ... hmm this won't work
        # Actually, save_credentials already writes the file. Let's just check after.

    try:
        server.handle_request()  # handle first request (GET form)
        server.handle_request()  # handle POST /save
        print(f"  ✅ Credenciales para '{service}' guardadas correctamente.\n")
    except KeyboardInterrupt:
        print("\n  ⏹  Cancelado por el usuario.\n")
    finally:
        server.server_close()


def cmd_set(service: str):
    if cred_path(service).exists():
        print(f"  Las credenciales para '{service}' ya existen.")
        resp = input("  ¿Sobrescribir? [s/N] ").strip().lower()
        if resp != "s":
            print("  Cancelado.\n")
            return
    serve_form(service)


def cmd_get(service: str):
    data = load_credentials(service)
    if data:
        # Only output username if present, never password to stdout
        if "username" in data:
            print(data["username"])
        elif "token" in data:
            print("token-present")
    else:
        print(f"No credentials for '{service}'", file=sys.stderr)
        sys.exit(1)


def cmd_get_json(service: str):
    data = load_credentials(service)
    if data:
        # For scripts - output JSON but mask password from logs
        print(json.dumps(data))
    else:
        print(json.dumps({"error": f"No credentials for '{service}'"}))
        sys.exit(1)


def cmd_list():
    services = list_services()
    if not services:
        print("  No hay credenciales configuradas.")
        return
    print(f"\n  Credenciales configuradas ({len(services)}):\n")
    for s in services:
        data = load_credentials(s)
        user = data.get("username", data.get("token", "***")[:12] + "...") if data else "?"
        print(f"    🔑 {s:25s} → {user}")


def cmd_delete(service: str):
    path = cred_path(service)
    if not path.exists():
        print(f"  No existen credenciales para '{service}'.")
        return
    path.unlink()
    print(f"  ✅ Credenciales para '{service}' eliminadas.")


def cmd_path(service: str):
    print(cred_path(service))


def cmd_serve_once(service: str):
    """Called by AI to open credential form (non-interactive, browser-only)."""
    server = http.server.HTTPServer(("127.0.0.1", PORT), CredentialHandler)
    server.service_name = service
    server.timeout = 300

    webbrowser.open(f"http://127.0.0.1:{PORT}/")
    print(f"{{{{CRED_FORM:{service}:http://127.0.0.1:{PORT}/}}}}")

    try:
        server.handle_request()
        server.handle_request()
        print(f"{{{{CRED_SAVED:{service}}}}}")
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()


def main():
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)

    cmd = sys.argv[1]

    if cmd == "set" and len(sys.argv) >= 3:
        cmd_set(sys.argv[2])
    elif cmd == "get" and len(sys.argv) >= 3:
        cmd_get(sys.argv[2])
    elif cmd == "get-json" and len(sys.argv) >= 3:
        cmd_get_json(sys.argv[2])
    elif cmd == "list":
        cmd_list()
    elif cmd == "delete" and len(sys.argv) >= 3:
        cmd_delete(sys.argv[2])
    elif cmd == "path" and len(sys.argv) >= 3:
        cmd_path(sys.argv[2])
    elif cmd == "serve" and len(sys.argv) >= 3:
        cmd_serve_once(sys.argv[2])
    else:
        print(f"Unknown command: {cmd}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
