{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  // "plugin": ["opencode-openai-codex-auth"],
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    // Shopify Storefront MCP - Uses Mock.shop free public API
    // No authentication required - uses Shopify's official mock product data
    // Tools provided by MCP:
    //   - shopify-mock_search_shop_catalog: Search products by keyword, category, filters
    //   - shopify-mock_search_shop_policies_and_faqs: Query store policies, FAQs, shipping info
    //   - shopify-mock_get_cart: Retrieve cart contents
    //   - shopify-mock_update_cart: Modify cart (add/update/remove items)
    // Location: /tmp/ShopifyMockMCP (installed locally)
    // Data source: https://mock.shop (Shopify's official demo GraphQL API)
    "shopify-mock": {
      "type": "local",
      "command": ["node", "/tmp/ShopifyMockMCP/dist/server.js"],
      "enabled": true,
      "timeout": 15000, // Increased for API latency
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
