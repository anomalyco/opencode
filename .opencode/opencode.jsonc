{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["STYLE_GUIDE.md"],
  // Ralph Wiggum plugin for iterative development loops
  "plugin": [
    "file:///Users/pavittra/suresh/opencode/packages/opencode/.opencode/plugins/ralph-wiggum.ts",
  ],
  "permission": {
    "bash": {
      "ls foo": "ask",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    "obsidian-tools": {
      "type": "local",
      "command": ["node", "/Users/suressan/github_manager/repos/obsidian-tools-mcp/dist/index.js"],
      "environment": {
        "OBSIDIAN_VAULT_PATH": "/Users/suressan/Library/CloudStorage/OneDrive-Cisco/Obsidian/suresh",
      },
    },
    "browseros": {
      "type": "remote",
      "url": "http://127.0.0.1:9101/mcp",
    },
    "hivemind": {
      "type": "local",
      "command": [
        "/Users/suressan/.nvm/versions/node/v22.21.1/bin/node",
        "/Users/suressan/github_manager/repos/mcp-subagent-orchestrator/dist/bin/mcp-server.js",
      ],
      "environment": {
        "PATH": "/Users/suressan/.nvm/versions/node/v22.21.1/bin:/usr/local/bin:/usr/bin:/bin",
        "OTEL_ENABLED": "true",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
      },
    },
    "jira-mcp": {
      "type": "remote",
      "url": "http://mcp-servers.cisco.com/jira/",
    },
    "atlassian-mcp": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/sse",
    },
    "openmemory": {
      "type": "remote",
      "url": "http://127.0.0.1:8082/mcp",
    },
    "cass": {
      "type": "remote",
      "url": "http://localhost:8888/sse",
    },
  },
  "tools": {
    "github-triage": false,
  },
}
