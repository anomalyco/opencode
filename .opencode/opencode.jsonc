{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  // "plugin": ["opencode-openai-codex-auth"],
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "instructions": [
    "STYLE_GUIDE.md"
  ],
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    // Shopify Storefront MCP - Uses Mock.shop free public API
    // No authentication required - uses Shopify's official mock product data
    // Tools provided by MCP:
    //   - shopify-mock_search_shop_catalog: Search products by keyword, category, filters
    //   - shopify-mock_search_shop_policies_and_faqs: Query store policies, FAQs, shipping info
    //   - shopify-mock_get_cart: Retrieve cart contents
    //   - shopify-mock_update_cart: Modify cart (add/update/remove items)
    // Location: /tmp/ShopifyMockMCP (installed locally)
    // Data source: https://mock.shop (Shopify's official demo GraphQL API)
    "shopify-mock": {
      "type": "local",
      "command": [
        "node",
        "/tmp/ShopifyMockMCP/dist/server.js"
      ],
      "enabled": true,
      "timeout": 15000, // Increased for API latency
    },
    // Hydrogen Demo Store MCP - Uses Shopify's Hydrogen preview store
    // Public Storefront API token provided
    // Tools provided by MCP:
    //   - hydrogen-mcp_findProducts: Search products (snowboards, apparel, accessories)
    //   - hydrogen-mcp_getProductById: Get detailed product info by ID
    //   - hydrogen-mcp_getCollectionById: Get collection details
    //   - hydrogen-mcp_findCollections: Browse collections
    //   - hydrogen-mcp_cartCreate: Create shopping cart
    //   - hydrogen-mcp_getCart: Retrieve cart contents
    // Location: /tmp/HydrogenMCP (installed locally)
    // Data source: https://hydrogen-preview.myshopify.com (Shopify's Hydrogen Demo Store)
    // Access Token: 3b580e70970c4528da70c98e097c2fa0
    "hydrogen-store": {
      "type": "local",
      "command": [
        "node",
        "/tmp/HydrogenMCP/dist/server.js"
      ],
      "enabled": true,
      "timeout": 15000, // Increased for API latency
    },
    "amazon-mcp": {
      "type": "local",
      "command": [
        "mcps/amazon-mcp/.venv/bin/python",
        "mcps/amazon-mcp/server_v2.py"
      ],
      "enabled": true,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}