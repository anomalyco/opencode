{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "planner",
  // "plugin": ["opencode-openai-codex-auth"],
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
    // ShopifyMockMCP - Uses Mock.shop free public API
    // No authentication required - uses Shopify's official mock data
    // Tools: search_shop_catalog, search_shop_policies_and_faqs, get_cart, update_cart
    // Location: /tmp/ShopifyMockMCP (installed locally)
    "shopify-mock": {
      "type": "local",
      "command": ["node", "/tmp/ShopifyMockMCP/dist/server.js"],
      "enabled": true,
      "timeout": 10000,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
