{
  "$schema": "https://opencode.ai/config.json",
  // "enterprise": {
  //   "url": "https://enterprise.dev.opencode.ai",
  // },
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "mcp": {
    "exa": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "set -a; . \"$HOME/.config/opencode/.env\"; set +a; npx -y exa-mcp-server"
      ],
      "timeout": 60000,
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
