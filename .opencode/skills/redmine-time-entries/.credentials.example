# =============================================================================
# REDMINE CREDENTIALS — Plantilla
# =============================================================================
# 
# INSTRUCCIONES:
# 1. Copiá este archivo a .credentials (sin el .example)
#    cp .credentials.example .credentials
#
# 2. Reemplazá los valores de abajo con TUS credenciales reales
#
# 3. NUNCA compartas este archivo, NUNCA lo commitees a git,
#    NUNCA pegues las credenciales en el chat de OpenCode.
#
# 4. Alternativa: usá variables de entorno en vez del archivo
#    export REDMINE_USER=tu_usuario
#    export REDMINE_PASS=tu_contraseña
#    (El skill las lee automáticamente, sin archivo en disco)
#
# El skill carga las credenciales en este orden:
#   1. Variables de entorno REDMINE_USER / REDMINE_PASS (más seguro)
#   2. Archivo .credentials (este archivo)
# =============================================================================

REDMINE_USER=TU_USUARIO
REDMINE_PASS=TU_CONTRASEÑA
