{
  "name": "opencode",
  "displayName": "opencode",
  "description": "opencode for VS Code",
  "version": "1.2.21",
  "publisher": "sst-dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/opencode"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#000000",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:sst-dev.opencode",
    "onChatSession:sst-dev.opencode",
    "onCommand:opencode.activate",
    "onCommand:opencode.openTerminal",
    "onCommand:opencode.openNewTerminal",
    "onCommand:opencode.addFilepathToTerminal"
  ],
  "enabledApiProposals": [
    "chatSessionsProvider@3",
    "chatSessionsProvider"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "chatParticipants": [
      {
        "id": "sst-dev.opencode",
        "name": "opencode",
        "fullName": "OpenCode",
        "description": "AI coding assistant powered by OpenCode",
        "isSticky": true,
        "commands": [
          {
            "name": "new",
            "description": "Start a new session"
          },
          {
            "name": "clear",
            "description": "Clear conversation"
          }
        ]
      }
    ],
    "chatSessions": [
      {
        "type": "sst-dev.opencode",
        "name": "opencode",
        "displayName": "OpenCode",
        "description": "AI coding assistant powered by OpenCode",
        "icon": "images/icon.png",
        "welcomeTitle": "OpenCode",
        "welcomeMessage": "Ask OpenCode to help with your code.",
        "inputPlaceholder": "Ask OpenCode anything...",
        "commands": [
          {
            "name": "new",
            "description": "Start a new session"
          },
          {
            "name": "clear",
            "description": "Clear conversation"
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "opencode.activate",
        "title": "OpenCode: Activate"
      },
      {
        "command": "opencode.openTerminal",
        "title": "Open opencode",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Open opencode in new tab",
        "icon": {
          "light": "images/button-dark.svg",
          "dark": "images/button-light.svg"
        }
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "Add Filepath to Terminal"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "opencode.openNewTerminal",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "opencode.openTerminal",
        "title": "Run opencode",
        "key": "cmd+escape",
        "mac": "cmd+escape",
        "win": "ctrl+escape",
        "linux": "ctrl+escape"
      },
      {
        "command": "opencode.openNewTerminal",
        "title": "Run opencode",
        "key": "cmd+shift+escape",
        "mac": "cmd+shift+escape",
        "win": "ctrl+shift+escape",
        "linux": "ctrl+shift+escape"
      },
      {
        "command": "opencode.addFilepathToTerminal",
        "title": "opencode: Insert At-Mentioned",
        "key": "cmd+alt+k",
        "mac": "cmd+alt+k",
        "win": "ctrl+alt+K",
        "linux": "ctrl+alt+K"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "bun run package",
    "compile": "bun run check-types && bun run lint && node esbuild.js",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "bun run check-types && bun run lint && node esbuild.js --production",
    "compile-tests": "tsc -p tsconfig.test.json",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "bun run compile-tests && bun run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test run --config .vscode-test.mjs",
    "test:e2e:stable": "xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' vscode-test run --config .vscode-test.mjs --label e2e-stable -- --disable-gpu --headless",
    "test:e2e:insiders": "xvfb-run --auto-servernum --server-args='-screen 0 1280x720x24' vscode-test run --config .vscode-test.mjs --label e2e-insiders --version insiders -- --disable-gpu --headless"
  },
  "devDependencies": {
    "@types/vscode": "^1.94.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^9.25.1",
    "esbuild": "^0.25.3",
    "typescript": "^5.8.3",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@playwright/test": "^1.40.0"
  }
}
