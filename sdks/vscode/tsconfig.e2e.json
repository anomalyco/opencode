{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "dom"],
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "./out/e2e",
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "src/e2e/**/*.ts"],
  "exclude": ["node_modules", "out", "dist"]
}
