{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode.ai/schemas/v1/textPart.json",
  "$comment": "Source: packages/opencode/src/session/message-v2.ts @ current lines 81-96",
  "title": "TextPart",
  "description": "Text content part with optional timing and metadata",
  "type": "object",
  "required": ["id", "sessionID", "messageID", "type", "text"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Part identifier"
    },
    "sessionID": {
      "type": "string",
      "description": "Session identifier"
    },
    "messageID": {
      "type": "string",
      "description": "Message identifier"
    },
    "type": {
      "type": "string",
      "const": "text",
      "description": "Part type discriminator"
    },
    "text": {
      "type": "string",
      "description": "Text content"
    },
    "synthetic": {
      "type": "boolean",
      "description": "Whether this text was synthetically generated"
    },
    "ignored": {
      "type": "boolean",
      "description": "Whether this text should be ignored in processing"
    },
    "time": {
      "type": "object",
      "description": "Timing information",
      "required": ["start"],
      "properties": {
        "start": {
          "type": "number",
          "description": "Start timestamp (ms)"
        },
        "end": {
          "type": "number",
          "description": "End timestamp (ms)"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional metadata"
    }
  }
}
