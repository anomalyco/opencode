{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://opencode.ai/schemas/v1/compactionPart.json",
  "$comment": "Source: packages/opencode/src/session/message-v2.ts @ current lines 178-184",
  "title": "CompactionPart",
  "description": "Compaction marker part indicating message history was compacted",
  "type": "object",
  "required": ["id", "sessionID", "messageID", "type", "auto"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Part identifier"
    },
    "sessionID": {
      "type": "string",
      "description": "Session identifier"
    },
    "messageID": {
      "type": "string",
      "description": "Message identifier"
    },
    "type": {
      "type": "string",
      "const": "compaction",
      "description": "Part type discriminator"
    },
    "auto": {
      "type": "boolean",
      "description": "Whether compaction was automatic"
    }
  }
}
