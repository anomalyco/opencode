ev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L81"}, {"caller_nid": "src_clipboard_copycommand", "callee": "has", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L82"}, {"caller_nid": "src_clipboard_copycommand", "callee": "has", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L83"}, {"caller_nid": "src_clipboard_copycommand", "callee": "has", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L84"}, {"caller_nid": "src_clipboard_copycommand", "callee": "has", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L85"}, {"caller_nid": "src_clipboard_getcopymethod", "callee": "(async () => {\n    const { which } = await import(\"@opencode-ai/core/util/which\")\n    const native = copyCommand(platform(), Boolean(process.env.WAYLAND_DISPLAY), (name) => Boolean(which(name)))\n    if (native?.[0] === \"osascript\") {\n      return async (text: string) => {\n        const escaped = text.replace(/\\\\/g, \"\\\\\\\\\").replace(/\"/g, '\\\\\"')\n        await command(\"osascript\", [\"-e\", `set the clipboard to \"${escaped}\"`]).catch(() => undefined)\n      }\n    }\n    if (native) {\n      return async (text: string) => {\n        await command(native[0], native.slice(1), text).catch(() => undefined)\n      }\n    }\n    return async (text: string) => {\n      const { default: clipboardy } = await import(\"clipboardy\")\n      await clipboardy.write(text).catch(() => undefined)\n    }\n  })", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L99"}, {"caller_nid": "src_clipboard_write", "callee": "method", "is_member_call": false, "source_file": "/Users/andreas/dev/opencode-skein/packages/tui/src/clipboard.ts", "source_location": "L123"}]}