// local-only: Konfiguration, die alle per Config abschaltbaren Internet-Zugriffe von opencode sperrt.
// Ablage: ~/.config/opencode/opencode.jsonc (global) oder <projekt>/opencode.jsonc.
// Bewusst ohne "$schema": Editoren würden das Schema sonst von opencode.ai laden.
{
  // Standardmodell fest vorgeben ("<provider>/<modell-id>", wie `opencode models` es auflistet).
  // Sonst wählt opencode evtl. ein Katalogmodell von Ollama/LM Studio, auch wenn dort kein Server läuft (ECONNREFUSED).
  "model": "firma/modell-id",

  // Kein Update-Check gegen opencode.ai / formulae.brew.sh (packages/cli/src/services/updater.ts)
  "update": "disable",

  // Kein Teilen von Sessions über opencode.ai
  "share": "disabled",

  // Websuche: fest im Programm gesperrt (packages/core/src/config/builtin.ts), hier nicht einstellbar.
  // Grund: Suchanfragen des Modells können Code aus der Session an einen externen Dienst schicken.

  // Kein automatisches Nachinstallieren von prettier/oxfmt/biome aus der npm-Registry
  "formatter": false,

  // Tool-Rechte: letzte passende Regel gewinnt (packages/core/src/permission.ts)
  "permissions": [
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    // Optional: webfetch ins Internet freigeben, mit Rückfrage vor jedem Abruf (zusätzlich die tool.use-Freigabe
    // unter "policies" einkommentieren und für den Dienst HTTPS_PROXY/NO_PROXY setzen).
    // Die Rückfrage ist die eigentliche Schutzschicht: das Modell kann Text in Pfad oder Parameter der URL packen.
    // { "action": "webfetch", "resource": "*", "effect": "ask" },
    // Nur Loopback erlauben (z. B. lokale Doku-Server)
    { "action": "webfetch", "resource": "http://localhost*", "effect": "allow" },
    { "action": "webfetch", "resource": "http://127.0.0.1*", "effect": "allow" },
    { "action": "experimental_image_generate", "resource": "*", "effect": "deny" }
  ],

  // Policies: letzte passende Regel gewinnt (packages/core/src/managed-policy.ts)
  "policies": [
    // Alle Cloud-Provider und Konten-Anbindungen (opencode Console, Copilot, ChatGPT, ...) sperren
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "integration.connect", "resource": "*", "effect": "deny" },
    { "action": "integration.use", "resource": "*", "effect": "deny" },
    { "action": "tool.use", "resource": "webfetch:*", "effect": "deny" },
    // Optional: webfetch wieder zulassen (gehört zur "ask"-Regel unter "permissions"; Websuche bleibt fest gesperrt)
    // { "action": "tool.use", "resource": "webfetch:*", "effect": "allow" },

    // Lokale LLM-Server freigeben (nur die tatsächlich genutzten behalten!). Ein freigegebener Provider zeigt
    // Modelle aus dem gebündelten Katalog auch dann an, wenn sein Server nicht läuft.
    { "action": "provider.use", "resource": "ollama", "effect": "allow" },
    { "action": "integration.connect", "resource": "ollama", "effect": "allow" },
    { "action": "integration.use", "resource": "ollama", "effect": "allow" },
    { "action": "provider.use", "resource": "lmstudio", "effect": "allow" },
    { "action": "integration.connect", "resource": "lmstudio", "effect": "allow" },
    { "action": "integration.use", "resource": "lmstudio", "effect": "allow" },

    // Eigener OpenAI-kompatibler Server im Firmennetz (siehe "firma" unten)
    { "action": "provider.use", "resource": "firma", "effect": "allow" },
    { "action": "integration.connect", "resource": "firma", "effect": "allow" },
    { "action": "integration.use", "resource": "firma", "effect": "allow" }
  ],

  // Lokale Endpunkte explizit setzen (Defaults: Ollama 127.0.0.1:11434, LM Studio 127.0.0.1:1234, vLLM 127.0.0.1:8000)
  "providers": {
    "ollama": { "settings": { "baseURL": "http://127.0.0.1:11434/v1" } },
    "lmstudio": { "settings": { "baseURL": "http://127.0.0.1:1234/v1" } },

    // Vorlage für einen OpenAI-kompatiblen Server (vLLM, TGI, LiteLLM, llama.cpp, ...).
    // "@ai-sdk/openai-compatible" wird auf die eingebaute Implementierung umgebogen, es wird nichts von npm geladen.
    "firma": {
      "name": "Firmen-LLM",
      "package": "@ai-sdk/openai-compatible",
      // API-Key aus dieser Umgebungsvariable lesen (entfällt, wenn der Server keinen Key verlangt)
      "env": ["FIRMA_API_KEY"],
      "settings": { "baseURL": "http://llm.intern:8000/v1" },
      "models": {
        // Schlüssel = Modell-ID, wie sie GET <baseURL>/models liefert
        "modell-id": {
          "name": "Firmenmodell",
          // Ohne Tool-Calling kann opencode keine Dateien lesen oder bearbeiten
          "capabilities": { "tools": true },
          // Falls ein Denk-Modell (z. B. Qwen3 unter Ollama) nach dem Nachdenken keinen Tool-Call liefert:
          // "body": { "reasoning_effort": "none" },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  }
}
