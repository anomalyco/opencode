# local-only: Umgebungsvariablen, die Netzwerkzugriffe von opencode abschalten.
# Einbinden z. B. in ~/.zshrc:   set -a; source /pfad/zu/local-only/offline.env; set +a

# Modellkatalog nicht von https://models.opencode.ai laden -> gebündelter Snapshot
# (packages/core/src/models-dev/snapshot.txt) bzw. lokale Datei aus OPENCODE_MODELS_PATH
OPENCODE_DISABLE_MODELS_FETCH=1
# Optional: eigener Katalog (models.dev v1 oder v2 JSON)
# OPENCODE_MODELS_PATH=$HOME/.config/opencode/models.json

# Kein Update-Check / Auto-Update
OPENCODE_DISABLE_AUTOUPDATE=1

# Kostenlose opencode-Zen-Modelle (Cloud) ausblenden
OPENCODE_DISABLE_FREE_MODELS=1

# Keine Telemetrie-Exporte: diese Variablen NICHT setzen
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
