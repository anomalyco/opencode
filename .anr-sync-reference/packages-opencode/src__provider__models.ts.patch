+    const idToken = process.env.OPENCODE_ANR_ID_TOKEN
+    if (idToken) {
+      headers.Authorization = `Bearer ${idToken}`
+    }
+    const result = await fetch(`${Flag.OPENCODE_API_ENDPOINT}/model`, {
+      headers,
