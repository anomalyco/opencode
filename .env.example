# ── GitHub OAuth App ────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:4096/collab/auth/github/callback
#                         (or your ngrok/EC2 URL in production)
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret

# ── GitHub Org ──────────────────────────────────────────────────────────────────
# The GitHub organisation whose members can use Collab Sessions
GITHUB_ORG_NAME=unleashlive

# Personal Access Token (or GitHub App installation token) with scopes:
#   read:org  — to verify org membership
#   repo      — to clone private repos into server workspaces
GITHUB_TOKEN=ghp_your_personal_access_token

# ── Server ──────────────────────────────────────────────────────────────────────
# The public URL where this server is reachable.
# For local dev with remote testers: use your ngrok URL, e.g.:
#   OPENCODE_BASE_URL=https://abc123.ngrok.io
# For EC2 production: use your domain, e.g.:
#   OPENCODE_BASE_URL=https://opencode.unleashlive.com
OPENCODE_BASE_URL=http://localhost:4096

# Random secret for signing session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change_me_generate_with_openssl_rand_hex_32

# ── LLM Provider Keys ───────────────────────────────────────────────────────────
# The SERVER uses these credentials for all LLM calls — teammates don't need their own.
#
# Option A (recommended for production): Anthropic API key
ANTHROPIC_API_KEY=

# Option B: Leave ANTHROPIC_API_KEY empty to use Claude Code subscription instead.
#   On the host Mac, run once to export your credentials:
#     security find-generic-password -s "Claude Code-credentials" -w > ~/.claude/.credentials.json
#   docker-compose.yml bind-mounts that file into the container automatically.
#   See COLLAB.md for details.

OPENAI_API_KEY=
