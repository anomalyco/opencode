# Copy to .env (gitignored) and fill in real values, then `source .env` (bash)
# or load via your shell of choice before running opencode.

# DeepSeek
DEEPSEEK_API_KEY=sk-replace-me

# Langfuse (self-hosted at https://langfuse.vili.vn)
# OTEL_EXPORTER_OTLP_ENDPOINT must NOT include /v1/traces — opencode appends it.
OTEL_EXPORTER_OTLP_ENDPOINT=https://langfuse.vili.vn/api/public/otel
# Compute base64 from "<public_key>:<secret_key>" (no quotes, no whitespace).
# Example (bash):  echo -n 'pk-lf-xxx:sk-lf-yyy' | base64
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic REPLACE_BASE64_HERE
