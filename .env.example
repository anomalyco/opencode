# Shopify Storefront MCP Configuration
# Copy this file to .env (optional - no credentials needed!)

# NOTE: Official Shopify Storefront MCP requires NO authentication!
# Just configure your store domain in .opencode/opencode.jsonc:
#   "url": "https://your-store.myshopify.com/api/mcp"

# The configuration below is ONLY needed if using community Admin API-based MCP servers
# (not recommended - official Storefront MCP is simpler and better)

# Your Shopify store URL (without https://) - for Admin API MCP only
# SHOPIFY_SHOP_URL=your-store.myshopify.com

# Shopify Admin API Access Token - for Admin API MCP only
# Get this from: Shopify Admin → Settings → Apps → Create custom app
# Required scopes: read_products, read_customers, read_orders
# SHOPIFY_ACCESS_TOKEN=shpat_your_access_token_here
