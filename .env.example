# Cerebras Code Environment Configuration

# ============================================
# Authentication (Clerk) - OPTIONAL
# ============================================
# Only needed if you want centralized user authentication
# Get these from: https://dashboard.clerk.com/
#
# Setup Steps:
# 1. Create a new application in Clerk
# 2. Go to "API Keys" section
# 3. Copy the keys below
# 4. Optionally set CLERK_FRONTEND_API to your custom domain

# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Custom Clerk Frontend URL (defaults to Clerk's hosted pages)
# CLERK_FRONTEND_API=https://accounts.yourdomain.com

# ============================================
# Development Options
# ============================================

# Skip Clerk authentication - use direct provider auth instead (recommended for local dev)
CEREBRAS_SKIP_AUTH=true

# Node environment
# NODE_ENV=development

# ============================================
# AWS Configuration (Optional - for custom backend)
# ============================================

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# API Gateway URL for custom auth backend
# CEREBRAS_AUTH_API=https://api.cerebras.ai
