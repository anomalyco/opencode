# ============================================================================
# VantaCode environment configuration (EXAMPLE)
#
# Copy this file to `.env` and fill in the values you need:
#     cp .env.example .env
#
# `.env` is gitignored — NEVER commit real keys. Only this example is tracked.
# Every value below is OPTIONAL. Local Ollama needs NO keys at all.
# ============================================================================

# ----------------------------------------------------------------------------
# Default provider / model selection
# ----------------------------------------------------------------------------
# Which provider VantaCode uses when you don't pass --provider.
#   ollama | openai | anthropic | groq | deepseek | openrouter | together | mistral
VANTACODE_PROVIDER=ollama
# Default model (provider-specific). For ollama, e.g. qwen2.5-coder:7b
VANTACODE_MODEL=qwen2.5-coder:7b
# Permission mode: plan | auto-edit | yolo
VANTACODE_PERMISSION=auto-edit
# Verbose tool-call debugging (raw Ollama tool_call responses). 1 to enable.
VANTACODE_DEBUG=0

# ----------------------------------------------------------------------------
# Local Ollama (no API key required)
# ----------------------------------------------------------------------------
# Override if Ollama runs on a non-default host/port.
OLLAMA_HOST=http://127.0.0.1:11434
# Equivalent to VANTACODE_DEBUG for the native Ollama client.
# OLLAMA_DEBUG=1

# ----------------------------------------------------------------------------
# API-key providers
#
# Multi-key failover: put SEVERAL keys, comma-separated, in a single variable.
# On a 429 / 401 / 5xx / quota error VantaCode automatically retries the next
# key, then the next provider. Keys are masked to first/last 4 chars in logs.
#   OPENAI_API_KEY=sk-primary,sk-backup1,sk-backup2
# You can also use the plural form OPENAI_API_KEYS which is merged in.
# ----------------------------------------------------------------------------

# OpenAI (and OpenAI-compatible)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Groq (fast Llama / Qwen hosting)
GROQ_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter (aggregator)
OPENROUTER_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Mistral
MISTRAL_API_KEY=

# ----------------------------------------------------------------------------
# GPU / performance tuning (usually auto-detected — override only if needed)
# ----------------------------------------------------------------------------
# Set by `vantacode vantacode optimize`; you normally export these before
# starting the Ollama SERVER, not the CLI:
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_NUM_PARALLEL=2
# OLLAMA_MAX_LOADED_MODELS=2
# AMD ROCm only:
# HSA_OVERRIDE_GFX_VERSION=10.3.0
# OLLAMA_COMPUTE_TYPE=f16
