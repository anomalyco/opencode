# Production / self-host / Kubernetes
PUBLIC_HOST=app.veritly.co.uk
PUBLIC_BASE_URL=https://app.veritly.co.uk
PUBLIC_HTTP_PORT=80
VITE_OPENCODE_SERVER_URL=https://api.veritly.co.uk

OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
OPENCODE_WORKOS_ENABLED=true

WORKOS_API_KEY=sk_test_replace_me
WORKOS_CLIENT_ID=client_replace_me
WORKOS_REDIRECT_URI=https://api.veritly.co.uk/auth/callback
COOKIE_PASSWORD=replace-with-32-char-secret
DATABASE_URL=postgresql://veritly:veritly@postgres:5432/veritly

UNIVER_SDK_PORT=18766
VERITLY_WS_DEBUG=0
DEPLOYMENT_ENVIRONMENT=production

TRAEFIK_DASHBOARD=false
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_STICKY_COOKIE_NAME=veritly_affinity

EXECUTOR_DRIVER=stub
EXECUTOR_PROXY_URL=
VMEXEC_BIN=/opt/veritly/bin/veritly-vmexec
EXECUTOR_DEFAULT_TIMEOUT_MS=120000

VITE_UNIVER_BACKEND_URL=https://univer.veritly.co.uk
VITE_UNIVER_SDK_WS=wss://relay.veritly.co.uk/ws
VITE_UNIVER_LICENSE=

VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
AXIOM_TOKEN=
AXIOM_DATASET=
VITE_PUBLIC_AXIOM_TOKEN=
VITE_PUBLIC_AXIOM_DATASET=
VITE_PUBLIC_AXIOM_URL=https://api.axiom.co
VITE_PUBLIC_OTEL_LOG_LEVEL=info
OTEL_LOG_LEVEL=info
