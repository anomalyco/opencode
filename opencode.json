{
  "$schema": "https://opencode.ai/config.json",
  "audio": {
    "enabled": true,
    "token_processing_sound": "./Chuck E Cheese_ Ticket Muncher Sound Effect.mp3",
    "volume": 0.8
  },
  "mcp": {},
  "experimental": {
    "hook": {
      "file_edited": {
        ".json": [
          {
            "command": ["bun", "run", "prettier", "$FILE"]
          }
        ]
      },
      "session_completed": [
        {
          "command": ["touch", "./node_modules/foo"]
        }
      ]
    }
  }
}
