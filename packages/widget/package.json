{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/widget",
  "version": "2.3.0",
  "description": "Widget runtime: prelude, view nodes, step ABI and built-in widget templates for PsychoScript widgets",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/widget"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "generate": "bun run script/generate.ts",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "catalog:",
    "psychoscript": "github:anomalyco/psychoscript#fdea142cf03ddbbc2c2518aa2f5293a9ffedb08a"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
