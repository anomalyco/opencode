{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-updates",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "pipelines": [
    {
      "binding": "EVENTS",
      // Shared lake stream from anomalyco/platform/production.
      "stream": "251a89241c3a461c9007f6b6f345ed8b",
    },
  ],
  "routes": [
    {
      "pattern": "update.opencode.ai",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-updates",
      "database_id": "058debd8-1572-4c4a-8781-2c5a0e33cb46",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
  },
}
