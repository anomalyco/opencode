{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bolt-ai/server",
  "version": "1.20.7",  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "tsc -b",
    "probe:workerd": "bun run script/workerd-probe.ts"
  },
  "dependencies": {
    "@bolt-ai/core": "workspace:*",
    "@bolt-ai/protocol": "workspace:*",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@opencode-ai/pty": "0.3.1",
    "@opencode/client": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:"
  }
}
