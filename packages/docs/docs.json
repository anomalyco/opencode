          }
        ]
      }
    },
    "logo": {
      "light": "/logo/light.svg",
      "dark": "/logo/dark.svg",
      "href": "https://opencode.ai/"
    },
    "navbar": {
      "primary": {
        "type": "github",
        "href": "https://github.com/sst/opencode"
      }
