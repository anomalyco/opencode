  {
    "$schema": "https://mintlify.com/docs.json",
    "theme": "linden",
    "name": "Opencode docs",
    "colors": {
      "primary": "#4B4646",
      "light": "#F1ECEC",
      "dark": "#F1ECEC"
    },
    "favicon": "/favicon.svg",
