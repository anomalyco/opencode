          "group": "Usage",
          "pages": [
            "tui",
            "cli",
            "ide",
            "zen",
            "share",
            "github",
            "gitlab"
          ]
        },
        {
          "group": "Configure",
          "pages": [
            "tools",
            "rules",
            "agents",
            "models",
            "themes",
            "keybinds",
            "commands",
            "formatters",
            "permissions",
            "lsp",
            "mcp-servers",
            "acp",
            "custom-tools"
          ]
        },
        {
          "group": "Develop",
          "pages": [
            "sdk",
            "server",
            "plugins",
            "ecosystem"
          ]
        }
      ],
      "global": {
        "anchors": [
          {
            "anchor": "Community",
