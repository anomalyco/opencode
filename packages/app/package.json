{
  "name": "@opencode-ai/app",
  "version": "1.2.24",
  "description": "",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./vite.js",
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "start": "vite",
    "dev": "bun --env-file=../../.env.development ./script/dev.ts",
    "dev:e2e": "bun --env-file=../../.env.development --env-file=.env.e2e ./script/dev.ts",
    "build": "vite build",
    "serve": "vite preview",
    "test": "bun test --preload ./happydom.ts ./src",
    "test:integration": "vitest run test/integration",
    "test:browser": "vitest run -c vitest.e2e.config.ts test/browser",
    "e2e": "bun --env-file=../../.env.development --env-file=.env.e2e x vitest run -c vitest.e2e.config.ts",
    "playwright:install": "bunx playwright install chromium",
    "smoke:browser": "bun --env-file=../../.env.development ./script/smoke-browser.ts",
    "smoke:pyodide": "bun ./script/pyodide-smoke.ts",
    "extract:collab-pro": "node scripts/extract-collab-pro.mjs"
  },
  "license": "MIT",
