VITE_MODEL_PIN=anthropic/claude-sonnet-4-6
VITE_MODEL_PIN_TIER=high
VITE_DISABLE_SESSION_HEADER=true
# 미리보기 iframe 임시 URL (비우면 sync env 기반 기본 동작). google.com 등은 iframe 차단됨.
# 브릿지 통신을 로컬에서 검증하려면 result-preview 예제를 띄우고(`bun dev:preview`, 포트 4400)
# 아래를 http://localhost:4400 으로 설정한다.
VITE_PREVIEW_URL=
VITE_DISABLE_PROMPT_TRIGGERS=true
VITE_DISABLE_PROMPT_PERMISSIONS=true
VITE_DISABLE_PROMPT_FOOTER=true
VITE_DISABLE_DRAW_EDITOR=true
VITE_DISABLE_WYSIWYG_ONLY=true
VITE_SUBMIT_FAILURE_CLOSE_SEC=5
VITE_DISABLE_CHANGE_FILES=true
VITE_DISABLE_CHAT_INTRO=true
VITE_DISABLE_ANSWER_CLOSE=true
# 프롬프트 전송/줄바꿈 단축키 (parseKeybind 형식: enter, shift+enter, mod+enter ...)
# 비우면 기본값(전송=enter, 줄바꿈=shift+enter) 사용
VITE_PROMPT_SUBMIT_KEY=enter
VITE_PROMPT_NEWLINE_KEY=shift+enter