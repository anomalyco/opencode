# E2E with real WorkOS: set OPENCODE_WORKOS_ENABLED=true and put WorkOS + COOKIE_PASSWORD
# in your real env (e.g. copy from a local .env that is gitignored), then:
#   OPENCODE_E2E_TENANT_USER_ID must match the signed-in WorkOS user id (user_…), same as in seed.
# Playwright: each `gotoSession` mints `wos-session` (E2E_WORKOS_* / STAGING_TEST_*). Optional: PLAYWRIGHT_AUTH_FILE=path/to/storage.json
# Two-tenant presign E2E (optional): E2E_WORKOS_TENANT_B_EMAIL + E2E_WORKOS_TENANT_B_PASSWORD (or E2E_WORKOS_TENANT_B_PASSWORD_B64)
OPENCODE_WORKOS_ENABLED=true
OPENCODE_DISABLE_SHARE=true
OPENCODE_DISABLE_LSP_DOWNLOAD=true
OPENCODE_DISABLE_DEFAULT_PLUGINS=true
OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER=true

# Ollama Configuration (OpenAI-compatible API)
# Configure OpenAI provider to use local Ollama instance
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11435/v1
