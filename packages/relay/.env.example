# OpenCode Relay — example environment file
#
# Copy to .env and edit values as needed.

# ── Network ──────────────────────────────────────────────────────────────

# Port to listen on (nginx terminates TLS on 9999, relay on 9998)
RELAY_PORT=9998

# Bind address (loopback only; nginx proxies public traffic)
RELAY_HOST=127.0.0.1

# Trust X-Forwarded-For from nginx (set to 1 when behind a reverse proxy)
RELAY_TRUST_PROXY=1

# Public base URL shown to users (for display only)
RELAY_PUBLIC_BASE=https://your-domain:9999

# ── Storage ───────────────────────────────────────────────────────────────

# Data directory for relay.json (accounts, environments, sessions)
RELAY_DATA_DIR=/opt/oc-relay/data

# ── Session ───────────────────────────────────────────────────────────────

# Session inactivity timeout in milliseconds (default: 24h)
# RELAY_SESSION_TTL_MS=86400000

# Session cleanup interval in milliseconds (default: 10min)
# RELAY_SESSION_CLEANUP_MS=600000

# ── Rate limiting ────────────────────────────────────────────────────────

# Rate limit window in milliseconds (default: 1min)
# RELAY_RATE_LIMIT_WINDOW_MS=60000

# Max auth attempts per IP per window (default: 10)
# RELAY_RATE_LIMIT_MAX=10
