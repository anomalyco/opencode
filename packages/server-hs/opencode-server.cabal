cabal-version: 3.0
name:          opencode-server
version:       0.1.0.0
synopsis:      OpenCode Haskell Server
license:       MIT
build-type:    Simple

library
  exposed-modules:
    Api
    Handlers
    State
    Bus.Bus
    Bus.Event
    Storage.Storage
    Session.Types
    Session.Session
    Message.Types
    Config.Types
    Config.Config
    Provider.Types
    Provider.Provider
    Agent.Types
    Agent.Agent
    Sandbox.Types
    Sandbox.Sandbox
    Pty.Types
    Pty.Pty
    Proxy.Types
    Proxy.Proxy
    LLM.Types
    LLM.Anthropic
    LLM.OpenRouter
    Log
    Tool.Types
    Tool.Defs
    Tool.Exec
    Tool.Tool
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -Wall -O2
  build-depends:
    base >= 4.17 && < 5,
    aeson >= 2.0,
    servant >= 0.20,
    servant-server >= 0.20,
    warp >= 3.3,
    wai >= 3.2,
    wai-websockets >= 3.0,
    websockets >= 0.12,
    http-types >= 0.12,
    http-client,
    http-client-tls,
    process,
    case-insensitive >= 1.2,
    text >= 2.0,
    bytestring >= 0.11,
    containers >= 0.6,
    stm >= 2.5,
    directory >= 1.3,
    filepath >= 1.4,
    time >= 1.12,
    random >= 1.2,
    process >= 1.6,
    unix >= 2.8,
    posix-pty >= 0.2,
    network >= 3.1,
    crypton-connection >= 0.4,
    data-default-class >= 0.1,
    tls >= 2.0,
    katip >= 0.8,
    mtl >= 2.2,
    unliftio-core >= 0.2
  default-extensions:
    DataKinds
    TypeOperators
    DeriveGeneric
    OverloadedStrings
    LambdaCase

executable opencode-server
  main-is:          Main.hs
  hs-source-dirs:   app
  default-language: GHC2021
  ghc-options:      -Wall -O2 -threaded -rtsopts -with-rtsopts=-N -Werror
  build-depends:
    base >= 4.17 && < 5,
    opencode-server,
    aeson,
    servant-server,
    warp,
    wai,
    wai-websockets,
    websockets,
    http-types,
    stm,
    bytestring,
    text,
    directory,
    filepath,
    time,
    process,
    containers,
    katip

test-suite opencode-server-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  other-modules:
    Property.StorageProps
    Property.BusProps
    Property.ConfigProps
    Property.SessionProps
    Property.ToolProps
    Property.MessageProps
    Property.LLMProps
    Property.ProviderProps
    Unit.ApiSpec
  hs-source-dirs:   test
  default-language: GHC2021
  ghc-options:      -Wall -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >= 4.17 && < 5,
    opencode-server,
    hspec >= 2.11,
    hspec-core >= 2.11,
    hedgehog >= 1.4,
    tasty >= 1.5,
    tasty-hedgehog >= 1.4,
    tasty-hspec >= 1.2,
    aeson >= 2.0,
    text >= 2.0,
    bytestring >= 0.11,
    containers >= 0.6,
    stm >= 2.5,
    directory >= 1.3,
    filepath >= 1.4,
    temporary >= 1.3,
    http-client,
    http-client-tls,
    http-types,
    process
  default-extensions:
    DataKinds
    TypeOperators
    DeriveGeneric
    OverloadedStrings
    LambdaCase
    RecordWildCards
