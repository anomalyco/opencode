cabal-version: 3.0
name:          opencode-server
version:       0.1.0.0
synopsis:      OpenCode Haskell Server
license:       MIT
build-type:    Simple

executable opencode-server
  main-is:          Main.hs
  other-modules:
    Api
    Handlers
    State
    Bus.Bus
    Bus.Event
    Storage.Storage
    Session.Types
    Session.Session
    Message.Types
    Config.Types
    Config.Config
    Provider.Types
    Provider.Provider
    Agent.Types
    Agent.Agent
    Sandbox.Types
    Sandbox.Sandbox
    Pty.Types
    Pty.Pty
    Proxy.Types
    Proxy.Proxy
    LLM.Types
    LLM.Anthropic
    LLM.OpenRouter
    Log
    Tool.Types
    Tool.Defs
    Tool.Exec
    Tool.Tool
  hs-source-dirs:   src
  default-language: GHC2021
  ghc-options:      -Wall -O2 -threaded -rtsopts -with-rtsopts=-N
  build-depends:
    base >= 4.17 && < 5,
    aeson >= 2.0,
    servant >= 0.20,
    servant-server >= 0.20,
    warp >= 3.3,
    wai >= 3.2,
    wai-websockets >= 3.0,
    websockets >= 0.12,
    http-types >= 0.12,
    http-client >= 0.7,
    http-client-tls >= 0.3,
    case-insensitive >= 1.2,
    text >= 2.0,
    bytestring >= 0.11,
    containers >= 0.6,
    stm >= 2.5,
    directory >= 1.3,
    filepath >= 1.4,
    time >= 1.12,
    random >= 1.2,
    process >= 1.6,
    unix >= 2.8,
    posix-pty >= 0.2,
    network >= 3.1,
    crypton-connection >= 0.4,
    data-default-class >= 0.1,
    tls >= 2.0,
    katip >= 0.8,
    mtl >= 2.2,
    unliftio-core >= 0.2
  default-extensions:
    DataKinds
    TypeOperators
    DeriveGeneric
    OverloadedStrings
    LambdaCase
