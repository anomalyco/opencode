{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "kittBlack": "#040404",
    "kittShadow": "#090909",
    "kittPanel": "#111111",
    "kittElement": "#191919",
    "kittBorder": "#2a2a2a",
    "kittSteel": "#6c6c6c",
    "kittSilver": "#bdbdbd",
    "kittText": "#d9d9d9",
    "ledRed": "#d40019",
    "ledRedSoft": "#a00013",
    "ledRedDim": "#69000d",
    "ledRedHot": "#ff314a",
    "ledCore": "#ff6a78",
    "dashPurple": "#c8a2ff",
    "dashPurpleSoft": "#9e78d6",
    "ledAmber": "#d28a3a",
    "dashLemon": "#e7de8a",
    "dashLime": "#b8c65e",
    "dashGreen": "#5f9f4a",
    "paper": "#f2f2f2",
    "paperPanel": "#e8e8e8",
    "paperElement": "#dddddd",
    "paperText": "#202020",
    "paperMuted": "#666666"
  },
  "theme": {
    "primary": { "dark": "ledRed", "light": "ledRedSoft" },
    "secondary": { "dark": "ledRed", "light": "ledRedSoft" },
    "accent": { "dark": "ledRed", "light": "ledRedSoft" },
    "error": { "dark": "ledRedHot", "light": "ledRed" },
    "warning": { "dark": "ledAmber", "light": "ledAmber" },
    "success": { "dark": "dashLime", "light": "dashGreen" },
    "info": { "dark": "dashGreen", "light": "dashGreen" },
    "text": { "dark": "kittText", "light": "paperText" },
    "textMuted": { "dark": "kittSteel", "light": "paperMuted" },
    "background": { "dark": "kittBlack", "light": "paper" },
    "backgroundPanel": { "dark": "kittShadow", "light": "paperPanel" },
    "backgroundElement": { "dark": "kittPanel", "light": "paperElement" },
    "backgroundMenu": { "dark": "kittElement", "light": "#d6d6d6" },
    "border": { "dark": "kittBorder", "light": "#b8b8b8" },
    "borderActive": { "dark": "ledRed", "light": "ledRedSoft" },
    "borderSubtle": { "dark": "kittPanel", "light": "#cecece" },
    "selectedListItemText": { "dark": "#ffffff", "light": "#ffffff" },
    "diffAdded": { "dark": "kittSilver", "light": "#5f5f5f" },
    "diffRemoved": { "dark": "ledRedHot", "light": "ledRed" },
    "diffContext": { "dark": "kittSteel", "light": "paperMuted" },
    "diffHunkHeader": { "dark": "ledAmber", "light": "ledAmber" },
    "diffHighlightAdded": { "dark": "#efefef", "light": "#7a7a7a" },
    "diffHighlightRemoved": { "dark": "#ff6a78", "light": "#d12d41" },
    "diffAddedBg": { "dark": "#171717", "light": "#e4e4e4" },
    "diffRemovedBg": { "dark": "#24090d", "light": "#f0d7db" },
    "diffContextBg": { "dark": "kittShadow", "light": "paperPanel" },
    "diffLineNumber": { "dark": "kittSteel", "light": "paperMuted" },
    "diffAddedLineNumberBg": { "dark": "#141414", "light": "#dadada" },
    "diffRemovedLineNumberBg": { "dark": "#1d090b", "light": "#e8cfd3" },
    "markdownText": { "dark": "kittText", "light": "paperText" },
    "markdownHeading": { "dark": "dashPurple", "light": "dashPurpleSoft" },
    "markdownLink": { "dark": "ledCore", "light": "ledRedSoft" },
    "markdownLinkText": { "dark": "ledRed", "light": "ledRed" },
    "markdownCode": { "dark": "ledCore", "light": "ledRedSoft" },
    "markdownBlockQuote": { "dark": "kittSteel", "light": "paperMuted" },
    "markdownEmph": { "dark": "ledAmber", "light": "ledAmber" },
    "markdownStrong": { "dark": "dashLemon", "light": "#a6943b" },
    "markdownHorizontalRule": { "dark": "kittBorder", "light": "#b8b8b8" },
    "markdownListItem": { "dark": "ledRed", "light": "ledRedSoft" },
    "markdownListEnumeration": { "dark": "dashPurpleSoft", "light": "dashPurpleSoft" },
    "markdownImage": { "dark": "ledRedDim", "light": "#9d4f58" },
    "markdownImageText": { "dark": "ledRed", "light": "ledRedSoft" },
    "markdownCodeBlock": { "dark": "kittText", "light": "paperText" },
    "syntaxComment": { "dark": "kittSteel", "light": "paperMuted" },
    "syntaxKeyword": { "dark": "dashPurple", "light": "dashPurpleSoft" },
    "syntaxFunction": { "dark": "ledCore", "light": "ledRedSoft" },
    "syntaxVariable": { "dark": "kittText", "light": "paperText" },
    "syntaxString": { "dark": "dashLime", "light": "dashGreen" },
    "syntaxNumber": { "dark": "ledAmber", "light": "ledAmber" },
    "syntaxType": { "dark": "dashLemon", "light": "#a6943b" },
    "syntaxOperator": { "dark": "ledRedSoft", "light": "ledRedSoft" },
    "syntaxPunctuation": { "dark": "kittSilver", "light": "paperText" },
    "thinkingOpacity": 0.82
  }
}