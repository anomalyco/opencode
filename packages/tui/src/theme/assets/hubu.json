{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "hubuGreen": "#135440",
    "hubuGreenDeep": "#0F4433",
    "hubuGreenBright": "#2E9070",
    "hubuGreenSoft": "#57B493",
    "gold": "#BC9D53",
    "goldDeep": "#87672F",
    "accentLight": "#1B6E54",
    "paper": "#F2F0E6",
    "paperDim": "#9DB5A8",
    "mutedLight": "#5F7268",
    "inkLight": "#12241C",
    "bgDark": "#0B1F17",
    "bgDarkPanel": "#142B21",
    "bgDarkElement": "#1B3529",
    "borderDark": "#4E6B5C",
    "borderDarkSubtle": "#24382E",
    "stoneBg": "#F4F7F0",
    "stonePanel": "#EAF0E6",
    "stoneElement": "#DFE8DA",
    "borderLight": "#93A89A",
    "borderLightSubtle": "#CFDCCF",
    "olive": "#8CA83E",
    "oliveDeep": "#587215",
    "sky": "#5EA9E6",
    "skyDeep": "#1F6FB2",
    "errDark": "#E25B52",
    "errLight": "#A61B29",
    "diffAddedBgDark": "#1C2F22",
    "diffRemovedBgDark": "#3B1517",
    "diffAddedBgLight": "#E4E9D2",
    "diffRemovedBgLight": "#F2D9D6"
  },
  "theme": {
    "primary": { "dark": "hubuGreenBright", "light": "hubuGreen" },
    "secondary": { "dark": "hubuGreenSoft", "light": "goldDeep" },
    "accent": { "dark": "gold", "light": "accentLight" },
    "error": { "dark": "errDark", "light": "errLight" },
    "warning": { "dark": "gold", "light": "goldDeep" },
    "success": { "dark": "olive", "light": "oliveDeep" },
    "info": { "dark": "sky", "light": "skyDeep" },
    "text": { "dark": "paper", "light": "inkLight" },
    "textMuted": { "dark": "paperDim", "light": "mutedLight" },
    "background": { "dark": "bgDark", "light": "stoneBg" },
    "backgroundPanel": { "dark": "bgDarkPanel", "light": "stonePanel" },
    "backgroundElement": { "dark": "bgDarkElement", "light": "stoneElement" },
    "border": { "dark": "borderDark", "light": "borderLight" },
    "borderActive": { "dark": "hubuGreenBright", "light": "hubuGreen" },
    "borderSubtle": { "dark": "borderDarkSubtle", "light": "borderLightSubtle" },
    "diffAdded": { "dark": "olive", "light": "oliveDeep" },
    "diffRemoved": { "dark": "errDark", "light": "errLight" },
    "diffContext": { "dark": "paperDim", "light": "mutedLight" },
    "diffHunkHeader": { "dark": "gold", "light": "goldDeep" },
    "diffHighlightAdded": { "dark": "olive", "light": "oliveDeep" },
    "diffHighlightRemoved": { "dark": "errDark", "light": "errLight" },
    "diffAddedBg": { "dark": "diffAddedBgDark", "light": "diffAddedBgLight" },
    "diffRemovedBg": { "dark": "diffRemovedBgDark", "light": "diffRemovedBgLight" },
    "diffContextBg": { "dark": "bgDarkPanel", "light": "stonePanel" },
    "diffLineNumber": { "dark": "paperDim", "light": "mutedLight" },
    "diffAddedLineNumberBg": { "dark": "#182820", "light": "#D8DFC4" },
    "diffRemovedLineNumberBg": { "dark": "#2A1113", "light": "#EBCEC9" },
    "markdownText": { "dark": "paper", "light": "inkLight" },
    "markdownHeading": { "dark": "gold", "light": "hubuGreen" },
    "markdownLink": { "dark": "hubuGreenSoft", "light": "hubuGreen" },
    "markdownLinkText": { "dark": "gold", "light": "goldDeep" },
    "markdownCode": { "dark": "olive", "light": "oliveDeep" },
    "markdownBlockQuote": { "dark": "paperDim", "light": "mutedLight" },
    "markdownEmph": { "dark": "hubuGreenSoft", "light": "accentLight" },
    "markdownStrong": { "dark": "gold", "light": "goldDeep" },
    "markdownHorizontalRule": { "dark": "borderDark", "light": "borderLight" },
    "markdownListItem": { "dark": "hubuGreenBright", "light": "hubuGreen" },
    "markdownListEnumeration": { "dark": "gold", "light": "goldDeep" },
    "markdownImage": { "dark": "hubuGreenSoft", "light": "hubuGreen" },
    "markdownImageText": { "dark": "gold", "light": "goldDeep" },
    "markdownCodeBlock": { "dark": "paper", "light": "inkLight" },
    "syntaxComment": { "dark": "paperDim", "light": "mutedLight" },
    "syntaxKeyword": { "dark": "hubuGreenBright", "light": "hubuGreen" },
    "syntaxFunction": { "dark": "gold", "light": "goldDeep" },
    "syntaxVariable": { "dark": "hubuGreenSoft", "light": "accentLight" },
    "syntaxString": { "dark": "olive", "light": "oliveDeep" },
    "syntaxNumber": { "dark": "gold", "light": "goldDeep" },
    "syntaxType": { "dark": "sky", "light": "skyDeep" },
    "syntaxOperator": { "dark": "hubuGreenSoft", "light": "accentLight" },
    "syntaxPunctuation": { "dark": "paper", "light": "inkLight" }
  }
}
