{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "darkBg": "#0B0E14",
    "darkBgAlt": "#0D1017",
    "darkLine": "#11151C",
    "darkPanel": "#0F131A",
    "darkFg": "#BFBDB6",
    "darkFgMuted": "#565B66",
    "darkGutter": "#6C7380",
    "darkTag": "#39BAE6",
    "darkFunc": "#FFB454",
    "darkEntity": "#59C2FF",
    "darkString": "#AAD94C",
    "darkRegexp": "#95E6CB",
    "darkMarkup": "#F07178",
    "darkKeyword": "#FF8F40",
    "darkSpecial": "#E6B673",
    "darkComment": "#ACB6BF",
    "darkConstant": "#D2A6FF",
    "darkOperator": "#F29668",
    "darkAdded": "#7FD962",
    "darkRemoved": "#F26D78",
    "darkAccent": "#E6B450",
    "darkError": "#D95757",
    "darkIndentActive": "#6C7380",
    "lightBg": "#FCFCFC",
    "lightBgPanel": "#FAFAFA",
    "lightBgElement": "#F0F0F0",
    "lightFg": "#5C6166",
    "lightFgMuted": "#828E9F",
    "lightGold": "#F29718",
    "lightGreen": "#86B300",
    "lightRed": "#F07171",
    "lightError": "#E65050",
    "lightBlue": "#22A4E6",
    "lightOrange": "#FA8532",
    "lightPeach": "#E59645",
    "lightFunction": "#EBA400",
    "lightOperator": "#ED9366",
    "lightPurple": "#A37ACC",
    "lightCyan": "#55B4D4",
    "lightBorder": "#E6E6E6",
    "lightDiffAdd": "#6CBF43",
    "lightDiffDelete": "#FF7383"
  },
  "theme": {
    "primary": { "dark": "darkEntity", "light": "lightBlue" },
    "secondary": { "dark": "darkConstant", "light": "lightPurple" },
    "accent": { "dark": "darkAccent", "light": "lightGold" },
    "error": { "dark": "darkError", "light": "lightError" },
    "warning": { "dark": "darkSpecial", "light": "lightPeach" },
    "success": { "dark": "darkAdded", "light": "lightDiffAdd" },
    "info": { "dark": "darkTag", "light": "lightCyan" },
    "text": { "dark": "darkFg", "light": "lightFg" },
    "textMuted": { "dark": "darkFgMuted", "light": "lightFgMuted" },
    "background": { "dark": "darkBg", "light": "lightBg" },
    "backgroundPanel": { "dark": "darkPanel", "light": "lightBgPanel" },
    "backgroundElement": { "dark": "darkBgAlt", "light": "lightBgElement" },
    "border": { "dark": "darkGutter", "light": "lightBorder" },
    "borderActive": { "dark": "darkIndentActive", "light": "lightGold" },
    "borderSubtle": { "dark": "darkLine", "light": "lightBgElement" },
    "diffAdded": { "dark": "darkAdded", "light": "lightDiffAdd" },
    "diffRemoved": { "dark": "darkRemoved", "light": "lightDiffDelete" },
    "diffContext": { "dark": "darkComment", "light": "lightFgMuted" },
    "diffHunkHeader": { "dark": "darkComment", "light": "lightFgMuted" },
    "diffHighlightAdded": { "dark": "darkString", "light": "lightGreen" },
    "diffHighlightRemoved": { "dark": "darkMarkup", "light": "lightRed" },
    "diffAddedBg": { "dark": "#20303b", "light": "#ebf5e6" },
    "diffRemovedBg": { "dark": "#37222c", "light": "#fceced" },
    "diffContextBg": { "dark": "darkPanel", "light": "lightBgPanel" },
    "diffLineNumber": { "dark": "diffContext", "light": "lightFgMuted" },
    "diffAddedLineNumberBg": { "dark": "#1b2b34", "light": "#e2f1db" },
    "diffRemovedLineNumberBg": { "dark": "#2d1f26", "light": "#fde3e6" },
    "markdownText": { "dark": "darkFg", "light": "lightFg" },
    "markdownHeading": { "dark": "darkConstant", "light": "lightPurple" },
    "markdownLink": { "dark": "darkEntity", "light": "lightBlue" },
    "markdownLinkText": { "dark": "darkTag", "light": "lightCyan" },
    "markdownCode": { "dark": "darkString", "light": "lightGreen" },
    "markdownBlockQuote": { "dark": "darkSpecial", "light": "lightPeach" },
    "markdownEmph": { "dark": "darkSpecial", "light": "lightPeach" },
    "markdownStrong": { "dark": "darkFunc", "light": "lightFunction" },
    "markdownHorizontalRule": { "dark": "darkFgMuted", "light": "lightFgMuted" },
    "markdownListItem": { "dark": "darkEntity", "light": "lightBlue" },
    "markdownListEnumeration": { "dark": "darkTag", "light": "lightCyan" },
    "markdownImage": { "dark": "darkEntity", "light": "lightBlue" },
    "markdownImageText": { "dark": "darkTag", "light": "lightCyan" },
    "markdownCodeBlock": { "dark": "darkFg", "light": "lightFg" },
    "syntaxComment": { "dark": "darkComment", "light": "lightFgMuted" },
    "syntaxKeyword": { "dark": "darkKeyword", "light": "lightOrange" },
    "syntaxFunction": { "dark": "darkFunc", "light": "lightFunction" },
    "syntaxVariable": { "dark": "darkEntity", "light": "lightBlue" },
    "syntaxString": { "dark": "darkString", "light": "lightGreen" },
    "syntaxNumber": { "dark": "darkConstant", "light": "lightPurple" },
    "syntaxType": { "dark": "darkSpecial", "light": "lightPeach" },
    "syntaxOperator": { "dark": "darkOperator", "light": "lightOperator" },
    "syntaxPunctuation": { "dark": "darkFg", "light": "lightFg" }
  }
}
