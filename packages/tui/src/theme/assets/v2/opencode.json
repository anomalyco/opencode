        "800": "#fee3c7",
        "900": "#fef3e7"
      },
      "green": {
        "100": "#1f8c44",
        "200": "#3d9a57",
        "300": "#55a96a",
        "400": "#6cb77c",
        "500": "#81c68f",
        "600": "#96d5a3",
        "700": "#ace4b6",
        "800": "#c1f3ca",
        "900": "#e1fee6"
      },
      "cyan": {
        "100": "#077786",
        "200": "#318795",
        "300": "#4c97a4",
        "400": "#64a8b4",
        "500": "#7bb8c4",
        "600": "#92c9d4",
        "700": "#a8dbe4",
        "800": "#bfecf4",
        "900": "#e3fafe"
      },
      "blue": {
        "100": "#226bcc",
        "200": "#3b7dd8",
        "300": "#518ee4",
        "400": "#67a0f0",
        "500": "#7db1fc",
        "600": "#9cc3fa",
        "700": "#b7d4fd",
        "800": "#d4e5fd",
        "900": "#f0f6fe"
      },
      "purple": {
        "100": "#6b47a7",
        "200": "#7b5bb6",
        "300": "#8c6fc5",
        "400": "#9d83d4",
        "500": "#af98e3",
        "600": "#c1acf2",
        "700": "#d3c3fc",
        "800": "#e4dbfd",
        "900": "#f6f3ff"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    },
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "action": {
        "primary": {
          "$focused": "$hue.neutral.900"
        },
        "destructive": {
          "base": "$hue.neutral.900"
        }
      },
      "feedback": {
        "warning": {
          "base": "$hue.accent.200"
        }
      }
    },
    "border": {
      "base": "#b8b8b8"
    },
    "scrollbar": {
      "base": "#a0a0a0"
    },
    "diff": {
      "text": {
        "added": "#1e725c",
        "context": "#7086b5",
        "hunkHeader": "#7086b5"
      },
      "background": {
        "added": "#d5e5d5",
        "removed": "#f7d8db"
      },
      "highlight": {
        "added": "#4db380",
        "removed": "#f52a65"
      },
      "lineNumber": {
        "text": "#595959",
        "background": {
          "added": "#c5d5c5",
          "removed": "#e7c8cb"
        }
      }
    },
    "syntax": {
      "number": "$hue.accent.200",
      "type": "#b0851f"
    },
    "markdown": {
      "blockQuote": "#b0851f",
      "emphasis": "#b0851f",
      "strong": "$hue.accent.200"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#ffffff",
        "200": "#eeeeee",
        "300": "#b5b5b5",
        "400": "#808080",
        "500": "#4c4c4c",
        "600": "#1e1e1e",
        "700": "#141414",
        "800": "#0a0a0a",
        "900": "#030303"
      },
      "red": {
        "100": "#fd7e87",
        "200": "#e06c75",
        "300": "#c35a63",
        "400": "#a74952",
        "500": "#8c3941",
        "600": "#722931",
        "700": "#591921",
        "800": "#410a13",
        "900": "#280207"
      },
      "orange": {
        "100": "#fddac5",
        "200": "#fab283",
        "300": "#d8976c",
        "400": "#b67c56",
        "500": "#966341",
        "600": "#774a2c",
        "700": "#593319",
        "800": "#3d1d06",
        "900": "#1f0b01"
      },
      "green": {
        "100": "#96f7a7",
        "200": "#7fd88f",
        "300": "#68b977",
        "400": "#539c61",
        "500": "#3d7f4b",
