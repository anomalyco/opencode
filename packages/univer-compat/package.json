{
  "name": "@opencode-ai/univer-compat",
  "version": "1.2.24",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./drawing-plugin-normalize": "./src/drawing-plugin-normalize.ts"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p .",
    "test": "bun test ./test",
    "test:s3-it": "UNIVER_COMPAT_S3_IT=1 bun test ./test/s3-persist.integration.test.ts --timeout 180000",
    "test:presign-s3-it": "UNIVER_COMPAT_PRESIGN_S3_IT=1 bun test ./test/presign-auth-s3.integration.test.ts --timeout 180000",
    "serve": "bun --env-file=../../.env.development ./script/serve.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.993.0",
    "@aws-sdk/s3-request-presigner": "3.993.0",
    "@veritly/auth-shared": "workspace:*",
    "exceljs": "4.4.0",
    "hono": "catalog:",
    "ot-json1": "1.0.2",
    "xlsx": "0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "testcontainers": "11.14.0",
    "typescript": "catalog:"
  }
}
