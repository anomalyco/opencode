{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bolt-ai/protocol",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    "./simulation": "./src/simulation.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "generate": "bun run script/generate-openapi.ts",
    "check:generated": "bun run script/generate-openapi.ts --check",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@bolt-ai/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "prettier": "3.6.2",
    "typescript": "catalog:"
  }
}
