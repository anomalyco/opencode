{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode-ai/cloudsession",
  "version": "1.0.207",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "generate-types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "bun test src/**/*.test.ts",
    "test:api": "bun test src/api.test.ts",
    "test:storage": "bun test src/storage.test.ts",
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --keep-vars"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "latest",
    "@types/node": "catalog:",
    "typescript": "5.9.3",
    "wrangler": "4.63.0"
  },
  "dependencies": {
    "@cloudflare/types": "7.0.0",
    "@hono/zod-validator": "catalog:",
    "@opencode-ai/sdk": "workspace:*",
    "capnweb": "0.4.0",
    "hono": "catalog:",
    "marked": "17.0.1",
    "uuid": "13.0.0",
    "zod": "catalog:"
  }
}
