{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-code-coach",
  "version": "2.2.0",
  "description": "Post-send prompt nudge for opencode: silence by default, one Windows card for destructive asks, no prompt rewrite and no delay.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/code-coach"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "docs"
  ],
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test",
    "test:live": "powershell -NoProfile -STA -ExecutionPolicy Bypass -File tests/Run-Minimal.ps1"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta"
  }
}
