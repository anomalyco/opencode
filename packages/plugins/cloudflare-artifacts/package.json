{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-cloudflare-artifacts",
  "version": "2.4.1",
  "description": "Publish OpenCode artifacts to Cloudflare Workers, with D1, KV, R2 and Cron Triggers",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/cloudflare-artifacts"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts"
  ],
  "scripts": {
    "test": "bun run ../../core/script/test.ts",
    "test:live": "bun test --preload ./test/isolate.ts --timeout=900000 test/live.test.ts",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@opencode/core": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "drizzle-orm": "catalog:",
    "effect": "catalog:"
  }
}
