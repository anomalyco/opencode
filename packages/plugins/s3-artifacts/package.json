{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-s3-artifacts",
  "version": "2.4.1",
  "description": "Publish OpenCode artifacts to an S3-compatible bucket",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/s3-artifacts"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "18.0.11"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@opencode/core": "workspace:*",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "catalog:"
  }
}
