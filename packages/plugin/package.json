{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin",
  "version": "2.2.3",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "generate": "bun script/icon-name.ts"
  },
  "exports": {
    ".": "./src/promise/index.ts",
    "./effect": "./src/effect/index.ts",
    "./host": "./src/host.ts",
    "./runtime": "./src/runtime.ts",
    "./tui": "./src/tui/index.ts",
    "./gui": "./src/gui/index.ts",
    "./gui/main": "./src/gui/main.ts",
    "./gui/host": "./src/gui/host.ts",
    "./gui/builtin": "./src/gui/builtin.ts",
    "./gui/file": "./src/gui/file.ts",
    "./gui/review": "./src/gui/review.ts",
    "./gui/browser": "./src/gui/browser.ts",
    "./gui/updater": "./src/gui/updater.ts",
    "./gui/vite": "./src/gui/vite.ts",
    "./gui/*": null,
    "./*": "./src/*.ts"
  },
  "imports": {
    "#plugin-source": {
      "bun": "./src/source.bun.ts",
      "node": "./src/source.node.ts",
      "default": "./src/source.node.ts"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@ai-sdk/provider": "3.0.8",
    "@opencode/ai": "workspace:*",
    "@opencode/client": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:"
  },
  "peerDependencies": {
    "@opencode/theme": "workspace:*",
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "electron": "*",
    "solid-js": ">=1.9.0",
    "vite": ">=6",
    "vite-plugin-solid": ">=2.11"
  },
  "peerDependenciesMeta": {
    "@opencode/theme": {
      "optional": true
    },
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "electron": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-plugin-solid": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/theme": "workspace:*",
    "@opentui/core": "catalog:",
    "@opentui/solid": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "electron": "44.9.1",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "@typescript/native": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin"
  }
}
