{
  "name": "@opencode/ui",
  "version": "2.2.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.stories.ts",
    "!src/**/*.stories.tsx",
    "src/**/*.css",
    "src/data-display/line-comment/*.svg",
    "src/theme/themes/*.json",
    "src/components/app-icons/sprite.svg",
    "src/components/provider-icons/sprite.svg",
    "src/assets/icons/app/*",
    "src/assets/icons/file-types/*",
    "src/assets/fonts/*",
    "src/assets/audio/*",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./accordion": "./src/data-display/accordion/accordion.tsx",
    "./activity-ring": "./src/feedback/activity-ring/activity-ring.tsx",
    "./avatar": "./src/data-display/avatar/avatar.tsx",
    "./badge": "./src/data-display/badge/badge.tsx",
    "./button": "./src/actions/button/button.tsx",
    "./button.css": "./src/actions/button/button.css",
    "./checkbox": "./src/forms/checkbox/checkbox.tsx",
    "./dialog": "./src/overlays/dialog/dialog.tsx",
    "./diff-changes": "./src/data-display/diff-changes/diff-changes.tsx",
    "./divider": "./src/layout/divider/divider.tsx",
    "./document-surface.css": "./src/components/document-surface.css",
    "./field": "./src/forms/field/field.tsx",
    "./file-tree.css": "./src/styles/file-tree.css",
    "./icon": "./src/icons/icon/icon.tsx",
    "./icons/catalog": "./src/icons/catalog.ts",
    "./icon-button": "./src/actions/icon-button/icon-button.tsx",
    "./inline-input": "./src/forms/inline-input/inline-input.tsx",
    "./keybind": "./src/data-display/keybind/keybind.tsx",
    "./line-comment": "./src/data-display/line-comment/line-comment.tsx",
    "./loader": "./src/feedback/loader/loader.tsx",
    "./menu": "./src/navigation/menu/menu.tsx",
    "./motion": "./src/motion/index.ts",
    "./motion/solid": "./src/motion/solid.ts",
    "./motion-tuning": "./src/motion-tuning.ts",
    "./motion-tuning-features": "./src/motion-tuning-features.ts",
    "./motion-tuning-fields": "./src/motion-tuning-fields.ts",
    "./progress-circle": "./src/feedback/progress-circle/progress-circle.tsx",
    "./project-avatar": "./src/data-display/project-avatar/project-avatar.tsx",
    "./radio": "./src/forms/radio/radio.tsx",
    "./search-list": "./src/forms/search-list/search-list.tsx",
    "./segmented-control": "./src/navigation/segmented-control/segmented-control.tsx",
    "./select": "./src/forms/select/select.tsx",
    "./split-button": "./src/actions/split-button/split-button.tsx",
    "./switch": "./src/forms/switch/switch.tsx",
    "./tab-state-indicator": "./src/navigation/tab-state-indicator.tsx",
    "./tabs": "./src/navigation/tabs/tabs.tsx",
    "./text-input": "./src/forms/text-input/text-input.tsx",
    "./text-input.css": "./src/forms/text-input/text-input.css",
    "./textarea": "./src/forms/textarea/textarea.tsx",
    "./typeahead": "./src/forms/typeahead/typeahead.tsx",
    "./slash": "./src/typography/slash/slash.tsx",
    "./text-shimmer": "./src/typography/text-shimmer/text-shimmer.tsx",
    "./toast": "./src/feedback/toast/toast.tsx",
    "./tooltip": "./src/overlays/tooltip/tooltip.tsx",
    "./wordmark": "./src/typography/wordmark/wordmark.tsx",
    "./*": "./src/components/*.tsx",
    "./i18n/*": "./src/i18n/*.ts",
    "./hooks": "./src/hooks/index.ts",
    "./context": "./src/context/index.ts",
    "./context/*": "./src/context/*.tsx",
    "./storybook/scaffold": "./src/storybook/scaffold.tsx",
    "./storybook/fixtures": "./src/storybook/fixtures.ts",
    "./styles": "./src/styles/index.css",
    "./styles/tokens": "./src/styles/tokens/index.css",
    "./styles/tokens/*": "./src/styles/tokens/*",
    "./styles/tailwind": "./src/styles/tailwind/index.css",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*.ts",
    "./theme/context": "./src/theme/context.tsx",
    "./icons/provider": "./src/components/provider-icons/types.ts",
    "./icons/file-type": "./src/components/file-icons/types.ts",
    "./icons/app": "./src/components/app-icons/types.ts",
    "./fonts/*": "./src/assets/fonts/*",
    "./audio/*": "./src/assets/audio/*"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "test": "bun test src --only-failures",
    "dev": "vite",
    "bench:motion": "bun script/motion-bench.ts",
    "generate:tailwind": "bun run script/tailwind.ts",
    "generate:v2-oc2": "bun run script/build-oc2-v2-overrides.ts"
  },
  "devDependencies": {
    "@solidjs/meta": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "solid-js": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-icons-spritesheet": "3.0.1",
    "vite-plugin-solid": "catalog:"
  },
  "dependencies": {
    "@kitlangton/solid-motion": "0.2.2",
    "@kobalte/core": "catalog:",
    "@opencode/util": "workspace:*",
    "@pierre/diffs": "catalog:",
    "@pierre/highlights": "catalog:",
    "@solid-primitives/event-listener": "catalog:",
    "@solid-primitives/resize-observer": "catalog:",
    "fuzzysort": "catalog:",
    "katex": "0.18.11",
    "knobs": "npm:@kitlangton/knobs@0.4.0-next.22",
    "marked": "catalog:",
    "solid-list": "catalog:",
    "solid-sonner": "catalog:"
  },
  "peerDependencies": {
    "@solidjs/meta": "^0.29.0",
    "solid-js": "^1.9.8"
  }
}
