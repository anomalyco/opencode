{
  "name": "@athena/ui",
  "version": "1.3.7",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./*": "./src/components/*.tsx",
    "./i18n/*": "./src/i18n/*.ts",
    "./pierre": "./src/pierre/index.ts",
    "./pierre/*": "./src/pierre/*.ts",
    "./hooks": "./src/hooks/index.ts",
    "./context": "./src/context/index.ts",
    "./context/*": "./src/context/*.tsx",
    "./styles": "./src/styles/index.css",
    "./styles/tailwind": "./src/styles/tailwind/index.css",
    "./theme": "./src/theme/index.ts",
    "./theme/*": "./src/theme/*.ts",
    "./theme/context": "./src/theme/context.tsx",
    "./icons/provider": "./src/components/provider-icons/types.ts",
    "./icons/file-type": "./src/components/file-icons/types.ts",
    "./icons/app": "./src/components/app-icons/types.ts",
    "./fonts/*": "./src/assets/fonts/*",
    "./audio/*": "./src/assets/audio/*"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "dev": "vite",
    "generate:tailwind": "bun run script/tailwind.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@tsconfig/node22": "latest",
    "@types/bun": "latest",
    "@types/katex": "0.16.7",
    "@types/luxon": "latest",
    "@typescript/native-preview": "latest",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vite-plugin-icons-spritesheet": "3.0.1",
    "vite-plugin-solid": "latest"
  },
  "dependencies": {
    "@kobalte/core": "latest",
    "@athena/sdk": "workspace:*",
    "@athena/util": "workspace:*",
    "@pierre/diffs": "latest",
    "@shikijs/transformers": "3.9.2",
    "@solid-primitives/bounds": "0.1.3",
    "@solid-primitives/media": "2.3.3",
    "@solid-primitives/resize-observer": "2.1.3",
    "@solidjs/meta": "latest",
    "@solidjs/router": "latest",
    "dompurify": "3.3.1",
    "fuzzysort": "latest",
    "katex": "0.16.27",
    "luxon": "latest",
    "marked": "latest",
    "marked-katex-extension": "5.1.6",
    "marked-shiki": "latest",
    "morphdom": "2.7.8",
    "motion": "12.34.5",
    "motion-dom": "12.34.3",
    "motion-utils": "12.29.2",
    "remeda": "latest",
    "remend": "latest",
    "shiki": "latest",
    "solid-js": "latest",
    "solid-list": "latest",
    "strip-ansi": "7.1.2",
    "virtua": "latest"
  }
}
