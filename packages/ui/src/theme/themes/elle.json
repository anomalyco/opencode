{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Elle",
  "id": "elle",
  "light": {
    "palette": {
      "neutral": "#fdf0ff",
      "ink": "#422342",
      "primary": "#d9368b",
      "accent": "#f06eae",
      "success": "#65ad82",
      "warning": "#d9a238",
      "error": "#dc527d",
      "info": "#c52f79",
      "diffAdd": "#cce9d7",
      "diffDelete": "#f8c5d5"
    },
    "overrides": {
      "syntax-comment": "#9f7b9f",
      "syntax-keyword": "#cf2f82",
