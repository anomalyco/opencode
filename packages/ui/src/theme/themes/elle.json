    "overrides": {
      "syntax-comment": "#96749f",
      "syntax-keyword": "#f05ca5",
      "syntax-string": "#82d4a0",
      "syntax-primitive": "#ff8bc4",
      "syntax-property": "#e34b96",
      "syntax-type": "#ffadd3",
      "syntax-constant": "#f0799c"
