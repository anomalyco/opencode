{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Espresso",
  "id": "espresso",
  "light": {
    "palette": {
      "neutral": "#f1e4d3",
      "ink": "#291a10",
      "primary": "#964b18",
      "accent": "#7a354e",
      "success": "#2e6b35",
      "warning": "#855206",
      "error": "#a6281e",
      "info": "#266170",
      "interactive": "#964b18",
      "diffAdd": "#2e6b35",
      "diffDelete": "#a6281e"
    },
    "overrides": {
      "text-weak": "#634b3b",
      "syntax-comment": "#6b5343",
      "syntax-keyword": "#8f4614",
      "syntax-string": "#2b6632",
      "syntax-primitive": "#235c6b",
      "syntax-property": "#75324a",
      "syntax-type": "#7d4d06",
      "syntax-constant": "#9c3221"
    },
    "v2Overrides": {
      "v2-background-bg-contrast": "#4d2810"
    }
  },
  "dark": {
    "palette": {
      "neutral": "#1e1612",
      "ink": "#efe1d4",
      "primary": "#e09052",
      "accent": "#d98ca3",
      "success": "#8ec479",
      "warning": "#e8bd70",
      "error": "#e86f61",
      "info": "#7ec2cf",
      "interactive": "#e09052",
      "diffAdd": "#8ec479",
      "diffDelete": "#e86f61"
    },
    "overrides": {
      "text-weak": "#ad9786",
      "syntax-comment": "#968070",
      "syntax-keyword": "#e59a5e",
      "syntax-string": "#98cc82",
      "syntax-primitive": "#86cad6",
      "syntax-property": "#e09ab0",
      "syntax-type": "#ecc57c",
      "syntax-constant": "#eb8475"
    },
    "v2Overrides": {
      "v2-background-bg-icon-button-contrast": "#e6c3a5",
      "v2-icon-icon-inverse": "var(--v2-grey-1100)"
    }
  }
}
