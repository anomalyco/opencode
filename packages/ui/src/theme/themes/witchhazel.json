      "diffAdd": "#c2ffdf",
      "diffDelete": "#ff6e8e"
    },
    "overrides": {
      "text-weak": "#b5abc9",
      "syntax-comment": "#9e93b5",
      "syntax-keyword": "#c2ffdf",
      "syntax-string": "#7ce4f7",
      "syntax-primitive": "#ceb1ff",
      "syntax-property": "#ffb8d1",
      "syntax-type": "#fff2a6",
      "syntax-constant": "#c5a3ff"
    },
    "v2Overrides": {
      "v2-background-bg-icon-button-contrast": "#decaff",
      "v2-icon-icon-inverse": "var(--v2-grey-1100)"
    }
