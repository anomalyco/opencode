{
  "$schema": "https://opencode.ai/desktop-theme.json",
  "name": "Witch Hazel",
  "id": "witchhazel",
  "light": {
    "palette": {
      "neutral": "#f1e6fb",
      "ink": "#251638",
      "primary": "#732bc4",
      "accent": "#ad1f73",
      "success": "#177050",
      "warning": "#8a5700",
      "error": "#b51e49",
      "info": "#126682",
      "interactive": "#732bc4",
      "diffAdd": "#177050",
      "diffDelete": "#b51e49"
    },
    "overrides": {
      "text-weak": "#574370",
      "syntax-comment": "#624d7c",
      "syntax-keyword": "#166b4c",
      "syntax-string": "#12637d",
      "syntax-primitive": "#6e27bd",
      "syntax-property": "#852396",
      "syntax-type": "#825200",
