{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker-test",
  "main": "src/index.ts",
  "compatibility_date": "2024-01-01",

  // Custom domains configuration
  // These domains will route to this worker
  "routes": [
    {
      "pattern": "api.example.com",
      "custom_domain": true,
    },
    {
      "pattern": "api.test.example.com",
      "custom_domain": true,
    },
    {
      // Route pattern for path-based routing
      "pattern": "example.com/api/*",
      "custom_domain": false,
    },
  ],

  // Environment-specific configurations
  "env": {
    "dev": {
      "name": "worker-test-dev",
      "routes": [
        {
          "pattern": "api.dev.example.com",
          "custom_domain": true,
        },
      ],
    },
    "staging": {
      "name": "worker-test-staging",
      "routes": [
        {
          "pattern": "api.staging.example.com",
          "custom_domain": true,
        },
      ],
    },
    "production": {
      "name": "worker-test-production",
      "routes": [
        {
          "pattern": "api.example.com",
          "custom_domain": true,
        },
        {
          "pattern": "api.prod.example.com",
          "custom_domain": true,
        },
      ],
    },
  },

  // Observability
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },

  // Compatibility flags
  "compatibility_flags": ["nodejs_compat"],
}
