{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opendeepseek/console-core",
  "version": "1.0.181",
  "private": true,
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sts": "3.782.0",
    "@jsx-email/render": "1.1.1",
    "@opendeepseek/console-mail": "1.0.181",
    "@opendeepseek/console-resource": "1.0.181",
    "@planetscale/database": "1.19.0",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.41.0",
    "postgres": "3.4.7",
    "stripe": "18.0.0",
    "ulid": "3.0.1",
    "zod": "4.1.8"
  },
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "db": "sst shell drizzle-kit",
    "db-dev": "sst shell --stage dev -- drizzle-kit",
    "db-prod": "sst shell --stage production -- drizzle-kit",
    "shell": "sst shell -- node",
    "shell-dev": "sst shell --stage dev -- node",
    "shell-prod": "sst shell --stage production -- node",
    "update-models": "script/update-models.ts",
    "promote-models-to-dev": "script/promote-models.ts dev",
    "promote-models-to-prod": "script/promote-models.ts production",
    "pull-models-from-dev": "script/pull-models.ts dev",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251008.0",
    "@tsconfig/node22": "22.0.2",
    "@types/node": "22.13.9",
    "drizzle-kit": "0.30.5",
    "mysql2": "3.14.4",
    "typescript": "5.8.2",
    "@typescript/native-preview": "7.0.0-dev.20251207.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.2"
}
