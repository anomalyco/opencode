{
  "name": "@opencode/console-app",
  "version": "2.2.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "dev": "vite dev --host 0.0.0.0",
    "dev:enterprise": "bun --watch script/dev-enterprise.ts",
    "dev:remote": "bun sst shell --stage=dev bun dev",
    "build": "bun ./script/generate-sitemap.ts && vite build && bun ../../schema/script/config-schema.ts ./.output/public/config.json",
    "start": "vite start",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "@ibm/plex": "6.4.1",
    "@kobalte/core": "catalog:",
    "@opencode/console-resource": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "aws4fetch": "1.0.20",
    "nitro": "3.0.1-alpha.1",
    "number-flow": "0.6.2",
    "solid-js": "catalog:",
    "vite": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "@webgpu/types": "0.1.54",
    "typescript": "catalog:",
    "wrangler": "4.50.0"
  },
  "engines": {
    "node": ">=22"
  }
}
