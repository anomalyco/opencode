{
  "name": "@opencode/console-app",
  "version": "2.2.5",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "dev": "bun ./script/build-stamp.ts --dev && bun ./script/og.ts && vite dev --host 0.0.0.0",
    "dev:enterprise": "bun --watch script/dev-enterprise.ts",
    "dev:remote": "bun sst shell --stage=dev bun dev",
    "build": "bun ./script/build-stamp.ts && bun ./script/github-snapshot.ts && bun ./script/og.ts && bun run --cwd ../textjs build && vite build && bun ./script/check-server-bundle.ts && bun ./script/check-client-bundle.ts && bun ../../schema/script/config-schema.ts ./.output/public/config.json",
    "start": "vite start",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "@ibm/plex": "6.4.1",
    "@kitlangton/rolling-number": "0.4.1",
    "@kobalte/core": "catalog:",
    "@opencode/console-resource": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "aws4fetch": "1.0.20",
    "nitro": "3.0.260903-beta",
    "number-flow": "0.6.2",
    "solid-js": "catalog:",
    "three": "0.180.0",
    "uqr": "0.1.3",
    "vite": "8.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@types/bun": "catalog:",
    "@types/three": "0.180.0",
    "@typescript/native": "catalog:",
    "@webgpu/types": "0.1.54",
    "playwright-core": "1.59.1",
    "satori": "0.63.2",
    "sharp": "0.34.5",
    "typescript": "catalog:",
    "wawoff2": "2.0.1",
    "wrangler": "4.50.0"
  },
  "engines": {
    "node": ">=24"
  }
}
