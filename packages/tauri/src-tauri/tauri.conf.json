{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open DeepSeek",
  "identifier": "com.opendeepseek.desktop",
  "mainBinaryName": "Open DeepSeek",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "dmg",
      "nsis",
      "app"
    ],
    "externalBin": [
      "sidecars/opendeepseek-cli"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/dev/icon.ico",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp"
      }
    }
  }
}