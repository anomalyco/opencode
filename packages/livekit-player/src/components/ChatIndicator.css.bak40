.chat-indicator {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: visible;
  width: 100vw;
  height: 100vh;
  position: relative;
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
  perspective: 1000px;
}

.status-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  -webkit-app-region: no-drag;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
  perspective: 1000px;
  scale: min(calc(100vw / 400), calc(100vh / 500));
}

.status-container:nth-child(1) {
  z-index: 2;
  transform: translate(calc(-51% + 11px), -51%) translateZ(0);
}

.status-container:nth-child(2) {
  z-index: 1;
  transform: translate(calc(-49% + 11px), -49%) translateZ(0);
}

.blob-container {
  width: 100%;
  height: 45vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
}

.blob-svg {
  width: 100%;
  height: 100%;
  filter: none;
  transform: translateZ(0);
  will-change: transform;
  backface-visibility: hidden;
}

.blob-main {
  transform-origin: center;
  transform: translateZ(0);
  will-change: transform, opacity;
  backface-visibility: hidden;
}

.blob-orb {
  transform-origin: center;
  transform: translateZ(0);
  will-change: transform, opacity;
  backface-visibility: hidden;
}

.blob-glow {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) translateZ(0);
  width: 600px;
  height: 600px;
  border-radius: 50%;
  filter: blur(200px);
  opacity: 0.6;
  pointer-events: none;
  z-index: -1;
  will-change: background, opacity;
  backface-visibility: hidden;
}

.connection-status {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 8px;
  padding: 8px 16px;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 20px;
  backdrop-filter: blur(10px);
}

.status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: white;
  font-weight: 500;
}

.status-indicator svg {
  width: 20px;
  height: 20px;
}

.state-disconnected { color: #ef4444; }
.state-connecting { color: #f59e0b; }
.state-listening { color: #3b82f6; }
.state-speaking { color: #a78bfa; }

.quality-excellent { color: #22c55e; }
.quality-good { color: #84cc16; }
.quality-poor { color: #f59e0b; }
.quality-lost { color: #ef4444; }

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.state-connecting svg {
  animation: pulse 1.5s ease-in-out infinite;
}
