{
  "name": "@opencode-ai/pty",
  "version": "0.3.1",
  "description": "Persistent PTY service for OpenCode",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode-pty.git"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
