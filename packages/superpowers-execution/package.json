{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bearmanser/opencode-superpowers-execution",
  "version": "0.1.0",
  "description": "Portable execution run and reporting contract for the Superpowers execution UI",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./contract": "./src/contract.ts",
    "./progress": "./src/progress.ts",
    "./schema": "./src/schema.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "tsgo --noEmit",
    "build": "bun run script/build.ts",
    "package:smoke": "bun test --timeout 120000 test/package-smoke.test.ts",
    "package:host-smoke": "EXECUTION_PACKAGE_HOST_SMOKE=1 bun test --timeout 180000 test/package-smoke.test.ts"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
