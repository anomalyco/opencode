{
  "name": "@opencode-ai/claxedo-app",
  "version": "1.1.34",
  "description": "Cloud extension package for OpenCode (Claxedo)",
  "type": "module",
  "exports": {
    ".": "./src/index.tsx",
    "./extensions": "./src/extensions/index.ts",
    "./extensions/*": "./src/extensions/*.tsx",
    "./i18n": "./src/i18n/cloud-strings.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./pages": "./src/pages/index.ts",
    "./pages/*": "./src/pages/*.tsx",
    "./providers": "./src/providers/index.ts",
    "./providers/*": "./src/providers/*.tsx"
  },
  "scripts": {
    "typecheck": "tsgo -b",
    "dev": "CLAXEDO_OVERRIDES=1 vite --config vite.cloud.config.ts",
    "build": "CLAXEDO_OVERRIDES=1 vite build --config vite.cloud.config.ts",
    "serve": "CLAXEDO_OVERRIDES=1 vite preview --config vite.cloud.config.ts",
    "desktop:dev": "CLAXEDO_OVERRIDES=1 bun ./scripts/desktop-dev.ts",
    "desktop:build": "CLAXEDO_OVERRIDES=1 bun ./scripts/desktop-build.ts",
    "desktop:build:prod": "CLAXEDO_OVERRIDES=1 bun ./scripts/desktop-build.ts --prod",
    "opencode:build": "bun ./scripts/build-opencode.ts",
    "opencode:build:single": "bun ./scripts/build-opencode.ts --single",
    "opencode:dev": "bun ./scripts/opencode-dev.ts",
    "desktop:dev:local": "bun ./scripts/desktop-dev-local.ts",
    "test": "bun test --conditions=browser --preload ./happydom.ts ./src",
    "test:watch": "bun test --watch --conditions=browser --preload ./happydom.ts ./src",
    "test:ui": "vitest run --config vitest.config.ts",
    "test:ui:watch": "vitest --config vitest.config.ts",
    "test:stagehand:red": "node ./e2e/stagehand/terminal-reactivation.red.mjs",
    "test:stagehand:red:visual-broken": "STAGEHAND_SPLIT_CLOSE_FLOW=1 node ./e2e/stagehand/terminal-reactivation.red.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/user-event": "^14.6.1",
    "@happy-dom/global-registrator": "20.0.11",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "catalog:",
    "@types/luxon": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "jsdom": "^26.1.0",
    "typescript": "catalog:",
    "playwright-core": "^1.57.0",
    "vite": "catalog:",
    "vitest": "^2.1.8",
    "vite-plugin-solid": "catalog:"
  },
  "dependencies": {
    "@clerk/clerk-js": "^5.35.0",
    "@opencode-ai/app": "workspace:*",
    "@opencode-ai/app-shared": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@opencode-ai/util": "workspace:*",
    "@solid-primitives/event-bus": "1.1.2",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/media": "2.3.3",
    "@solid-primitives/resize-observer": "2.1.3",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@tanstack/solid-query": "5.90.23",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-deep-link": "~2",
    "@tauri-apps/plugin-dialog": "~2",
    "@tauri-apps/plugin-http": "2.5.6",
    "@tauri-apps/plugin-notification": "~2",
    "@tauri-apps/plugin-os": "~2",
    "@tauri-apps/plugin-process": "~2",
    "@tauri-apps/plugin-shell": "~2",
    "@tauri-apps/plugin-store": "~2",
    "@tauri-apps/plugin-updater": "~2",
    "@thisbeyond/solid-dnd": "0.7.5",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-clipboard": "^0.1.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-image": "^0.8.0",
    "@xterm/addon-ligatures": "^0.9.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "luxon": "catalog:",
    "remeda": "catalog:",
    "solid-js": "catalog:"
  },
  "peerDependencies": {
    "@opencode-ai/app": "workspace:*",
    "solid-js": "catalog:"
  }
}
