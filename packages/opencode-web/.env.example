# ===========================================
# OpenCode Web API Gateway Configuration
# ===========================================
# Copy this file to .env and modify as needed:
#   cp .env.example .env
# ===========================================

# Server
PORT=3000
HOST=0.0.0.0

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Option 1: Using Docker (docker-compose)
#   DATABASE_URL=postgres://opencode:opencode@localhost:5432/opencode
#
# Option 2: Using local PostgreSQL
#   1. Create database: psql -U postgres -c "CREATE DATABASE opencode;"
#   2. Update connection string below with your credentials
#   DATABASE_URL=postgres://postgres:your_password@localhost:5432/opencode
#
# Option 3: Using remote PostgreSQL
#   DATABASE_URL=postgres://user:password@your-host:5432/opencode
# ===========================================
DATABASE_URL=postgres://opencode:opencode@localhost:5432/opencode

# ===========================================
# Redis (for BullMQ task queue)
# ===========================================
# Option 1: Using Docker (docker-compose)
#   REDIS_URL=redis://localhost:6379
#
# Option 2: Using local Redis
#   Default: redis://localhost:6379
#   With password: redis://:your_password@localhost:6379
#
# Option 3: Using remote Redis
#   REDIS_URL=redis://:password@your-host:6379
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANT: Change this in production!
# Generate a secure key: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ===========================================
# Docker Sandbox Configuration
# ===========================================
# Docker socket path
#   Linux/macOS: /var/run/docker.sock
#   Windows (Docker Desktop): //./pipe/docker_engine
DOCKER_SOCKET=/var/run/docker.sock

# Sandbox container image
SANDBOX_IMAGE=opencode-sandbox:latest

# Resource limits per container
SANDBOX_MEMORY_LIMIT=2147483648    # 2GB in bytes
SANDBOX_CPU_LIMIT=2                 # Number of CPU cores
SANDBOX_IDLE_TIMEOUT=1800000        # 30 minutes in milliseconds

# ===========================================
# Workspace Storage
# ===========================================
# Base path for project workspaces
#   Linux/macOS: /var/lib/opencode/workspaces
#   Windows: C:/opencode/workspaces
WORKSPACE_BASE_PATH=/var/lib/opencode/workspaces
