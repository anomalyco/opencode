# Server
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgres://opencode:opencode@localhost:5432/opencode

# Redis
REDIS_URL=redis://localhost:6379

# JWT (change in production!)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Docker
DOCKER_SOCKET=/var/run/docker.sock
SANDBOX_IMAGE=opencode-sandbox:latest
SANDBOX_MEMORY_LIMIT=2147483648
SANDBOX_CPU_LIMIT=2
SANDBOX_IDLE_TIMEOUT=1800000

# Workspace
WORKSPACE_BASE_PATH=/var/lib/opencode/workspaces
