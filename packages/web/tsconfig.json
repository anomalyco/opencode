{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "tsx": "preserve",
    "jsxImportSource": "solid-js",
    "tsxImportSource": "solid-js",
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./pages/*"],
      "@@/*": ["./assets/*"]
    }
  },
  "include": ["vite.config.ts"]
}
