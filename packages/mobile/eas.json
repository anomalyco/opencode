{
  "cli": {
    "version": ">= 16.17.4",
    "appVersionSource": "remote"
  },
  "build": {
    "sim": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.12.0",
      "bun": "1.2.15",
      "ios": {
        "simulator": true,
        "image": "macos-sonoma-14.6-xcode-16.1"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "dev"
      }
    },
    "dev": {
      "developmentClient": true,
      "distribution": "internal",

      "env": {
        "EXPO_PUBLIC_ENV": "dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",

      "env": {
        "EXPO_PUBLIC_ENV": "preview"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
