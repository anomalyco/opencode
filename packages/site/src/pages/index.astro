---
import Layout from '~/layouts/Layout.astro';
import CommandBlock from '~/components/CommandBlock.astro';
import { CommandText } from '~/components/CommandText';
import { ShimmerText } from '~/components/ShimmerText';
import { ExecutableShimmer } from '~/components/ExecutableShimmer';
import { agents } from '~/data/agents';
import fs from 'fs';
import path from 'path';

const metadata = {
  title: 'Forge',
  ignoreTitleTemplate: true,
};

// Read ASCII art from file
const asciiArt = fs.readFileSync(path.join(process.cwd(), 'src', 'ascii-logo.txt'), 'utf-8');

// Define the order for the chips: single scrollable row
const allAgents = ['claude', 'codex', 'gemini', 'opencode', 'kimi', 'stakpak', 'auggie', 'goose'];
const initialSelectedAgent = 'claude';

const getAgentByCommand = (command: string) => agents.find((agent) => agent.command === command);
