  <script>
    import { agents } from '../data/agents';

    const selectedAgent = { current: 'claude' as string };

    const setChipState = (agent: string, isActive: boolean) => {
      const chips = document.querySelectorAll(`[data-agent="${agent}"]`);
      chips.forEach((chip) => {
        const button = chip as HTMLElement;
        if (isActive) {
          button.classList.remove('bg-zinc-800/50', 'text-zinc-400', 'border-zinc-700');
          button.classList.add('bg-zinc-700', 'text-white');
          const color = button.dataset.color;
          if (color) {
            button.style.borderColor = color;
            return;
          }
          button.style.borderColor = '';
          return;
        }

        button.classList.remove('bg-zinc-700', 'text-white');
        button.classList.add('bg-zinc-800/50', 'text-zinc-400', 'border-zinc-700');
        button.style.borderColor = '';
      });
    };

    function updateCommand() {
      // Get the agent config for selected agent
      const agentConfig = agents.find((a) => a.command === selectedAgent.current);

      if (!agentConfig) return;

      // Update desktop agent name
      const agentNameDesktop = document.getElementById('agent-name-desktop');
      if (agentNameDesktop) {
        agentNameDesktop.textContent = selectedAgent.current;
      }

      // Update mobile agent name
      const agentNameMobile = document.getElementById('agent-name-mobile');
      if (agentNameMobile) {
        agentNameMobile.textContent = selectedAgent.current;
      }

      // Update the ExecutableShimmer components
      window.dispatchEvent(
        new CustomEvent('updateExecutableShimmer', {
          detail: {
            agents: [
              {
                name: agentConfig.command,
                color: agentConfig.borderColor,
              },
            ],
          },
        })
      );
    }

    // Handle agent chip clicks
    const agentChips = document.querySelectorAll('.agent-chip');
    agentChips.forEach((chip) => {
      chip.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const agent = target.dataset.agent;

        if (!agent || agent === selectedAgent.current) return;

        setChipState(selectedAgent.current, false);
        selectedAgent.current = agent;
        setChipState(agent, true);

        updateCommand();

        // Dispatch agent changed event
        const agentConfig = agents.find((a) => a.command === selectedAgent.current);
        window.dispatchEvent(
          new CustomEvent('agentChanged', {
            detail: { color: agentConfig?.borderColor },
          })
        );
      });
    });

    // Set initial active state on selected agent
    setChipState(selectedAgent.current, true);

    // Set initial copy button color
    const agentConfig = agents.find((a) => a.command === selectedAgent.current);
    if (agentConfig) {
      window.dispatchEvent(
        new CustomEvent('agentChanged', {
          detail: { color: agentConfig.borderColor },
        })
      );
    }

    // Apply initial command coloring
    updateCommand();

    // Copy functionality
    function copyToClipboard(text: string, button: HTMLElement) {
      navigator.clipboard.writeText(text).then(() => {
        button.classList.add('copied');

        const copyIcon = button.querySelector('.copy-icon');
        const checkIcon = button.querySelector('.check-icon');

        if (copyIcon) copyIcon.classList.add('hidden');
        if (checkIcon) checkIcon.classList.remove('hidden');

        setTimeout(() => {
          button.classList.remove('copied');
          if (copyIcon) copyIcon.classList.remove('hidden');
          if (checkIcon) checkIcon.classList.add('hidden');
        }, 2000);
      });
    }

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const button = btn as HTMLElement;
        const targetId = button.dataset.target;
        if (targetId) {
          const target = document.getElementById(targetId);
          if (target) {
            copyToClipboard(target.textContent || '', button);
          }
        }
      });
    });
  </script>
</Layout>
