{
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/install",
      "destination": "https://raw.githubusercontent.com/forge-agents/forge/main/install",
      "permanent": false
    },
    {
      "source": "/discord",
      "destination": "https://discord.gg/P6Z4yn34RR",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
