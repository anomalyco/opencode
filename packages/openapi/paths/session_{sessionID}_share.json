            }
          }
        }
      },
      "400": {
        "description": "Bad request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/BadRequestError.json"
            }
          }
        }
      },
      "404": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "../components/schemas/NotFoundError.json"
            }
          }
        }
      }
    },
    "x-codeSamples": [
