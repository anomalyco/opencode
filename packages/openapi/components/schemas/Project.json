{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "worktree": {
      "type": "string"
    },
    "vcs": {
      "type": "string",
      "const": "git"
    },
    "name": {
      "type": "string"
    },
    "icon": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "override": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "object",
      "properties": {
        "start": {
          "description": "Startup script to run when creating a new workspace (worktree)",
