  "powershell": [
    { "id": "simple", "category": "static", "input": "Get-ChildItem" },
    { "id": "list", "category": "static", "input": "Get-ChildItem; Write-Output 'done'" },
    { "id": "pipeline", "category": "static", "input": "Get-Content input.txt | Select-String needle" },
