{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bolt-ai/client",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "exports": {
    ".": "./src/promise/index.ts",
    "./promise": "./src/promise/index.ts",
    "./promise/api": "./src/promise/api.ts",
    "./service": "./src/promise/service.ts",
    "./solid": "./src/solid/index.ts",
    "./effect": "./src/effect/index.ts",
    "./effect/api": "./src/effect/api.ts",
    "./effect/service": "./src/effect/service.ts",
    "./mcp": "./src/mcp.ts"
  },
  "scripts": {
    "build": "bun run script/build-package.ts",
    "generate": "bun run script/build.ts",
    "check:generated": "bun run generate && git diff --exit-code -- src/promise/generated src/effect/generated src/effect/api",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@bolt-ai/schema": "workspace:*",
    "@bolt-ai/protocol": "workspace:*"
  },
  "peerDependencies": {
    "effect": "catalog:",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:",
    "@bolt-ai/core": "workspace:*",
    "@bolt-ai/httpapi-codegen": "workspace:*",
    "@bolt-ai/server": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "solid-js": "catalog:"
  }
}
