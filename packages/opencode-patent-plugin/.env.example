# YunPat Patent Plugin 环境配置
# 复制为 .env 并根据实际环境修改

# --- PostgreSQL: patent_db (7500万+中国专利) ---
PATENT_DB_HOST=localhost
PATENT_DB_PORT=5432
PATENT_DB_USER=postgres
PATENT_DB_PASSWORD=
PATENT_DB_DATABASE=patent_db

# --- PostgreSQL: legal_world_model (法规/判例) ---
LEGAL_DB_HOST=localhost
LEGAL_DB_PORT=5432
LEGAL_DB_USER=postgres
LEGAL_DB_PASSWORD=
LEGAL_DB_DATABASE=legal_world_model

# --- YunPat Agent 路径（可选，未设置则使用纯 LLM 模式） ---
YUNPAT_PATH=

# --- Obsidian 知识库（可选） ---
OBSIDIAN_KB_PATH=

# --- LLM 服务（OpenAI-compatible API） ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
