{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-patent-plugin",
  "version": "0.1.0",
  "description": "YunPat Patent Intelligence Plugin for OpenCode - 知识产权智能体插件",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@opencode-ai/plugin": "workspace:*",
    "@opencode-ai/sdk": "workspace:*",
    "effect": "catalog:",
    "pg": "8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@opentui/solid": "0.2.4",
    "@tsconfig/node22": "catalog:",
    "@types/bun": "1.3.12",
    "@types/node": "catalog:",
    "@types/pg": "8.20.0",
    "solid-js": "1.9.12",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "opencode": ">=1.14.0"
  },
  "engines": {
    "opencode": ">=1.14.0"
  },
  "yunpat": {
    "note": "YunPat packages are loaded dynamically at runtime via require/import from YUNPAT_PATH"
  }
}
