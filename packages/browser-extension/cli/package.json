  "description": "OpenCode Browser: connect the extension to opencode, and drive your browser from any agent (CLI, MCP, Playwright).",
  "type": "module",
  "license": "MIT",
  "bin": {
    "opencode-browser": "dist/cli.mjs",
    "opencode-browser-cli": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "extension",
    "skills"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
