    "@effect/platform-node-shared": "4.0.1",
    "acorn": "8.18.0",
    "effect": "4.0.1",
    "pixelmatch": "7.2.0",
    "patchright-core": "1.63.0",
    "pngjs": "7.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "jsonc-parser": "3.3.1"
  }
