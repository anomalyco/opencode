#!/bin/sh
set -e

# This is the npm entry point for lash-cli
# It requires Bun to be installed

# Check if Bun is available
if ! command -v bun >/dev/null 2>&1; then
    echo "Error: Bun is required to run lash-cli" >&2
    echo "" >&2
    echo "Please install Bun first:" >&2
    echo "  curl -fsSL https://bun.sh/install | bash" >&2
    echo "" >&2
    echo "Or on macOS with Homebrew:" >&2
    echo "  brew install oven-sh/bun/bun" >&2
    exit 1
fi

# Find the real location of this script
if [ -L "$0" ]; then
    # It's a symlink, find the real file
    REAL_SCRIPT="$(readlink "$0")"
    if [ "${REAL_SCRIPT#/}" = "$REAL_SCRIPT" ]; then
        # Relative path, resolve from symlink directory
        REAL_DIR="$(dirname "$0")"
        REAL_SCRIPT="$REAL_DIR/$REAL_SCRIPT"
    fi
else
    REAL_SCRIPT="$0"
fi

# Get the package root directory
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT")" && pwd)"
PKG_ROOT="$(dirname "$SCRIPT_DIR")"

# Check if we're in development (local) or production (npm installed)
if [ -f "$PKG_ROOT/src/index.ts" ]; then
    # Run with Bun using the TypeScript source
    exec bun run "$PKG_ROOT/src/index.ts" "$@"
else
    echo "Error: Could not find src/index.ts in $PKG_ROOT" >&2
    echo "Package may be incorrectly installed." >&2
    exit 1
fi