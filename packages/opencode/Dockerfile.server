FROM oven/bun:1.3.14-alpine AS base

WORKDIR /app

ENV NODE_ENV=production
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=0

FROM base AS pruner

COPY . .

RUN bunx turbo@2.8.13 prune opencode --docker --no-update-notifier --no-color

FROM base AS installer

COPY --from=pruner /app/out/json/ ./

RUN bun -e 'const packageJson = await Bun.file("package.json").json(); packageJson.workspaces.packages = Array.from(new Bun.Glob("packages/**/package.json").scanSync(".")).map((file) => file.slice(0, -"/package.json".length)).sort(); await Bun.write("package.json", JSON.stringify(packageJson, null, 2) + "\n")'
RUN rm -f bun.lock && bun install --filter opencode --lockfile-only --ignore-scripts
RUN bun install --filter opencode --frozen-lockfile --ignore-scripts

FROM base AS runner

RUN apk add --no-cache curl git libgcc libstdc++ ripgrep

COPY --from=installer /app ./
COPY --from=pruner /app/out/full/ ./

RUN bun run --cwd packages/core fix-node-pty

WORKDIR /app/packages/opencode

ENV OPENCODE_PORT=4096

EXPOSE 4096

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD curl -fsS "http://127.0.0.1:${OPENCODE_PORT}/global/health" >/dev/null || exit 1

CMD ["sh", "-c", "set --; for o in $(echo \"${OPENCODE_CORS_ORIGINS:-https://opencode-voice-ui.fly.dev}\" | tr ',' ' '); do set -- \"$@\" --cors \"$o\"; done; exec bun run --conditions=browser ./src/index.ts serve --hostname 0.0.0.0 --port \"${OPENCODE_PORT}\" \"$@\""]
