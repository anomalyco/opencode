{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "dockerfilePath": "packages/opencode/Dockerfile.railway",
    "watchPatterns": [
      "packages/opencode/**",
      "packages/util/**",
      "packages/plugin/**",
      "packages/sdk/**",
      "package.json",
      "bun.lock"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/global/health",
    "healthcheckTimeout": 30
  }
}
