{
  "snapshots": false,
  "media": {
    "image": { "auto_resize": false, "max_width": 1920, "max_height": 1080, "max_base64_bytes": 4096 },
  },
  "compaction": { "auto": false, "keep": { "tokens": 12000 }, "buffer": 2048 },
  "experimental": {
    "subagent_depth": 3,
    "policies": [{ "effect": "deny", "action": "provider.use", "resource": "openai" }],
    "batch_tool": true,
  },
}
