{
  "mcp": {
    "timeout": { "request": 8000 },
    "servers": {
      "both": { "type": "local", "command": ["both-mcp"], "timeout": { "startup": 1000, "request": 600000 } },
      "calls": { "type": "local", "command": ["calls-mcp"], "timeout": { "request": 600000 } },
      "startup": { "type": "local", "command": ["startup-mcp"], "timeout": { "startup": 60000 } },
    },
  },
}
