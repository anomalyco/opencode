{
  "mcp": {
    "both": {
      "type": "local",
      "command": ["both-mcp"],
      "enabled": true,
      "timeout": {
        "startup": 1000,
        "request": 600000
      }
    },
    "calls": {
      "type": "local",
      "command": ["calls-mcp"],
      "enabled": true,
      "timeout": {
        "request": 600000
      }
    },
    "startup": {
      "type": "local",
      "command": ["startup-mcp"],
      "enabled": true,
      "timeout": {
        "startup": 60000
      }
    }
  },
  "experimental": {
    "mcp_timeout": 8000
  }
}
