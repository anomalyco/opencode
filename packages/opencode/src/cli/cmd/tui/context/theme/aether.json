{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "ivory": "#FCFAF6",
    "linen": "#F8F5EF",
    "parchment": "#F3EEE8",
    "sand": "#E5DFD4",
    "sandLight": "#EDE6DE",
    "warmGray": "#E4DCD4",
    "stone": "#9C8E7A",
    "stoneLight": "#B4ABA2",
    "driftwood": "#6B5F4E",
    "driftwoodLight": "#878078",
    "espresso": "#3A3630",
    "bark": "#262320",
    "charcoal": "#201D19",
    "inkBlack": "#1A1714",
    "deepInk": "#4A443F",
    "clay": "#E8BCAF",
    "clayLight": "#D97757",
    "terracotta": "#8F6D61",
    "amber": "#DA702C",
    "amberLight": "#A28355",
    "gold": "#D0A215",
    "goldDark": "#B07A26",
    "sage": "#879A39",
    "sageDark": "#6F8A3A",
    "teal": "#3AA99F",
    "tealDark": "#8AA19D",
    "blue": "#4385BE",
    "blueDark": "#8F776C",
    "violet": "#8B7EC8",
    "violetDark": "#C9B8AF",
    "rose": "#CE5D97",
    "roseDark": "#B37A67",
    "red": "#D14D41",
    "redDark": "#B24A37"
  },
  "theme": {
    "primary": {
      "dark": "clayLight",
      "light": "clay"
    },
    "secondary": {
      "dark": "blue",
      "light": "blueDark"
    },
    "accent": {
      "dark": "violet",
      "light": "violetDark"
    },
    "error": {
      "dark": "red",
      "light": "redDark"
    },
    "warning": {
      "dark": "amber",
      "light": "terracotta"
    },
    "success": {
      "dark": "sage",
      "light": "sageDark"
    },
    "info": {
      "dark": "teal",
      "light": "tealDark"
    },
    "text": {
      "dark": "#E0D8C8",
      "light": "deepInk"
    },
    "textMuted": {
      "dark": "stone",
      "light": "driftwoodLight"
    },
    "background": {
      "dark": "inkBlack",
      "light": "ivory"
    },
    "backgroundPanel": {
      "dark": "charcoal",
      "light": "linen"
    },
    "backgroundElement": {
      "dark": "bark",
      "light": "parchment"
    },
    "border": {
      "dark": "espresso",
      "light": "warmGray"
    },
    "borderActive": {
      "dark": "driftwood",
      "light": "stoneLight"
    },
    "borderSubtle": {
      "dark": "bark",
      "light": "sand"
    },
    "diffAdded": {
      "dark": "sage",
      "light": "sageDark"
    },
    "diffRemoved": {
      "dark": "red",
      "light": "redDark"
    },
    "diffContext": {
      "dark": "stone",
      "light": "driftwoodLight"
    },
    "diffHunkHeader": {
      "dark": "blue",
      "light": "blueDark"
    },
    "diffHighlightAdded": {
      "dark": "sage",
      "light": "sageDark"
    },
    "diffHighlightRemoved": {
      "dark": "red",
      "light": "redDark"
    },
    "diffAddedBg": {
      "dark": "#1D2618",
      "light": "#EFF3EA"
    },
    "diffRemovedBg": {
      "dark": "#2B1A18",
      "light": "#F5E8E4"
    },
    "diffContextBg": {
      "dark": "charcoal",
      "light": "linen"
    },
    "diffLineNumber": {
      "dark": "stone",
      "light": "driftwoodLight"
    },
    "diffAddedLineNumberBg": {
      "dark": "#182015",
      "light": "#E4EBD9"
    },
    "diffRemovedLineNumberBg": {
      "dark": "#231515",
      "light": "#ECD8D2"
    },
    "markdownText": {
      "dark": "sand",
      "light": "deepInk"
    },
    "markdownHeading": {
      "dark": "clayLight",
      "light": "#3E3732"
    },
    "markdownLink": {
      "dark": "blue",
      "light": "blueDark"
    },
    "markdownLinkText": {
      "dark": "teal",
      "light": "tealDark"
    },
    "markdownCode": {
      "dark": "teal",
      "light": "#916F63"
    },
    "markdownBlockQuote": {
      "dark": "stone",
      "light": "driftwoodLight"
    },
    "markdownEmph": {
      "dark": "gold",
      "light": "amberLight"
    },
    "markdownStrong": {
      "dark": "clayLight",
      "light": "#2F2A25"
    },
    "markdownHorizontalRule": {
      "dark": "espresso",
      "light": "warmGray"
    },
    "markdownListItem": {
      "dark": "amber",
      "light": "terracotta"
    },
    "markdownListEnumeration": {
      "dark": "teal",
      "light": "tealDark"
    },
    "markdownImage": {
      "dark": "rose",
      "light": "violetDark"
    },
    "markdownImageText": {
      "dark": "teal",
      "light": "tealDark"
    },
    "markdownCodeBlock": {
      "dark": "sand",
      "light": "#433D38"
    },
    "syntaxComment": {
      "dark": "driftwood",
      "light": "stoneLight"
    },
    "syntaxKeyword": {
      "dark": "clayLight",
      "light": "terracotta"
    },
    "syntaxFunction": {
      "dark": "amber",
      "light": "terracotta"
    },
    "syntaxVariable": {
      "dark": "blue",
      "light": "#4A433E"
    },
    "syntaxString": {
      "dark": "teal",
      "light": "#A18A62"
    },
    "syntaxNumber": {
      "dark": "violet",
      "light": "roseDark"
    },
    "syntaxType": {
      "dark": "gold",
      "light": "amberLight"
    },
    "syntaxOperator": {
      "dark": "stone",
      "light": "#6A625B"
    },
    "syntaxPunctuation": {
      "dark": "stone",
      "light": "#6A625B"
    }
  }
}
