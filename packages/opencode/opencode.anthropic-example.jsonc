{
  "$schema": "https://opencode.ai/config.json",
  
  // Example configuration with all Anthropic features enabled
  
  "model": "anthropic/claude-sonnet-4-5",
  
  "anthropic": {
    // Core API features (all default to true)
    "promptCaching": true,
    "reportCacheSavings": true,
    "contextEditing": true,
    "extendedThinking": true,
    "citations": true,
    "tokenEfficientToolUse": true,
    "fineGrainedToolStreaming": true,
    
    // Built-in tool equivalents (OpenCode uses its own implementations)
    "codeExecutionTool": true,
    "textEditorTool": true,
    "webFetchTool": true,
    "webSearchTool": true,
    "memoryTool": true,
    "computerUseTool": false,  // Experimental, requires special setup
    
    // Advanced features
    "prefillAssistantMessages": true,
    "chainLongPrompts": true
  },
  
  // Provider configuration
  "provider": {
    "anthropic": {
      "options": {
        // API key from environment variable
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  
  // Optional: Enable MCP servers for additional capabilities
  "mcp": {
    // Example: Add Exa for web search
    "exa": {
      "type": "remote",
      "url": "https://smithery.ai/server/exa",
      "headers": {
        "Authorization": "Bearer {env:EXA_API_KEY}"
      }
    }
  }
}
