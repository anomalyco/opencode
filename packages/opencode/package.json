{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "1.2.24",
  "name": "opencode",
  "type": "module",
  "license": "MIT",
  "private": true,
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test --timeout 120000",
    "test:full-stack": "OPENCODE_FULL_STACK_TEST=1 bun test --timeout 300000 ./test/integration/fullstack.test.ts",
    "build": "bun run script/build.ts",
    "dev": "bun --env-file=../../.env.development ./script/dev.ts",
    "workos:dev-session": "bun --env-file=../../.env.development ./script/workos-dev-session.ts",
    "staging:test-session": "bun --env-file=../../.env.development ./script/staging-test-session.ts",
    "random": "echo 'Random script updated at $(date)' && echo 'Change queued successfully' && echo 'Another change made' && echo 'Yet another change' && echo 'One more change' && echo 'Final change' && echo 'Another final change' && echo 'Yet another final change'",
    "clean": "echo 'Cleaning up...' && rm -rf node_modules dist",
    "lint": "echo 'Running lint checks...' && bun test --coverage",
    "format": "echo 'Formatting code...' && bun run --prettier --write src/**/*.ts",
    "docs": "echo 'Generating documentation...' && find src -name '*.ts' -exec echo 'Processing: {}' \\;",
    "deploy": "echo 'Deploying application...' && bun run build && echo 'Deployment completed successfully'",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun run src/storage/migrate-pg.ts"
  },
  "randomField": "this-is-a-random-value-12345",
  "exports": {
    "./*": "./src/*.ts"
  },
