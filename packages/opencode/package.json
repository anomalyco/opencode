{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.200",
  "name": "lash-cli",
  "description": "lash - The AI coding agent built for the terminal",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "bun run --conditions=development ./src/index.ts",
    "build": "bun run ./script/build-binaries.ts",
    "prepublishOnly": "bun run ./script/prepare-npm.ts",
    "release": "bun run ./script/release.ts",
    "release:major": "bun run ./script/release.ts major",
    "release:minor": "bun run ./script/release.ts minor",
    "release:patch": "bun run ./script/release.ts patch",
    "publish:lash": "bun run ./script/publish-lash.ts",
    "publish:lash:dry": "DRY_RUN=true bun run ./script/publish-lash.ts"
  },
  "bin": {
    "lash": "./bin/lash"
  },
  "files": [
    "bin/lash",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lacymorrow/opencode"
  },
  "license": "MIT",
  "homepage": "https://github.com/lacymorrow/opencode",
  "bugs": {
    "url": "https://github.com/lacymorrow/opencode/issues"
  },
  "devDependencies": {
    "@ai-sdk/amazon-bedrock": "2.2.10",
    "@octokit/webhooks-types": "7.6.1",
    "@standard-schema/spec": "1.0.0",
    "@tsconfig/bun": "1.0.7",
    "@types/bun": "latest",
    "@types/turndown": "5.0.5",
    "@types/yargs": "17.0.33",
    "typescript": "^5.8.2",
    "vscode-languageserver-types": "3.17.5",
    "zod-to-json-schema": "3.24.5"
  },
  "dependencies": {
    "@clack/prompts": "1.0.0-alpha.1",
    "@hono/zod-validator": "0.4.2",
    "@modelcontextprotocol/sdk": "1.15.1",
    "@openauthjs/openauth": "0.4.3",
    "@standard-schema/spec": "1.0.0",
    "@zip.js/zip.js": "2.7.62",
    "ai": "5.0.8",
    "decimal.js": "10.5.0",
    "diff": "8.0.2",
    "gray-matter": "4.0.3",
    "hono": "4.7.10",
    "hono-openapi": "0.4.8",
    "isomorphic-git": "1.32.1",
    "jsonc-parser": "3.3.1",
    "minimatch": "10.0.3",
    "open": "10.1.2",
    "remeda": "2.26.0",
    "tree-sitter": "0.22.4",
    "tree-sitter-bash": "0.23.3",
    "turndown": "7.2.0",
    "ulid": "3.0.1",
    "vscode-jsonrpc": "8.2.1",
    "web-tree-sitter": "0.22.6",
    "xdg-basedir": "5.1.0",
    "yargs": "18.0.0",
    "zod": "3.25.76",
    "zod-openapi": "4.1.0"
  }
}
