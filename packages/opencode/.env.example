# Fork environment variables for packages/opencode
# These override upstream defaults to point at the fork's infrastructure.
# Copy to .env and adjust values.

# API endpoint for share/session operations (used by share.ts)
# Upstream default: https://api.opencode.ai (prod) / https://api.dev.opencode.ai (preview)
OPENCODE_API=https://api.opencode.j9xym.com

# OIDC base URL for GitHub agent auth (used by github.ts)
# Upstream default: https://api.opencode.ai
OIDC_BASE_URL=https://api.opencode.j9xym.com

# Network filter domains (used by network.ts)
# These are the fork's domains that the network filter allows
WEB_DOMAIN=opencode.j9xym.com
API_DOMAIN=api.opencode.j9xym.com
