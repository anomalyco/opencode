# Railway 배포용 Dockerfile - Monorepo-aware 빌드
# Railway 빌드 컨텍스트를 monorepo 루트로 설정해야 합니다.
# railway.json의 rootDirectory를 "/" 또는 비워두고,
# dockerfilePath를 "packages/opencode/Dockerfile.railway"로 설정하세요.
FROM oven/bun:1.3-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy monorepo root config for workspace/catalog resolution
COPY package.json bun.lock bunfig.toml ./
COPY patches ./patches

# Copy workspace packages needed by opencode
COPY packages/util ./packages/util
COPY packages/plugin ./packages/plugin
COPY packages/script ./packages/script
COPY packages/sdk ./packages/sdk
COPY packages/opencode ./packages/opencode

# Install all workspace dependencies
RUN bun install --frozen-lockfile || bun install

# Production stage
FROM oven/bun:1.3-alpine AS runner

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ripgrep git

# Create non-root user for security
RUN addgroup -S opencode && adduser -S opencode -G opencode

# Copy built application from builder
COPY --from=builder /app .

# Set ownership to non-root user
RUN chown -R opencode:opencode /app

# Set environment variables
ENV NODE_ENV=production
ENV PORT=8080

# Switch to non-root user
USER opencode

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT}/global/health || exit 1

# Start the server from packages/opencode
CMD ["bun", "run", "--cwd", "packages/opencode", "--conditions=browser", "src/index.ts", "serve", "--hostname", "0.0.0.0", "--port", "8080"]
