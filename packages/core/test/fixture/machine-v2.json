{
  "to_worker": [
    {
      "type": "start",
      "id": "p1",
      "argv": ["cat"],
      "cwd": "/",
      "env": {},
      "stdin": true
    },
    {
      "type": "start",
      "id": "p2",
      "argv": ["true"],
      "cwd": "/",
      "env": {},
      "stdin": false
    },
    {
      "type": "stdin",
      "id": "p1",
      "req": 1,
      "data": "aGk="
    },
    {
      "type": "stdin",
      "id": "p1",
      "req": 2,
      "data": null
    },
    {
      "type": "attach",
      "id": "p1",
      "from": 1
    }
  ],
  "from_worker": [
    {
      "type": "output",
      "id": "p1",
      "offset": 0,
      "stream": "stdout",
      "data": "aGk="
    },
    {
      "type": "output",
      "id": "p1",
      "offset": 2,
      "stream": "stderr",
      "data": "ZXJy"
    },
    {
      "type": "stdin",
      "id": "p1",
      "req": 1,
      "ok": true
    },
    {
      "type": "stdin",
      "id": "p1",
      "req": 2,
      "ok": false,
      "message": "Broken pipe"
    }
  ]
}
