{
  "openai": {
    "id": "openai",
    "name": "OpenAI",
    "env": ["OPENAI_API_KEY"],
    "models": {
      "gpt-reasoning": {
        "id": "gpt-reasoning",
        "type": "chat",
        "name": "GPT Reasoning",
        "release_date": "2026-01-01",
        "modalities": {
          "input": ["text"],
          "output": ["text"]
        },
        "capabilities": {
          "tools": {
            "supported": true
          },
          "reasoning": {
            "supported": true,
            "toggle": true,
            "effort": ["low", "high"],
            "budget": {
              "min": 1024,
              "max": 64000
            }
          },
          "temperature": true
        },
        "limit": {
          "context": 128000,
          "output": 8192
        },
        "api": {
          "responses": {
            "base_url": "https://api.openai.com/v1",
            "sdk": {
              "aisdk": "@ai-sdk/openai"
            }
          }
        },
        "experimental": {
          "modes": {
            "high": {
              "body": {
                "service_tier": "priority"
              },
              "headers": {
                "x-mode": "high"
              }
            },
            "pro": {
              "body": {
                "reasoning": {
                  "mode": "pro"
                }
              }
            }
          }
        }
      }
    }
  },
