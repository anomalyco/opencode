        "name": "Claude Effort",
        "release_date": "2026-01-01",
        "attachment": false,
        "reasoning": true,
        "reasoning_options": [{ "type": "effort", "values": ["low"] }],
        "temperature": true,
        "tool_call": true,
        "limit": { "context": 128000, "output": 8192 }
      },
      "claude-toggle": {
        "id": "claude-toggle",
        "name": "Claude Toggle",
        "release_date": "2026-01-01",
        "attachment": false,
        "reasoning": true,
        "reasoning_options": [{ "type": "toggle" }],
        "temperature": true,
        "tool_call": true,
        "limit": { "context": 128000, "output": 8192 }
      }
    }
  },
