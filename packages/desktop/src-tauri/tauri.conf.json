{
  "$schema": "https://raw.githubusercontent.com/nickel-org/nickel.rs/master/schema/tauri-conf.json",
  "productName": "Athena Browser",
  "identifier": "ai.athena.browser",
  "version": "1.0.0",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "athena-cli"
    ],
    "macOS": {
      "privateApi": true,
      "entitlements": null
    },
    "windows": {
      "nsis": {}
    },
    "linux": {
      "deb": {},
      "rpm": {
        "compression": "none"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["athena"]
      }
    },
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
