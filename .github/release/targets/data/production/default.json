{
  "name": "opencode-data-production",
  "compatibilityDate": "2026-07-25",
  "compatibilityFlags": ["nodejs_compat"],
  "triggers": [
    { "type": "fetch", "pattern": "opencode.ai/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/en/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/zh/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/zht/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/ko/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/de/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/es/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/fr/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/it/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/da/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/ja/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/pl/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/ru/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/uk/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/ar/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/no/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/br/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/th/data*", "zone": "opencode.ai" },
    { "type": "fetch", "pattern": "opencode.ai/tr/data*", "zone": "opencode.ai" }
  ],
  "observability": { "enabled": true },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "ASSETS": { "type": "assets" },
    "OG_WORKER": { "type": "worker", "worker": "opencode-data-og-production" },
    "STAGE": { "type": "text", "value": "production" },
    "PUBLIC_URL": { "type": "text", "value": "https://opencode.ai/data" },
    "DATA_DATABASE_HOST": { "type": "secret" },
    "DATA_DATABASE_USERNAME": { "type": "secret" },
    "DATA_DATABASE_PASSWORD": { "type": "secret" }
  },
  "manifest": { "type": "partial", "mainModule": "index.mjs", "modules": {} }
}
