{
  "name": "opencode-legacy-dev",
  "compatibilityDate": "2026-07-25",
  "compatibilityFlags": ["nodejs_compat"],
  "domains": ["dev.opncd.ai", "api.dev.opencode.ai"],
  "logpush": true,
  "observability": { "enabled": true },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "GITHUB_APP_ID": { "type": "secret" },
    "GITHUB_APP_PRIVATE_KEY": { "type": "secret" }
  },
  "manifest": {
    "type": "complete",
    "mainModule": "index.js",
    "modules": {
      "index.js": { "type": "esm" },
      "index.js.map": { "type": "sourcemap" }
    }
  }
}
