{
  "name": "opencode-site-dev",
  "compatibilityDate": "2026-07-25",
  "compatibilityFlags": ["nodejs_compat"],
  "assets": {
    "htmlHandling": "drop-trailing-slash",
    "runWorkerFirst": [
      "/docs",
      "/docs/*",
      "!/docs/_build/*",
      "!/docs/assets/*",
      "!/docs/pagefind/*",
      "!/docs/favicon.svg",
      "!/docs/llms.txt",
      "!/docs/sitemap.xml",
      "!/docs/openapi.json",
      "/v1/docs",
      "/v1/docs/*",
      "!/v1/docs/assets/*",
      "!/v1/docs/pagefind/*",
      "!/v1/docs/llms.txt",
      "!/v1/docs/theme.json",
      "/zh/docs",
      "/zh/docs/*",
      "!/zh/docs/pagefind/*",
      "/zht/docs",
      "/zht/docs/*",
      "!/zht/docs/pagefind/*",
      "/ko/docs",
      "/ko/docs/*",
      "!/ko/docs/pagefind/*",
      "/de/docs",
      "/de/docs/*",
      "!/de/docs/pagefind/*",
      "/es/docs",
      "/es/docs/*",
      "!/es/docs/pagefind/*",
      "/fr/docs",
      "/fr/docs/*",
      "!/fr/docs/pagefind/*",
      "/it/docs",
      "/it/docs/*",
      "!/it/docs/pagefind/*",
      "/da/docs",
      "/da/docs/*",
      "!/da/docs/pagefind/*",
      "/ja/docs",
      "/ja/docs/*",
      "!/ja/docs/pagefind/*",
      "/pl/docs",
      "/pl/docs/*",
      "!/pl/docs/pagefind/*",
      "/ru/docs",
      "/ru/docs/*",
      "!/ru/docs/pagefind/*",
      "/uk/docs",
      "/uk/docs/*",
      "!/uk/docs/pagefind/*",
      "/ar/docs",
      "/ar/docs/*",
      "!/ar/docs/pagefind/*",
      "/no/docs",
      "/no/docs/*",
      "!/no/docs/pagefind/*",
      "/br/docs",
      "/br/docs/*",
      "!/br/docs/pagefind/*",
      "/th/docs",
      "/th/docs/*",
      "!/th/docs/pagefind/*",
      "/tr/docs",
      "/tr/docs/*",
      "!/tr/docs/pagefind/*"
    ]
  },
  "domains": ["dev.opencode.ai", "docs.dev.opencode.ai"],
  "triggers": [
    { "type": "fetch", "pattern": "dev.opencode.ai", "zone": "dev.opencode.ai" },
    { "type": "fetch", "pattern": "dev.opencode.ai/*", "zone": "dev.opencode.ai" }
  ],
  "observability": { "enabled": true },
  "workersDev": false,
  "previewUrls": false,
  "env": {
    "ASSETS": { "type": "assets" },
    "STAGE": { "type": "text", "value": "dev" }
  },
  "manifest": { "type": "partial", "mainModule": "index.mjs", "modules": {} }
}
