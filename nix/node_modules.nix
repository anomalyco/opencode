{
  lib,
  stdenvNoCC,
  bun,
  bun2nix,
  rev ? "dirty",
}:
let
  packageJson = lib.pipe ../packages/cli/package.json [
    builtins.readFile
    builtins.fromJSON
  ];
  platform = stdenvNoCC.hostPlatform;
  bunCpu = if platform.isAarch64 then "arm64" else "x64";
  bunOs = if platform.isLinux then "linux" else "darwin";
in
stdenvNoCC.mkDerivation {
  pname = "opencode-node_modules";
  version = "${packageJson.version}+${lib.replaceString "-" "." rev}";

  src = lib.fileset.toSource {
    root = ../.;
    fileset = lib.fileset.intersection (lib.fileset.fromSource (lib.sources.cleanSource ../.)) (
      lib.fileset.unions [
        ../packages
        ../services
        ../bun.lock
        ../package.json
        ../patches
        ../install # required by desktop build (cli.rs include_str!)
        ../.github/TEAM_MEMBERS # required by @opencode/script
        ../script # required by packages/cli build (native-arch)
      ]
    );
  };

  bunDeps = bun2nix.fetchBunDeps {
    bunNix =
      { fetchurl, ... }:
      import ./fetch-bun-sources.nix fetchurl (
        import ./bun-lock.nix {
          os = bunOs;
          cpu = bunCpu;
        } (import ./jsonc.nix (builtins.readFile ../bun.lock))
      );
    # Bun applies patchedDependencies itself, against the original package bytes.
    patchShebangs = false;
  };

  nativeBuildInputs = [ bun ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild
    export BUN_INSTALL_CACHE_DIR=$(mktemp -d)
    # Bun applies patches in its cache, which needs writable package copies.
    cp -RL "$bunDeps/share/bun-cache/." "$BUN_INSTALL_CACHE_DIR/"
    chmod -R u+w "$BUN_INSTALL_CACHE_DIR"
    # Include root dependencies so Bun resolves the same peer contexts as a normal install.
    bun install \
      --cpu="${bunCpu}" \
      --os="${bunOs}" \
      --filter './' \
      --filter './packages/cli' \
      --filter './packages/desktop' \
      --filter './packages/app' \
      --frozen-lockfile \
      --offline \
      --linker=isolated \
      --backend=copyfile \
      --ignore-scripts \
      --no-progress
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    find . -type d -name node_modules -exec cp -R --parents {} $out \;
    runHook postInstall
  '';

  dontFixup = true;

  meta.platforms = [
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-darwin"
  ];
}
