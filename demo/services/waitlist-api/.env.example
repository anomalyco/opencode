# ローカル開発用のサンプル。実値を入れた .env はコミットしないこと。

# 書き込み先の GCP プロジェクト ID
GCP_PROJECT=your-sandbox-project

# Firestore のコレクション名（既定 waitlist）
FIRESTORE_COLLECTION=waitlist

# Firestore データベース ID（既定 (default)）
# FIRESTORE_DATABASE=(default)

# 許可するオリジン（カンマ区切り）。ローカルは LP の dev サーバを指定
ALLOWED_ORIGINS=http://localhost:4321

# ローカルの待受ポート（任意。既定 8080）
PORT=8080

# ローカルから Firestore を叩く場合のアクセストークン（Cloud Run 上では不要）。
# 例: export GOOGLE_ACCESS_TOKEN=$(gcloud auth print-access-token)
GOOGLE_ACCESS_TOKEN=
