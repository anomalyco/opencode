{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/site",
  "private": true,
  "type": "module",
  "license": "MIT",
  "imports": {
    "#resource": {
      "production": "./src/lib/resource.cloudflare.ts",
      "default": "./src/lib/resource.node.ts"
    }
  },
  "scripts": {
    "dev": "bun run generate && bun ./script/build-stamp.ts --dev && bun ./script/og.ts && vite dev --host 0.0.0.0",
    "build": "bun script/build.ts",
    "deploy:dev": "bun script/build.ts --mode dev && cf deploy --prebuilt --mode dev",
    "deploy:production": "bun script/build.ts --mode production && cf deploy --prebuilt --mode production",
    "generate": "cp ../../packages/protocol/openapi.json public/openapi.json && bun ../../packages/schema/script/config-schema.ts public/config.json && cp ../../packages/protocol/openapi.json public/docs/openapi.json && bun --cwd ../../packages/cli script/schema.ts ../../services/site/public/v2/cli.json",
    "typecheck": "bun check --no-script && bun --cwd textjs check --no-script",
    "typecheck:tsc": "tsc --noEmit && tsc --noEmit -p textjs",
    "test": "bun test --only-failures"
  },
  "dependencies": {
    "@ibm/plex": "6.4.1",
    "@kitlangton/rolling-number": "0.4.1",
    "@opencode/nav-menus": "workspace:*",
    "@opencode/ui": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@textjs/app": "1.6.1",
    "@textjs/core": "1.6.1",
    "@textjs/opencode": "1.6.1",
    "@textjs/react": "1.6.1",
    "fuzzysort": "3.1.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "catalog:",
    "three": "0.180.0",
    "uqr": "0.1.3",
    "vite": "8.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/config": "0.23.0",
    "@hona/strobe": "catalog:",
    "@mdx-js/mdx": "3.1.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "catalog:",
    "@types/estree-jsx": "1.0.5",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/three": "0.180.0",
    "@typescript/native": "catalog:",
    "@webgpu/types": "0.1.54",
    "babel-preset-solid": "1.9.15",
    "cf": "1.0.0-beta.12",
    "estree-util-visit": "2.0.0",
    "github-slugger": "2.0.0",
    "hast-util-to-text": "4.0.2",
    "mdast-util-mdx-jsx": "3.2.0",
    "miniflare": "5.20260930.0-alpha",
    "pagefind": "1.5.2",
    "playwright-core": "1.59.1",
    "remark-gfm": "4.0.1",
    "remark-smartypants": "3.0.3",
    "satori": "0.63.2",
    "sharp": "0.34.5",
    "shiki": "catalog:",
    "typescript": "catalog:",
    "unist-util-visit": "5.1.0",
    "vfile": "6.0.3",
    "vite-plugin-solid": "2.11.14",
    "wawoff2": "2.0.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
