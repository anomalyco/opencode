# Cache headers for the static files in public/ (Cloudflare Workers static assets; script/build.ts ships
# .output/public/_headers with the assets). Nitro appends its own /_build/assets/* rule (hashed
# build files, immutable). Rules must not overlap: Cloudflare joins repeated headers with a comma.
#
# Only files whose name changes with their content are immutable. The media below keep their URL
# when re-rendered in place, so browsers and the edge may keep them for a day and serve a stale
# copy for up to a week while they revalidate.

/textjs/chunk-*
  Cache-Control: public, max-age=31536000, immutable
/textjs/lite-*
  Cache-Control: public, max-age=31536000, immutable
/textjs/picker-*
  Cache-Control: public, max-age=31536000, immutable
# Yoga's WebAssembly, named by a hash of its bytes (textjs/script/build.ts).
/textjs/yoga-*
  Cache-Control: public, max-age=31536000, immutable
# The V2 docs' stylesheet, script and fonts, named by a hash of their contents (src/docs/script/build.ts).
/docs/_build/*
  Cache-Control: public, max-age=31536000, immutable
# Link preview cards, named by a hash of the PNG (script/og.ts).
/og/*
  Cache-Control: public, max-age=31536000, immutable
# The optimised video and still copies, named by a hash of the file (media.tsx).
/media/*
  Cache-Control: public, max-age=31536000, immutable

/product-videos/*
