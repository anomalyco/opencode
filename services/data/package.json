    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/config": "0.23.0",
    "@opencode/stats-app": "workspace:*",
    "@opencode/stats-server": "workspace:*",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "cf": "1.0.0-beta.12",
    "typescript": "catalog:"
  }
}
