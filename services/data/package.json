{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/data",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "bun script/build.ts",
    "deploy:dev": "bun script/deploy.ts --mode dev",
