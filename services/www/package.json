{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/www",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate && astro dev --host --port 3000",
    "dev:site": "bun run --cwd site dev",
    "build": "bun script/build.ts",
    "deploy:dev": "bun script/build.ts --mode dev && cf deploy --prebuilt --mode dev",
    "deploy:production": "bun script/build.ts --mode production && cf deploy --prebuilt --mode production",
    "generate": "bun script/generate-openapi.ts && bun --cwd ../../packages/cli script/schema.ts ../../services/www/public/cli.json",
    "validate": "bun script/validate-links.ts",
    "test": "bun --cwd site test",
    "typecheck": "astro check && bun --cwd site check --no-script",
    "typecheck:tsc": "astro check && bun --cwd site x tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@ibm/plex": "6.4.1",
    "@kitlangton/rolling-number": "0.4.1",
    "@opencode/ui": "workspace:*",
    "@solidjs/meta": "catalog:",
    "@solidjs/router": "catalog:",
    "@solidjs/start": "catalog:",
    "@textjs/app": "1.5.0",
    "@textjs/core": "1.5.0",
    "@textjs/opencode": "1.5.0",
    "@textjs/react": "1.5.0",
    "astro": "catalog:",
    "fuzzysort": "3.1.0",
    "nitro": "3.0.260903-beta",
    "number-flow": "0.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "solid-js": "catalog:",
    "three": "0.180.0",
    "uqr": "0.1.3",
    "vite": "8.2.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/markdown-remark": "7.3.2",
    "@cloudflare/build-output-utils": "0.8.5",
    "@cloudflare/config": "0.23.0",
    "@types/bun": "catalog:",
    "@types/react": "19.3.0",
    "@types/three": "0.180.0",
    "@typescript/native": "catalog:",
    "@webgpu/types": "0.1.54",
    "cf": "1.0.0-beta.12",
    "pagefind": "1.5.2",
    "playwright-core": "1.59.1",
    "satori": "0.63.2",
    "sharp": "0.34.5",
    "typescript": "catalog:",
    "wawoff2": "2.0.1"
  },
  "engines": {
    "node": ">=22.12"
  }
}
