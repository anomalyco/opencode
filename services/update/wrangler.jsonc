{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opencode-update",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-21",
  "workers_dev": false,
  "preview_urls": false,
  "pipelines": [
    {
      "binding": "EVENTS",
      // Shared lake stream from anomalyco/platform/production.
      "stream": "251a89241c3a461c9007f6b6f345ed8b",
    },
  ],
  "routes": [
    {
      "pattern": "opencode.ai/update",
      "zone_name": "opencode.ai",
    },
    {
      "pattern": "opencode.ai/update/*",
      "zone_name": "opencode.ai",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-update",
      "database_id": "2c010a96-811f-43d5-804d-7188534e5858",
      "migrations_dir": "migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "MANIFESTS",
      // Replace with the namespace id from `wrangler kv namespace create MANIFESTS` before deploying.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID",
    },
  ],
  "vars": {
    // Two-deploy rollout: start on "d1" (dual-write D1+KV, read D1), backfill & verify, then flip to "kv".
    "MANIFEST_READS": "d1",
  },
  "observability": {
    "enabled": true,
  },
}
