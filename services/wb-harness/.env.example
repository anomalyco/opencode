# Copy to .env and fill in, or let `bun run creds` write
# ~/.config/wb-harness/credentials.json (used when these are empty).
PORT=3001
HOSTNAME=127.0.0.1

# Optional: explicit credentials. Leave empty to use the extracted credentials file.
WB_TOKEN=
WB_USERDATA=

# Optional
WB_CREDS_FILE=~/.config/wb-harness/credentials.json
WB_UPSTREAM=https://ai-proxy.wildberries.ru/ai-proxy/api/chat/v5/message
WB_ENRICH=true
WB_TOOL_TIMEOUT_MS=4000
WB_SESSION_REUSE=true
