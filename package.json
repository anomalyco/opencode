{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opendeepseek",
  "version": "1.0.181",
  "description": "AI-powered development tool",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "npx tsx --cwd packages/opendeepseek --conditions=browser src/index.ts",
    "typecheck": "turbo run typecheck",
    "prepare": "husky",
    "random": "echo 'Random script'",
    "hello": "echo 'Hello World!'"
  },
  "workspaces": [
    "packages/*",
    "packages/console/*",
    "packages/sdk/*",
    "packages/slack",
    "sdks/*"
  ],
  "devDependencies": {
    "@tsconfig/node20": "1.0.1",
    "husky": "9.1.7",
    "prettier": "3.6.2",
    "sst": "3.17.23",
    "turbo": "2.5.6",
    "tsx": "4.19.2",
    "esbuild": "0.25.3",
    "ts-node": "10.9.2",
    "@types/node": "22.13.9",
    "execa": "7.1.1",
    "toml": "3.0.0",
    "fast-glob": "3.2.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.933.0",
    "@opendeepseek/script": "1.0.181",
    "@opendeepseek/sdk": "1.0.181",
    "typescript": "5.8.2",
    "@standard-community/standard-json": "0.3.5",
    "@standard-community/standard-openapi": "0.2.9",
    "quansync": "1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sst/opencode"
  },
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "sharp",
    "tree-sitter",
    "tree-sitter-bash",
    "web-tree-sitter"
  ],
  "overrides": {
    "@types/node": "22.13.9"
  },
  "patchedDependencies": {
    "ghostty-web@0.3.0": "patches/ghostty-web@0.3.0.patch"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
