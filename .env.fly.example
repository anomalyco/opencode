# ═══════════════════════════════════════════════════════════════
# Fly.io Environment Variables for Claxedo
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# BUILD-TIME VARIABLES (pass as --build-arg during deploy)
# These are baked into the frontend bundle at build time
# ───────────────────────────────────────────────────────────────

# Clerk public key for frontend auth UI
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# Convex URLs for frontend database/realtime
VITE_CONVEX_URL=https://xxx.convex.cloud
VITE_CONVEX_SITE_URL=https://xxx.convex.site

# ───────────────────────────────────────────────────────────────
# RUNTIME SECRETS (set via: fly secrets set KEY=value)
# These are read by the backend server at runtime
# ───────────────────────────────────────────────────────────────

# Convex - Backend database connection (same URL as VITE_CONVEX_URL)
CONVEX_URL=https://xxx.convex.cloud

# Clerk - JWT verification (secret key, NOT publishable key)
CLERK_SECRET_KEY=sk_live_xxx

# Daytona - Sandbox provider
DAYTONA_API_KEY=dtn_xxx
DAYTONA_API_URL=https://api.daytona.io
# DAYTONA_TARGET=us  # Optional: regional target

# Encryption - For storing user API credentials (exactly 32 chars)
# Generate with: openssl rand -base64 24
ENCRYPTION_KEY=your-32-character-encryption-key

# ───────────────────────────────────────────────────────────────
# DEPLOYMENT COMMANDS
# ───────────────────────────────────────────────────────────────
#
# Set runtime secrets:
#   fly secrets set \
#     CONVEX_URL="https://xxx.convex.cloud" \
#     CLERK_SECRET_KEY="sk_live_xxx" \
#     DAYTONA_API_KEY="dtn_xxx" \
#     DAYTONA_API_URL="https://api.daytona.io" \
#     ENCRYPTION_KEY="your-32-char-encryption-key"
#
# Deploy with build args:
#   fly deploy \
#     --build-arg VITE_CLERK_PUBLISHABLE_KEY="pk_live_xxx" \
#     --build-arg VITE_CONVEX_URL="https://xxx.convex.cloud" \
#     --build-arg VITE_CONVEX_SITE_URL="https://xxx.convex.site"
