{
  "enabled_providers": [
    "enterprise-llm"
  ],
  "provider": {
    "enterprise-llm": {
      "name": "Enterprise Intranet LLM Service",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "your-model-name": {
          "name": "Primary coding model",
          "temperature": true,
          "tool_call": true,
          "limit": {
            "output": 128000,
            "context": 200000
          },
          "reasoning": true,
          "attachment": true
        }
      },
      "options": {
        "baseURL": "http://YOUR_LLM_SERVER:8080/v1",
        "timeout": 300000,
        "apiKey": "{env:ENTERPRISE_API_KEY}"
      }
    }
  },
  "share": "disabled",
  "subagent_depth": 2,
  "model": "enterprise-llm/your-model-name",
  "autoupdate": false,
  "plugin": [
    ["./plugins/opencode-workflows", {
      "maxConcurrency": 4,
      "agentTimeout": 86400000,
      "storageRoot": ".opencode/workflows"
    }]
  ],
  "$schema": "https://opencode.ai/config.json"
}