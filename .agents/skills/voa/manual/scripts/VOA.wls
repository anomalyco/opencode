(* ::Input::Initialization:: *)
Clear[MakeVertexField]
MakeVertexField[exp_][z_]:=exp/.{NO[o___]:>NO[o][z],o_:>o[z]/;IsBosonicField[o[z]]||IsFermionicField[o[z]]}


(* ::Input::Initialization:: *)
Clear[OPEFull]
OPEFull[o1_+o2_,o3_][z_,w_][n_]:=OPEFull[o1,o3][z,w][n]+OPEFull[o2,o3][z,w][n];
OPEFull[o1_,o2_+o3_][z_,w_][n_]:=OPEFull[o1,o2][z,w][n]+OPEFull[o1,o3][z,w][n];
OPEFull[o1_,o2_][z_,w_][n_]:=Module[{ExtractVertexOps,V1,V2,LeadingTerm,LeadingPower,
freeOPE,leadingPowerOfFreeOPE,leadingPowerOfVertexOPE,vertexOPE,vertexFullOPE,ztemp},
ExtractVertexOps[o_]:=MakeField[o][ztemp]/.{f_[ztemp]:>1};
V1=ExtractVertexOps[o1];
V2=ExtractVertexOps[o2];
V1=V1/.ExtractVertexOps->Identity;
V2=V2/.ExtractVertexOps->Identity;
LeadingTerm[ope_,z]:=Normal[ope/.z->(z+O[z]^2)];
LeadingPower[ope_]:=z D[Log[LeadingTerm[ope,z]],z];
freeOPE=OPEFree[o1/V1,o2/V2][z,w][n];
vertexOPE=OPE[V1,V2]//OPEToSeries;
leadingPowerOfFreeOPE=LeadingPower[freeOPE/.{w->0}]//Simplify;
leadingPowerOfVertexOPE=LeadingPower[vertexOPE/.{w->0}]//Simplify;

vertexFullOPE=(OPE[V1,V2]//OPEToSeries//Normal)+Sum[(z-w)^nn/Factorial[nn] (NO[Derivative[nn][V1],V2]//MakeVertexField[#][w]&),{nn,0,-leadingPowerOfFreeOPE}];

OPEFree[o1/V1,o2/V2][z,w][-leadingPowerOfVertexOPE]*vertexFullOPE//Series[#,{z,w,n}]&
];


(* ::Input::Initialization:: *)
Clear[ListLettersAtWeight,ListOpsAtPartition,ListOpsAtWeight]
LettersAtWeight[0]={};
(* \:5217\:4e3e\:6240\:6709 weight = n \:7684 letters *)
(* e.g., \:5982\:679c T\[Element]generators \:662f\:4e00\:4e2a\:62bd\:8c61\:751f\:6210\:5143 h[T] = 2 \:7684\:8bdd\:ff0c
\:90a3\:4e48 LettersAtWeight[4] \:5c31\:4f1a\:5305\:542b T^\[Prime], NO[T,T] *)

ListLettersAtWeight[n_,generators_:generators]:=Table[If[IntegerQ[n-h[g]]&&n>=h[g],Derivative[n-h[g]][g],{}],{g,generators}]//Flatten
(* for partition {n1,n2, ...}, return operators of the form NO[Subscript[O, h=n1],Subscript[O, h=n2], ...] *)
(* OPEPosition[g\[Element]generators] should return Integer *)
ListOpsAtPartition[partition_List,generators_:generators]:=Outer[$NO,Sequence@@Table[LettersAtWeight[part],{part,partition}]]/.$NO[l__]:>$NO@@SortBy[List[l],OPEPosition]/.$NO->NO//Flatten//DeleteDuplicates//DeleteCases[#,0]&;

(* return a list of operators at conformal weight n built from GLOBAL generators *)
Clear[ListOpsAtWeight]
ListOpsAtWeight[n_:(_Rational|_Integer),generators_:generators]:=Table[ListOpsAtPartition[partition],{partition,1/2 IntegerPartitions[2n]}]//Flatten


(* ::Input::Initialization:: *)
Clear[CheckStrongClosure]
(*\:68c0\:67e5 realized \:751f\:6210\:5143\:4e4b\:95f4\:7684 OPE \:5c01\:95ed\:ff1b\:5982\:679c\:5c01\:95ed\:ff0c\:5e94\:8be5\:8f93\:51fa\:5168\:662f {{i,j,k},0}*)
(*\:8f93\:51fa\:4e2d\:7684 OPEresult \:5305\:542b\:4e86\:6240\:6709\:7684 OPEData*)
CheckStrongClosure[generators_,realization_,printResult_:False]:=Module[{i,j,n,aaa,candidates,result,diff,eq,closure,sols,sol,OPEresult},closure=True;
(*\:9010\:4e00\:5217\:4e3e \:7b97\:7b26\:5bf9\:ff1b\:7531\:4e8e OPEdefs.m \:7684\:8bbe\:8ba1\:ff0c\:5148\:58f0\:660e\:7684\:7b97\:7b26\:5e94\:8be5\:653e\:5de6\:8fb9*)(*\:6211\:4eec\:5047\:8bbe \:5168\:5c40\:53d8\:91cf generators \:91cc\:9762\:7684\:7b97\:7b26\:6392\:5e8f\:8ddf\:58f0\:660e\:987a\:5e8f\:76f8\:7b26*)For[i=1,i<Length[generators]+1,i++,For[j=i+1,j<Length[generators]+1,j++,(*n \:6807\:8bb0 n \:9636\:6781\:70b9*)For[n=1,n<=h[generators[[i]]]+h[generators[[j]]],n++,(*\:80fd\:591f\:7528\:4e8e\:7ed9\:51fa\:6781\:70b9\:7684\:7b97\:7b26 (\:5177\:6709\:76f8\:540c conformal weight)*)candidates=ListOpsAtWeight[h[generators[[i]]]+h[generators[[j]]]-n];
(*\:8ba1\:7b97\:6781\:70b9\:8ddf candidates \:7ebf\:6027\:7ec4\:5408\:7684\:5dee\:503c*)diff=OPEPole[n][OPE[generators[[i]]/. realization,generators[[j]]/. realization]]-Array[aaa,Length[candidates]] . candidates;
(*\:7ebf\:6027\:7ec4\:5408\:4e2d\:4ee3\:5165 realization\:ff0c\:5e76\:6309\:7167 NO \:7ed3\:6784\:5408\:5e76\:540c\:7c7b\:9879*)diff=diff/. realization//.{NO[x_]:>x,NO[]->One}//Collect[#,{NO[___],One}]&;
(*NO \:524d\:7684\:7cfb\:6570 \:5e94\:5f53==0\:ff0c\:6c42\:89e3\:7ebf\:6027\:65b9\:7a0b\:7ec4*)eq=If[TrueQ[Head[diff]==Plus],(List@@diff)/. {One->1,NO[___]:>1},diff/. {One->1,NO[___]:>1}];
sols=Solve[eq==0];
If[Length[sols]==0,closure=False];
sol=sols[[1]];
(*\:9a8c\:8bc1\:7ebf\:6027\:7ec4\:5408\:7684\:89e3\:662f\:5426\:7b26\:5408\:8981\:6c42\:ff1adiff \:5e94\:5f53==0*)diff=OPEPole[n][OPE[generators[[i]]/. realization,generators[[j]]/. realization]]-Array[aaa,Length[candidates]] . candidates/. sol/. realization/. {NO[x_]:>x,NO[]->One}//Expand;
(*\:6536\:96c6\:89e3\:4fe1\:606f\:65b9\:4fbf\:4ee5\:540e\:4f7f\:7528*)result[i,j,n]={{i,j,n},Array[aaa,Length[candidates]] . candidates/. sol/. aaa[_]:>0}];
(*\:8bb0\:5f97\:8981 Reverse\:ff0cOPEData \:5de6\:8fb9\:662f\:9ad8\:9636\:6781\:70b9\:ff0c\:53f3\:8fb9\:662f\:4f4e\:9636\:6781\:70b9*)OPEresult[i,j]=OPEData[Table[result[i,j,n][[2]],{n,h[generators[[i]]]+h[generators[[j]]]}]//Reverse];
If[printResult,Print[OPEresult[i,j]]]]];
{closure,OPEresult}]


(* ::Input::Initialization:: *)
(* produce relations among ops *)
Clear[ListRelations]
ListRelations[ops_List]:=Module[{$a,linearCombination,sol},
ops=ListOpsAtWeight[3]//OPESimplify;
linearCombination=Array[$a,Length[ops]] . ops;

linearCombination//Expand//Collect[#,
Join[{NO[_,_]},Table[Derivative[k_][g],{g,generators}],generators,
Table[Derivative[k_][g],{g,If[Head[freefields]==List,freefields,{}]}],
If[Head[freefields]==List,freefields,{}]]]&;
sol=((List@@%)/.{NO[x_,y_]:>1,
Derivative[n_][x_]:>1/;MemberQ[Union[If[Head[freefields]==List,freefields,{}],generators],x],
x_:>1/;MemberQ[Union[If[Head[freefields]==List,freefields,{}],generators],x]})==0//Solve[#,Array[$a,Length[ops]]]&;
sol
];

ListRelations[ops_List,realization_]:=Module[{$a,linearCombination,linearCombinationRealized,sol},

linearCombination=Array[$a,Length[ops]] . ops;

linearCombinationRealized=linearCombination//.realization//Expand//Collect[#,
Join[{NO[_,_]},
Table[Derivative[k_][g],{g,generators}],
generators,
Table[Derivative[k_][g],{g,freefields}],freefields]]&;
sol=((List@@linearCombinationRealized)/.{NO[x_,y_]:>1,
Derivative[n_][x_]:>1/;MemberQ[Union[freefields,generators],x],
x_:>1/;MemberQ[Union[freefields,generators],x]})==0//Solve[#,Array[$a,Length[ops]]]&;

List@@(linearCombination/.If[Length[sol]>0,sol[[1]],{}]//Collect[#,$a[_]]&)/.$a[_]:>1
]


(* ::Input::Initialization:: *)
Clear[Bracket,Completion]
(* Subscript[{O1O2}, -n]=1/n!(\[PartialD]^nO1 O2)*)
Bracket[O1_,O2_][n_/;n<0]:=1/Abs[n]! NO[Derivative[Abs[n]][O1],O2]
Bracket[O1_,O2_][0]:=NO[O1,O2]
Bracket[O1_,O2_][n_/;n>0]:=OPEPole[n][O1,O2]
Completion[O1_,O2_][m_]:=Sum[
If[Pochhammer[2h[O1]+2h[O2]-2m-n-1,n]!=0,
((-1)^n Pochhammer[2h[O1]-n-m,n])/(n! Pochhammer[2h[O1]+2h[O2]-2m-n-1,n]),0]Derivative[n][Bracket[O1,O2][m+n]],
{n,0,2h[O1]-m}]


(* ::Input::Initialization:: *)
Clear[o,str];

str[x_Plus]:=Sum[str[(List@@x)[[i]]],{i,Length[List@@x]}]/; Length[List@@x]>1;
str[\[Lambda]_ NO[x_,y_]]:=\[Lambda] str[NO[x,y]]
str[\[Lambda]_ exp_Plus]:=str[\[Lambda] exp//Expand]
str[\[Lambda]_?NumericQ x_]:=\[Lambda] str[x//Expand]
(*str[o[T]]=MMDO[1,cch];
str[o[J0]]=DDbi[1][1,cch];*)

str[0]:=0;
str[\[Lambda]_?NumericQ One]:=\[Lambda] cch;
str[\[Lambda]_?NumericQ]:=\[Lambda] cch;

o[x_Plus]:=Sum[o[(List@@x)[[i]]],{i,Length[List@@x]}]/; Length[List@@x]>1;
o[\[Lambda]_ NO[x_,y_]]:=\[Lambda] o[NO[x,y]]
o[\[Lambda]_ exp_Plus]:=o[\[Lambda] exp//Expand]
o[\[Lambda]_?NumericQ x_]:=\[Lambda] o[x//Expand]
o[0]:=0;
o[\[Lambda]_?NumericQ One]:=\[Lambda];

Unprotect[NonCommutativeMultiply];
(* \:5bf9 \[DoubleStruckCapitalC] \:7ebf\:6027 *)
NonCommutativeMultiply[x_,y_Plus]:=Sum[NonCommutativeMultiply[x,y[[i]]],{i,Length[y]}]
NonCommutativeMultiply[x_Plus,y_]:=Sum[NonCommutativeMultiply[x[[i]],y],{i,Length[x]}]
NonCommutativeMultiply[\[Lambda]_?NumericQ x_,y_]:=\[Lambda] NonCommutativeMultiply[x,y]
NonCommutativeMultiply[x_,\[Lambda]_?NumericQ y_]:=\[Lambda] NonCommutativeMultiply[x,y]
NonCommutativeMultiply[0,y_]:=0
NonCommutativeMultiply[x_,0]:=0

NonCommutativeMultiply[x_,\[Lambda]_ y_Plus]:=NonCommutativeMultiply[x,\[Lambda] y//Expand]
NonCommutativeMultiply[\[Lambda]_ x_Plus,y_]:=NonCommutativeMultiply[\[Lambda] x//Expand,y]

Protect[NonCommutativeMultiply];


Clear[ZhuRecursion]


ZhuRecursion[f_]:=Module[{zhusRecursion,EisensteinIdentities,result},
Clear[qDq];
qDq[exp_Plus]:=Sum[qDq[exp[[i]]//Expand],{i,Length[exp]}];
qDq[\[Lambda]_?NumericQ exp_]:=\[Lambda] qDq[exp//Expand];
qDq[exp1_ exp2_]:=qDq[exp1//Expand]exp2+qDq[exp2]exp1;
qDq[exp_^n_]:=n exp^(n-1) qDq[exp];
(*qDq[DDbi[i_][n_,exp_]]:=DDbi[i][n,qDq[exp]]*)
qDq[0]:=0;
(*qDq[qDq[n_,exp_]]:=qDq[n+1,exp];
qDq[f_[q]]:=qDq[1,f[q]];
qDq[cch]=qDq[1,cch];*)

Clear[DDbi];
DDbi[i_][n_,exp_Plus]:=Sum[DDbi[i][n,exp[[$i]]//Expand],{$i,Length[exp]}];
DDbi[i_][n_,\[Lambda]_?NumericQ exp_]:=\[Lambda] DDbi[i][n,exp//Expand];
DDbi[i_][1,exp1_ exp2_]:=DDbi[i][1,exp1//Expand]exp2+DDbi[i][1,exp2//Expand]exp1;
DDbi[i_][1,exp_^n_]:=n exp^(n-1) DDbi[i][1,exp//Expand];

(*DDbi[i_][m_,DDbi[i_][n_,exp_]]:=DDbi[i][m+n,exp]*)
DDbi[i_][n_,0]=0;

(* (\!\(q
\*SubscriptBox[\(\[PartialD]\), \(q\)]\))^nf[q] = Sum[Subscript[B, n,m]Subsuperscript[D, q, (m)]f[q],{m,1,n}] *)
Clear[Bcoeff];
Bcoeff[1,1]=1;
Bcoeff[n_/;n>=1,m_/;m>=1]:=Bcoeff[n-1,m-1]+q D[Bcoeff[n-1,m],q]-2m EEi[2][q]Bcoeff[n-1,m];
Bcoeff[n_,m_]:=0/;m<=0||m>n;

zhusRecursion={
(* \:5148\:5339\:914d\:5e26\:5bfc\:6570\:7684 *)
(* o(Subscript[a, -Subscript[h, a]-n]b) *)
str[o[NO[Derivative[n_][A_],B_]]]:>n! (-1)^n Sum[Binomial[k-1,n]EEE[k][{
 {E^(2\[Pi] I h[A])},
 {b^Q[A]}
}][q]str[o[Bracket[A,B][k-n]]],{k,n+1,h[A]+h[B]+n}],

(* o(Subscript[a, -Subscript[h, a]-n]1) *)
str[o[Derivative[n_][A_]]]:>n! (-1)^n Sum[Binomial[k-1,n]EEE[k][{
 {E^(2\[Pi] I h[A])},
 {b^Q[A]}
}][q]str[o[Bracket[A,One][k-n]]],{k,n+1,h[A]+n}],

(* \:7136\:540e\:5339\:914d\:4e0d\:5e26\:5bfc\:6570\:7684 *)
(* o(Subscript[a, -Subscript[h, a]]b) *)
str[o[NO[A_,B_]]]:>KroneckerDelta[Q[A],0]str[o[A]**o[B]]+Sum[EEE[k][{
 {E^(2\[Pi] I h[A])},
 {1}
}][q]str[o[Bracket[A,B][k]]],{k,2,h[A]+h[B]}]/;Q[A]==0,
str[o[NO[A_,B_]]]:>KroneckerDelta[Q[A],0]str[o[A]**o[B]]+Sum[EEE[k][{
 {E^(2\[Pi] I h[A])},
 {b^Q[A]}
}][q]str[o[Bracket[A,B][k]]],{k,1,h[A]+h[B]}],

str[o[T]**o[op___]]:>qDq[str[o[op]]//Expand],
str[o[J]**o[op___]]:>DDbi[1][1,str[o[op]]//Expand],

str[o[T]]->qDq[cch],
str[o[J]]->DDbi[1][1,cch],
str[o[One]]->cch


};
EisensteinIdentities={
(* Subscript[D, b]Subscript[E, k][\[Alpha]
\[Beta]

][q] ~ Eisenstein \:591a\:9879\:5f0f *)
DDbi[i_][n_,EEi[$n_][q]^k_.]:>0,
DDbi[1][1,EEE[n_?OddQ][{
 {-1},
 {b[1]^$n_.}
}][q]]:>-$n((n+1)EEE[n+1][{
 {-1},
 {b[1]^$n}
}][q]+EEi[n+1][q]+EEE[1][{
 {-1},
 {b[1]^$n}
}][q]EEE[n][{
 {-1},
 {b[1]^$n}
}][q]-Sum[EEi[k][q]EEE[n+1-k][{
 {-1},
 {b[1]^$n}
}][q],{k,2,n-1,2}]),
DDbi[1][1,EEE[n_?EvenQ][{
 {-1},
 {b[1]^$n_.}
}][q]]:>-$n((n+1) EEE[n+1][{
 {-1},
 {b[1]^$n}
}][q]-EEE[1][{
 {-1},
 {b[1]^$n}
}][q] EEi[n][q]+EEE[1][{
 {-1},
 {b[1]^$n}
}][q] EEE[n][{
 {-1},
 {b[1]^$n}
}][q]-Sum[EEi[k][q] EEE[n+1-k][{
 {-1},
 {b[1]^$n}
}][q],{k,2,n-1,2}]),
DDbi[1][1,EEE[n_?OddQ][{
 {1},
 {b[1]^$n_}
}][q]]:>-$n((n+1)EEE[n+1][{
 {1},
 {b[1]^$n}
}][q]
+EEi[n+1][q]+EEE[1][{
 {1},
 {b[1]^$n}
}][q]EEE[n][{
 {1},
 {b[1]^$n}
}][q]-Sum[EEi[k][q]EEE[n+1-k][{
 {1},
 {b[1]^$n}
}][q],{k,2,n-1,2}]),
DDbi[1][1,EEE[n_?EvenQ][{
 {1},
 {b[1]^$n_}
}][q]]:>-$n((n+1)EEE[n+1][{
 {1},
 {b[1]^$n}
}][q]
-EEE[1][{
 {1},
 {b[1]^$n}
}][q]EEi[n][q]+EEE[1][{
 {1},
 {b[1]^$n}
}][q]EEE[n][{
 {1},
 {b[1]^$n}
}][q]-Sum[EEi[k][q]EEE[n+1-k][{
 {1},
 {b[1]^$n}
}][q],{k,2,n-1,2}]),

(* decompose higher order Subsuperscript[D, bi, n] on Subscript[E, k] *)
DDbi[1][n_/;n>1,EEE[n_][{
 {pm_},
 {b_}
}][q]]:>DDbi[1][n-1,DDbi[1][1,EEE[n][{
 {pm},
 {b}
}][q]]],
(*DDbi[i_][m_,DDbi[i_][n_,exp_/;!TrueQ[Head[exp]==EEE]]]\[RuleDelayed]DDbi[i][m+n,exp]//Expand,*)

(* \!\(
\*SubsuperscriptBox[\(D\), \(q\), \(1\)]\(\(
\(\*SubscriptBox[\(E\), \(k\)]\)[\*GridBox[{
{\[Phi]},
{\[Theta]}
}]]\)[q]\ ~\ Eisenstein\)\ \:591a\:9879\:5f0f\) *)
qDq[EEi[2][q]]->5 EEi[4][q]+(-1) EEi[2][q]^2,
qDq[EEi[4][q]]->14 EEi[6][q]-4 EEi[2][q]EEi[4][q],
qDq[EEi[6][q]]->60/7 EEi[4][q]^2-6 EEi[2][q]EEi[6][q],
qDq[EEE[k_][{
 {pm_},
 {b[1]^$n_.}
}][q]]:>-(k/$n) DDbi[1][1,EEE[k+1][{
 {pm},
 {b[1]^$n}
}][q]],
(* q\!\(
\*SubscriptBox[\(\[PartialD]\), \(q\)]
\*SubsuperscriptBox[\(D\), \(q\), \((n)\)]\) = (q\!\(
\*SubscriptBox[\(\[PartialD]\), \(q\)]\(+2\)\)Subscript[nE, 2])Subsuperscript[D, q, (n)]-2Subscript[nE, 2]Subsuperscript[D, q, (n)] *)
qDq[MMDO[n_,cch]]:>MMDO[n+1,cch]-2n EEi[2][q]MMDO[n,cch],
qDq[cch]->MMDO[1,cch],
qDq[DDbi[i_][n_,exp_]]:>DDbi[i][n,qDq[exp]]

};

result=f//.zhusRecursion;
result=result/.{
b^Q_?NumericQ:>b[1]^Q,
b^Q_List:>Product[b[$i]^Q[[$i]],{$i,Length[Q]}],
EEE[k_][{
 {pm_},
 {b}
}][q]:>EEE[k][{
 {pm},
 {b[1]}
}][q]
}/.{
EEE[k_?EvenQ][{
 {1},
 {1}
}][q]:>EEi[k][q],
EEE[k_/;OddQ[k]&&k>1][{
 {pm_},
 {1}
}][q]:>0,
Derivative[n_][EEE[k_/;OddQ[k]&&k>1][{
 {pm_},
 {1}
}]][q]:>0,
EEE[k_][{
 {pm_},
 {b[1]^(\[Lambda]_/;\[Lambda]<0)}
}][q]:>(-1)^k EEE[k][{
 {pm},
 {b[1]^-\[Lambda]}
}][q]};
result=result//.EisensteinIdentities;
result=result/.DDbi[i_][m_,DDbi[i_][n_,exp_/;!TrueQ[Head[exp]==EEE]]]:>DDbi[i][m+n,exp]//Expand;

Clear[DDbi,MMDO];
result
];



