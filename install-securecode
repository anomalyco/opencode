#!/usr/bin/env bash
# Acompany SecureCode one-shot installer.
#
# The script downloads platform archives from the public-facing distribution
# repo `acompany-develop/securecode-release`. Releases are dual-published from
# `acompany-develop/securecode` so both repos always carry the same assets.
#
# Three invocation modes:
#
# 1. Public curl (works once securecode-release is flipped public; recommended
#    long-term entry point — no GitHub auth required):
#      curl -fsSL https://github.com/acompany-develop/securecode-release/releases/latest/download/install | bash
#
# 2. Engineers with `gh auth login` set up (works while securecode-release is
#    still private — gh CLI transparently handles auth + asset download):
#      gh release download -R acompany-develop/securecode-release --pattern install -O - | bash
#
# 3. Offline / non-engineer flow (e.g. archive distributed via Notion):
#    Drop `install` and the platform archive (e.g. `securecode-darwin-arm64.zip`)
#    in the same directory and run:
#      bash install
#    The script auto-detects an archive matching the current platform that
#    sits next to it on disk, skips network fetch, and installs from that
#    local file.
#
# When the repository is private, network mode transparently uses the `gh` CLI
# (must be authenticated via `gh auth login`) for both metadata lookup and
# archive download. If `gh` is unavailable or unauthenticated, it falls back to
# bare curl, which only works for public repositories.
#
# Refs https://github.com/acompany-develop/securecode/issues/82 and #159.
set -euo pipefail

APP=securecode
ARCHIVE_PREFIX=securecode
GH_REPO=acompany-develop/securecode-release

# Resolve the directory containing this script when invoked via a file (e.g.
# `bash install`, `./install`). When piped from curl, BASH_SOURCE[0] is not a
# real path; script_dir stays empty so the local-archive lookup below will
# always miss and we fall through to the network path.
script_dir=""
if [ -n "${BASH_SOURCE[0]:-}" ] && [ -f "${BASH_SOURCE[0]}" ]; then
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi

# Hold the download-path scratch directory at script scope so the EXIT trap
# below can read it after main() returns. A `local tmp` inside main() goes out
# of scope before the trap fires, which trips `set -u` with "tmp: unbound
# variable" and skips the rm. Default to empty so the trap is a no-op when
# main() takes the --binary path that does not allocate a tmp dir (refs #136).
tmp=""
trap 'rm -rf "${tmp:-}"' EXIT

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m'

usage() {
  cat <<EOF
Acompany SecureCode installer

Usage: install [options]

Options:
  -h, --help              Show this help message
  -v, --version <ver>     Install a specific version (e.g. 0.1.0). Defaults to latest.
  -b, --binary <path>     Install from a local SecureCode binary instead of downloading.
  -a, --archive <path>    Install from a local platform archive (.zip / .tar.gz).
      --install-dir <dir> Override install dir (default \$HOME/.local/bin).
      --no-modify-path    Don't append PATH entries to shell rc files.
      --no-config         Skip running the bundled setup/install.sh (plugin/config seed).

Examples:
  # Public curl (once securecode-release is flipped public; preferred long-term)
  curl -fsSL https://github.com/${GH_REPO}/releases/latest/download/install | bash

  # gh CLI (engineers; works while securecode-release is still private)
  gh release download -R ${GH_REPO} --pattern install -O - | bash
  gh release download -R ${GH_REPO} --pattern install -O - | bash -s -- --version 0.1.0

  # Offline / Notion flow: drop \`install\` and \`securecode-<target>.{zip,tar.gz}\`
  # in the same directory and run:
  bash install

  # Explicit local archive
  ./install --archive ./securecode-darwin-arm64.zip

  # Local already-extracted binary
  ./install --binary /path/to/securecode
EOF
}

requested_version=${VERSION:-}
binary_path=""
archive_path=""
install_dir="${SECURECODE_INSTALL_DIR:-$HOME/.local/bin}"
no_modify_path=false
no_config=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version)
      if [[ -n "${2:-}" ]]; then requested_version="$2"; shift 2
      else echo -e "${RED}Error: --version requires an argument${NC}" >&2; exit 1
      fi ;;
    -b|--binary)
      if [[ -n "${2:-}" ]]; then binary_path="$2"; shift 2
      else echo -e "${RED}Error: --binary requires a path${NC}" >&2; exit 1
      fi ;;
    -a|--archive)
      if [[ -n "${2:-}" ]]; then archive_path="$2"; shift 2
      else echo -e "${RED}Error: --archive requires a path${NC}" >&2; exit 1
      fi ;;
    --install-dir)
      if [[ -n "${2:-}" ]]; then install_dir="$2"; shift 2
      else echo -e "${RED}Error: --install-dir requires a path${NC}" >&2; exit 1
      fi ;;
    --no-modify-path) no_modify_path=true; shift ;;
    --no-config) no_config=true; shift ;;
    *) echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2; shift ;;
  esac
done

info() { echo -e "${MUTED}$*${NC}"; }
err()  { echo -e "${RED}$*${NC}" >&2; }

detect_target() {
  local raw_os os arch combo
  raw_os=$(uname -s)
  case "$raw_os" in
    Darwin*) os="darwin" ;;
    Linux*)  os="linux"  ;;
    MINGW*|MSYS*|CYGWIN*)
      err "SecureCode は Windows ネイティブ環境では動作しません。"
      err "WSL (Windows Subsystem for Linux) 経由でご使用ください。"
      err ""
      err "WSL のインストール: https://learn.microsoft.com/windows/wsl/install"
      err ""
      err "WSL をインストール後、WSL のターミナルを開き以下を実行してください:"
      err "  gh release download -R acompany-develop/securecode-release --pattern install -O - | bash"
      exit 1 ;;
    *) err "Unsupported OS: $raw_os"; exit 1 ;;
  esac

  arch=$(uname -m)
  case "$arch" in
    aarch64|arm64) arch="arm64" ;;
    x86_64|amd64)  arch="x64"   ;;
    *) err "Unsupported arch: $arch"; exit 1 ;;
  esac

  # Mac running under Rosetta: prefer the native arm64 binary.
  if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
      arch="arm64"
    fi
  fi

  combo="$os-$arch"
  case "$combo" in
    linux-x64|linux-arm64|darwin-x64|darwin-arm64) ;;
    *) err "Unsupported OS/Arch combo: $combo"; exit 1 ;;
  esac

  echo "$combo"
}

needs_baseline_x64() {
  local os="$1" arch="$2"
  [ "$arch" = "x64" ] || return 1
  case "$os" in
    linux)  grep -qwi avx2 /proc/cpuinfo 2>/dev/null || return 0 ;;
    darwin) [ "$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)" = "1" ] || return 0 ;;
  esac
  return 1
}

is_alpine_or_musl() {
  [ -f /etc/alpine-release ] && return 0
  if command -v ldd >/dev/null 2>&1; then
    ldd --version 2>&1 | grep -qi musl && return 0
  fi
  return 1
}

resolve_target_filename() {
  local os arch target ext target_full
  target=$(detect_target)
  os="${target%-*}"
  arch="${target#*-}"

  target_full="$target"
  if needs_baseline_x64 "$os" "$arch"; then
    target_full="${target_full}-baseline"
  fi
  if [ "$os" = "linux" ] && is_alpine_or_musl; then
    target_full="${target_full}-musl"
  fi

  ext=".zip"
  [ "$os" = "linux" ] && ext=".tar.gz"

  echo "${ARCHIVE_PREFIX}-${target_full}${ext}"
}

require_tool() {
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || { err "Missing required tool: $tool"; exit 1; }
  done
}

# Detects an authenticated `gh` CLI. We prefer `gh` over bare curl because the
# repository is currently private (issue #82 follow-up): `gh release download`
# transparently handles GitHub auth, asset_id resolution, and the redirect to
# the signed S3 asset URL, none of which a bare `curl` can do for private repos.
have_gh_auth() {
  command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1
}

download_archive() {
  local url="$1" output="$2" version="$3" filename="$4"
  if have_gh_auth; then
    gh release download "v${version}" -R "$GH_REPO" --pattern "$filename" -O "$output"
    return
  fi
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$output" "$url"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$output" "$url"
  else
    err "Need curl or wget (or gh) to download release archive"; exit 1
  fi
}

resolve_version() {
  if [ -n "$requested_version" ]; then
    echo "${requested_version#v}"
    return
  fi

  if have_gh_auth; then
    local resolved=""
    if ! resolved=$(gh release view -R "$GH_REPO" --json tagName --jq '.tagName' 2>/dev/null); then
      err "gh release view failed. Make sure you have access to ${GH_REPO}"
      err "and that 'gh auth login' completed successfully."
      exit 1
    fi
    echo "${resolved#v}"
    return
  fi

  require_tool curl
  local resolved=""
  # Wrap the curl pipeline in an `if ! ...` guard rather than the bare
  # `resolved=$(curl ... | sed ...)` assignment so that `set -euo pipefail`
  # does NOT abort the script before the empty-result check fires. Without
  # this, an HTTP error (e.g. GitHub API rate limit 403/429) silently
  # terminates with no diagnostic — issue #82 review finding A.
  if ! resolved=$(curl -fsSL "https://api.github.com/repos/${GH_REPO}/releases/latest" \
    | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p'); then
    err "Failed to query GitHub for the latest release."
    err "If ${GH_REPO} is private, install gh CLI and run 'gh auth login' first,"
    err "or pass --version <ver> explicitly to skip the lookup."
    exit 1
  fi
  if [ -z "$resolved" ]; then
    err "Could not parse tag_name from GitHub's response. The API may have returned an unexpected payload."
    exit 1
  fi
  echo "$resolved"
}

extract_archive() {
  local file="$1" dest="$2"
  # `unzip -d` auto-creates the destination, but `tar -C` requires it to
  # exist beforehand. Create unconditionally so both code paths behave the
  # same and Linux (.tar.gz) does not regress (refs #173).
  mkdir -p "$dest"
  case "$file" in
    *.zip)
      require_tool unzip
      unzip -q "$file" -d "$dest" ;;
    *.tar.gz)
      require_tool tar
      tar -xzf "$file" -C "$dest" ;;
    *) err "Unknown archive type: $file"; exit 1 ;;
  esac
}

# Find the SecureCode binary within an extracted directory tree. The archive
# lays it out as `<archive>/SecureCode[.exe]`, so we search for that name.
find_binary() {
  local dir="$1"
  for candidate in \
      "$dir/${ARCHIVE_PREFIX}" \
      "$dir/${ARCHIVE_PREFIX}.exe" \
      "$dir"/*/"${ARCHIVE_PREFIX}" \
      "$dir"/*/"${ARCHIVE_PREFIX}.exe"; do
    if [ -f "$candidate" ]; then echo "$candidate"; return 0; fi
  done
  return 1
}

# Find the inner opencode binary (`securecode-bin`) that ships next to the
# supervisor inside the extracted archive. The supervisor at runtime spawns
# this binary inside the sandbox, so it has to live in the same install dir.
find_inner_binary() {
  local supervisor="$1"
  local dir
  dir=$(dirname "$supervisor")
  for candidate in "$dir/securecode-bin" "$dir/securecode-bin.exe"; do
    if [ -f "$candidate" ]; then echo "$candidate"; return 0; fi
  done
  return 1
}

# Locate the bundled setup/install.sh after extraction so we can run plugin /
# config seeding without forcing the user to navigate the archive manually.
find_setup_dir() {
  local dir="$1"
  for candidate in "$dir/setup" "$dir"/*/setup; do
    if [ -d "$candidate" ] && [ -f "$candidate/install.sh" ]; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

install_binary() {
  local src="$1" dest="$2"
  mkdir -p "$(dirname "$dest")"
  cp "$src" "$dest"
  chmod 755 "$dest"
  if [ "$(uname -s)" = "Darwin" ]; then
    # Strip the macOS quarantine xattr so Gatekeeper allows the unsigned binary
    # to run without a "developer cannot be verified" pop-up. Drop once
    # securecode is properly signed.
    xattr -cr "$dest" 2>/dev/null || true
  fi
}

add_to_path_rc() {
  local rc="$1" line="$2"
  if [ ! -f "$rc" ]; then return 0; fi
  if grep -Fxq "$line" "$rc"; then
    info "PATH entry already present in $rc"
    return 0
  fi
  printf '\n# Acompany SecureCode\n%s\n' "$line" >> "$rc"
  info "Appended PATH entry to $rc"
}

modify_path_for_shell() {
  local dir="$1"
  case "$(basename "${SHELL:-bash}")" in
    fish)
      add_to_path_rc "$HOME/.config/fish/config.fish" "fish_add_path $dir" ;;
    zsh)
      add_to_path_rc "${ZDOTDIR:-$HOME}/.zshrc" "export PATH=\"$dir:\$PATH\"" ;;
    bash)
      add_to_path_rc "$HOME/.bashrc" "export PATH=\"$dir:\$PATH\""
      add_to_path_rc "$HOME/.bash_profile" "export PATH=\"$dir:\$PATH\"" ;;
    *)
      info "Unknown shell. Manually add: export PATH=\"$dir:\$PATH\"" ;;
  esac
}

main() {
  if [ -n "$binary_path" ]; then
    [ -f "$binary_path" ] || { err "Binary not found: $binary_path"; exit 1; }
    install_binary "$binary_path" "$install_dir/$APP"
    info "Installed $APP from $binary_path"
    # If the user extracted a release archive and is pointing --binary at the
    # binary inside it, the setup/ dir lives next to that binary. Honour
    # --no-config so the behaviour matches the download path (issue #82
    # review finding E).
    if [ "$no_config" != "true" ]; then
      local binary_dir setup_dir
      binary_dir=$(dirname "$binary_path")
      if setup_dir=$(find_setup_dir "$binary_dir"); then
        info "Seeding default config via $(basename "$setup_dir")/install.sh ..."
        bash "$setup_dir/install.sh" || info "Config setup exited non-zero (you can re-run later)"
      fi
    fi
  else
    local filename
    filename=$(resolve_target_filename)

    # Auto-detect an archive that sits next to the install script on disk so
    # offline / Notion-distributed users only need to "drop both files in the
    # same directory and run bash install" (refs #159).
    if [ -z "$archive_path" ] && [ -n "$script_dir" ] && [ -f "${script_dir}/${filename}" ]; then
      archive_path="${script_dir}/${filename}"
      info "Found local archive next to install script: ${archive_path}"
    fi

    tmp=$(mktemp -d -t securecode-install-XXXXXX)
    local staged="$tmp/$filename"

    if [ -n "$archive_path" ]; then
      [ -f "$archive_path" ] || { err "Archive not found: $archive_path"; exit 1; }
      info "Using local archive: ${archive_path}"
      cp "$archive_path" "$staged"
    else
      local version url
      version=$(resolve_version)
      url="https://github.com/${GH_REPO}/releases/download/v${version}/${filename}"
      info "Downloading ${filename} (v${version})..."
      download_archive "$url" "$staged" "$version" "$filename"
    fi

    info "Extracting ${filename}..."
    extract_archive "$staged" "$tmp/unpacked"

    local bin
    bin=$(find_binary "$tmp/unpacked") || { err "Could not locate ${ARCHIVE_PREFIX} binary inside ${filename}"; exit 1; }
    install_binary "$bin" "$install_dir/$APP"
    info "Installed $APP -> $install_dir/$APP"

    # supervisor は同じディレクトリにある securecode-bin (opencode 本体) を
    # sandbox 内で spawn する。並べて install_dir に置く。
    local inner_bin inner_name
    if inner_bin=$(find_inner_binary "$bin"); then
      inner_name=$(basename "$inner_bin")
      install_binary "$inner_bin" "$install_dir/$inner_name"
      info "Installed $inner_name -> $install_dir/$inner_name"
    else
      err "Could not locate securecode-bin (opencode 本体) inside ${filename}. SecureCode will not start."
      exit 1
    fi

    if [ "$no_config" != "true" ]; then
      local setup_dir
      if setup_dir=$(find_setup_dir "$tmp/unpacked"); then
        info "Seeding default config via $(basename "$setup_dir")/install.sh ..."
        bash "$setup_dir/install.sh" || info "Config setup exited non-zero (you can re-run later)"
      fi
    fi
  fi

  if [ "$no_modify_path" != "true" ]; then
    case ":$PATH:" in
      *":$install_dir:"*) : ;;
      *) modify_path_for_shell "$install_dir" ;;
    esac
  fi

  if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" = "true" ]; then
    echo "$install_dir" >> "$GITHUB_PATH"
  fi

  echo
  if "$install_dir/$APP" --version 2>/dev/null; then
    info "$APP installation complete. Start a new shell or 'export PATH=\"$install_dir:\$PATH\"' to use it now."
  else
    info "$APP placed at $install_dir/$APP but '$APP --version' failed. Check execute permissions or shell PATH."
  fi
}

main "$@"
