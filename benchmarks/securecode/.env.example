SECURECODE_BASE_URL=http://localhost:8080/v1
SECURECODE_MODEL=model-under-test
SECURECODE_API_KEY=

# Optional: choose the prompt locale and local SecCodeBench cache path
# SECURECODE_LOCALE=zh-CN
# SECURECODE_CACHE_ROOT=${HOME}/.cache/securecode
# SECURECODE_SEC_CODE_BENCH_DIR=${SECURECODE_CACHE_ROOT}/sec-code-bench

# Default: keep benchmark artifacts inside this repository
SECURECODE_OUTPUT_ROOT="${REPO_ROOT}/results"

# Optional: annotate the generated summary with deployment-specific details
# SECURECODE_BACKING_MODEL=vendor/checkpoint-name

# Optional: fetch GPU/system telemetry from a remote GPU host that also has
# benchmarks/securecode/monitoring/securecode_monitor_remote.sh available.
# SECURECODE_REMOTE_HOST=bench@example-host
# SECURECODE_REMOTE_MONITOR_DIR=/absolute/path/to/benchmarks/securecode/monitoring
# SECURECODE_REMOTE_RUN_ROOT=~/.cache/securecode/securecode-monitor/runs
