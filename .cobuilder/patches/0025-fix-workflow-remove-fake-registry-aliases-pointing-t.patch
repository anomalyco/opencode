From 1391a8fa5cdeaad8120871906f1f367eae5cc1bd Mon Sep 17 00:00:00 2001
From: johnnykang101 <johnny.kang101@gmail.com>
Date: Thu, 26 Mar 2026 15:47:24 -0700
Subject: [PATCH 025/127] fix(workflow): remove fake registry aliases pointing
 to non-existent repos

gsd-workflow, ralph-loop-workflow, and gstack-workflow repos do not exist
under CobuilderLabs. Keeping them caused a confusing git clone failure.
Users should provide a full GitHub URL until real workflow repos are published.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 packages/opencode/src/workflow/registry.ts | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/packages/opencode/src/workflow/registry.ts b/packages/opencode/src/workflow/registry.ts
index 36d7a0c02..0fbf96241 100644
--- a/packages/opencode/src/workflow/registry.ts
+++ b/packages/opencode/src/workflow/registry.ts
@@ -2,11 +2,7 @@
 // Built-in alias registry — maps short names to canonical GitHub URLs.
 // User config (opencode.json) only stores installed paths, never alias mappings.
 
-export const REGISTRY: Record<string, string> = {
-  "gsd": "https://github.com/CobuilderLabs/gsd-workflow",
-  "ralph-loop": "https://github.com/CobuilderLabs/ralph-loop-workflow",
-  "gstack": "https://github.com/CobuilderLabs/gstack-workflow",
-}
+export const REGISTRY: Record<string, string> = {}
 
 /**
  * Given a source string (alias or full URL), return the canonical URL to clone.
-- 
