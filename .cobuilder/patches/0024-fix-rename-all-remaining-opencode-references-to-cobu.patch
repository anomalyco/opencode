From 3092881e5c96cfd4dc8d68831d25d3cae73604d4 Mon Sep 17 00:00:00 2001
From: johnnykang101 <johnny.kang101@gmail.com>
Date: Thu, 26 Mar 2026 15:44:57 -0700
Subject: [PATCH 024/127] fix: rename all remaining opencode references to
 cobuilder
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- bin/cobuilder: OPENCODE_BIN_PATH → COBUILDER_BIN_PATH env var
- pr.ts: spawn cobuilder binary instead of opencode (runtime fix)
- uninstall.ts: brew/choco/scoop package names, intro/outro text
- run.ts/worker.ts/plugin/index.ts/server.ts: default auth username

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 packages/opencode/bin/cobuilder             |  2 +-
 packages/opencode/src/cli/cmd/pr.ts         | 12 ++++++------
 packages/opencode/src/cli/cmd/run.ts        |  2 +-
 packages/opencode/src/cli/cmd/tui/worker.ts |  2 +-
 packages/opencode/src/cli/cmd/uninstall.ts  | 16 ++++++++--------
 packages/opencode/src/plugin/index.ts       |  2 +-
 packages/opencode/src/server/server.ts      |  2 +-
 7 files changed, 19 insertions(+), 19 deletions(-)

diff --git a/packages/opencode/bin/cobuilder b/packages/opencode/bin/cobuilder
index a3979389a..4bb55f0f4 100755
--- a/packages/opencode/bin/cobuilder
+++ b/packages/opencode/bin/cobuilder
@@ -17,7 +17,7 @@ function run(target) {
   process.exit(code)
 }
 
-const envPath = process.env.OPENCODE_BIN_PATH
+const envPath = process.env.COBUILDER_BIN_PATH
 if (envPath) {
   run(envPath)
 }
