             elif echo "$subject" | grep -qE '^(security|sec)(\(.+\))?:'; then
               SECURITY="${SECURITY}"$'\n'"- ${CLEAN}"
-            else
-              CHANGED="${CHANGED}"$'\n'"- ${CLEAN}"
             fi
           done <<< "$COMMITS"
 
