From c8aaa44248432439f5d0436bfe5d21acbe2a2c13 Mon Sep 17 00:00:00 2001
From: johnnykang101 <56775858+johnnykang101@users.noreply.github.com>
Date: Fri, 27 Mar 2026 10:01:09 -0700
Subject: [PATCH 094/127] ci: replace TEAM_MEMBERS file lookup with
 collaborator permission check (#37)
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream pr-standards.yml read TEAM_MEMBERS from the dev branch which
is irrelevant to CoBuilder. Replace with a GitHub API collaborator
permission check — any user with write/admin access is skipped.
---
 .github/workflows/pr-standards.yml | 48 ++++++++++++++++--------------
 1 file changed, 26 insertions(+), 22 deletions(-)

diff --git a/.github/workflows/pr-standards.yml b/.github/workflows/pr-standards.yml
index 1edbd5d06..70f1f18ed 100644
--- a/.github/workflows/pr-standards.yml
+++ b/.github/workflows/pr-standards.yml
@@ -26,18 +26,20 @@ jobs:
               return;
             }
 
-            // Check if author is a team member or bot
+            // Check if author is a bot or repo collaborator with write access
             if (login === 'opencode-agent[bot]') return;
-            const { data: file } = await github.rest.repos.getContent({
-              owner: context.repo.owner,
-              repo: context.repo.repo,
-              path: '.github/TEAM_MEMBERS',
-              ref: 'dev'
-            });
-            const members = Buffer.from(file.content, 'base64').toString().split('\n').map(l => l.trim()).filter(Boolean);
-            if (members.includes(login)) {
-              console.log(`Skipping: ${login} is a team member`);
-              return;
+            try {
+              const { data: perm } = await github.rest.repos.getCollaboratorPermissionLevel({
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                username: login,
+              });
+              if (['admin', 'write'].includes(perm.permission)) {
+                console.log(`Skipping: ${login} is a collaborator (${perm.permission})`);
+                return;
+              }
+            } catch (e) {
+              // Not a collaborator — continue with checks
             }
 
             const title = pr.title;
@@ -173,18 +175,20 @@ jobs:
               return;
             }
 
-            // Check if author is a team member or bot
+            // Check if author is a bot or repo collaborator with write access
             if (login === 'opencode-agent[bot]') return;
-            const { data: file } = await github.rest.repos.getContent({
-              owner: context.repo.owner,
-              repo: context.repo.repo,
-              path: '.github/TEAM_MEMBERS',
-              ref: 'dev'
-            });
-            const members = Buffer.from(file.content, 'base64').toString().split('\n').map(l => l.trim()).filter(Boolean);
-            if (members.includes(login)) {
-              console.log(`Skipping: ${login} is a team member`);
-              return;
+            try {
+              const { data: perm } = await github.rest.repos.getCollaboratorPermissionLevel({
+                owner: context.repo.owner,
+                repo: context.repo.repo,
+                username: login,
+              });
+              if (['admin', 'write'].includes(perm.permission)) {
+                console.log(`Skipping: ${login} is a collaborator (${perm.permission})`);
+                return;
+              }
+            } catch (e) {
+              // Not a collaborator — continue with checks
             }
 
             const body = pr.body || '';
