From 5387fa015c6d19e08306bd316b23883704679104 Mon Sep 17 00:00:00 2001
From: CoBuilder CEO <ceo@cobuilder.ai>
Date: Thu, 26 Mar 2026 22:34:19 -0700
Subject: [PATCH 067/129] fix(cd): set NODE_PATH to workspace node_modules on
 Windows to fix electron-vite module resolution

---
 .github/workflows/cd.yml | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/.github/workflows/cd.yml b/.github/workflows/cd.yml
index c1d71ff78..1c643389d 100644
--- a/.github/workflows/cd.yml
+++ b/.github/workflows/cd.yml
@@ -255,9 +255,6 @@ jobs:
       - name: Install dependencies
         run: bun install --frozen-lockfile
 
-      - name: Fix electron-vite picocolors resolution (Windows)
-        run: bun add picocolors --cwd packages/desktop-electron
-
       - name: Set desktop version
         run: |
           cd packages/desktop-electron
@@ -269,7 +266,11 @@ jobs:
           "
 
       - name: Build
-        run: cd packages/desktop-electron && bun run build
+        shell: pwsh
+        run: |
+          $env:NODE_PATH = "${{ github.workspace }}\node_modules"
+          cd packages/desktop-electron
+          bun run build
         env:
           OPENCODE_CHANNEL: prod
 
-- 
