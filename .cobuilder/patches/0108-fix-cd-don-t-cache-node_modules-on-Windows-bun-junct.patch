Subject: [PATCH 108/127] =?UTF-8?q?fix(cd):=20don't=20cache=20node=5Fmodul?=
 =?UTF-8?q?es=20on=20Windows=20=E2=80=94=20bun=20junctions=20break=20on=20?=
 =?UTF-8?q?cache=20restore?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 .github/workflows/cd.yml | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/.github/workflows/cd.yml b/.github/workflows/cd.yml
index b9e3e20d7..a786c9ee5 100644
--- a/.github/workflows/cd.yml
+++ b/.github/workflows/cd.yml
@@ -196,13 +196,10 @@ jobs:
         with:
           bun-version: ${{ env.BUN_VERSION }}
 
-      - name: Cache bun dependencies
+      - name: Cache bun download cache
         uses: actions/cache@v4
         with:
-          path: |
-            ~\AppData\Local\bun\install\cache
-            node_modules
-            packages\*\node_modules
+          path: ~\AppData\Local\bun\install\cache
           key: bun-${{ runner.os }}-${{ hashFiles('bun.lock') }}
           restore-keys: bun-${{ runner.os }}-
 
