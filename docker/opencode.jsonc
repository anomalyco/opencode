{
  "permission": "allow",
  "provider": {
    "anthropic": {
      "options": {
        "baseURL": "${ANTHROPIC_BASE_URL}",
        "apiKey": "proxy-auth"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--headless", "--browser", "chromium"],
      "enabled": true
    }
  }
}
