{
  "permission": "allow",
  "model": "google/gemini-3.5-flash",
  "provider": {
    "google": {
      "options": {
        "baseURL": "${GEMINI_BASE_URL}",
        "apiKey": "proxy-auth"
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--headless", "--browser", "chromium"],
      "enabled": true
    }
  }
}
