# Executor API: per-session MicroPython subprocesses with bundled mpy-lib.
FROM ubuntu:22.04

WORKDIR /app

RUN apt-get update && apt-get install -y \
    curl \
    micropython \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

COPY packages/executor/mpy-lib /app/mpy-lib
RUN test -s /app/mpy-lib/veritly_univer_sdk.py

COPY packages/executor/package.json ./
RUN bun install --production --no-save

COPY packages/executor/src ./src

RUN mkdir -p /tmp/veritly-executor

ENV PORT=7777
ENV EXECUTOR_DATA_DIR=/tmp/veritly-executor
ENV MICROPYTHON_LIB=/app/mpy-lib
ENV VM_INACTIVITY_TIMEOUT_MS=300000

EXPOSE 7777

CMD ["bun", "run", "src/server.ts"]
