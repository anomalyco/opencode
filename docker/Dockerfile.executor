# Firecracker executor API. Commands run inside per-session microVMs.
FROM ubuntu:22.04

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    iproute2 \
    unzip \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# Download Firecracker
RUN ARCH="$(uname -m)" && \
    LATEST_VERSION="v1.8.0" && \
    curl -L -o firecracker.tgz "https://github.com/firecracker-microvm/firecracker/releases/download/${LATEST_VERSION}/firecracker-${LATEST_VERSION}-${ARCH}.tgz" && \
    tar -xzf firecracker.tgz && \
    mv release-${LATEST_VERSION}-$(uname -m)/firecracker-${LATEST_VERSION}-${ARCH} /usr/local/bin/firecracker && \
    chmod +x /usr/local/bin/firecracker && \
    rm -rf firecracker.tgz release-*

# Copy prebuilt VM artifacts from packages/executor/scripts/build-vm.sh.
# The rootfs is where Python, pip, and veritly_univer_sdk are installed.
RUN mkdir -p /opt/veritly
COPY packages/executor/output/vmlinux /opt/veritly/vmlinux
COPY packages/executor/output/rootfs.ext4 /opt/veritly/rootfs.ext4
RUN chmod +x /opt/veritly/vmlinux && test "$(stat -c%s /opt/veritly/rootfs.ext4)" -gt 1048576

# Copy executor code
COPY packages/executor/package.json ./
RUN bun install --production --no-save

COPY packages/executor/src ./src

# Create workspace
RUN mkdir -p /workspace /tmp/veritly-vms

ENV PORT=7777
ENV VM_DATA_DIR=/tmp/veritly-vms
ENV KERNEL_PATH=/opt/veritly/vmlinux
ENV ROOTFS_PATH=/opt/veritly/rootfs.ext4
ENV FIRECRACKER_BINARY=/usr/local/bin/firecracker
ENV VM_INACTIVITY_TIMEOUT_MS=300000

EXPOSE 7777

CMD ["bun", "run", "src/server.ts"]
