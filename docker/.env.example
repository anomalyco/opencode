# 复制为 .env 后填值（.env 不进仓库，600 权限）
# 工具镜像（compose 参数，默认追 latest；要锁版本就写 digest pin，compose 文件无需再改）
# 例：TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools:latest
#     TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools@sha256:aa5f271a82a3b5dc0d8939c3d18b26b3ba76b74105be6b61d3934e46b8416238
TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools:latest
LITELLM_BASE_URL=
# 注意：compose 已切 bridge 网络，容器内 127.0.0.1 不再是宿主机；
# 若网关跑在宿主机上，这里填 http://host.docker.internal:<port>（不要填 127.0.0.1）。
LITELLM_API_KEY=
GH_TOKEN=
OPENCODE_SERVER_PASSWORD=
CLOUDFLARE_API_TOKEN=
HCLOUD_AK=
HCLOUD_SK=
# 浏览器 sidecar（compose 里 browser 服务，CDP 协议；浏览器不在 tools 镜像内）
# 默认 chrome-cjk（headless-shell + 中文字体）；备选 chromedp/headless-shell:latest
# 例：BROWSER_IMAGE=swr.cn-north-4.myhuaweicloud.com/hwstaff_l00392796/chrome-cjk:latest
BROWSER_IMAGE=swr.cn-north-4.myhuaweicloud.com/hwstaff_l00392796/chrome-cjk:latest
# opencode 容器内连浏览器的地址（bridge 服务名即地址，改 compose 服务名时同步改这里）
BROWSER_CDP_URL=http://browser:9222
# SSH 私钥（base64 单行，空则跳过）：SSH_PRIVATE_KEY_B64=$(base64 -w0 < ~/.ssh/id_ed25519)
SSH_PRIVATE_KEY_B64=
# 可选：known_hosts 内容（单行；多主机用挂文件 ./config/home/.ssh/known_hosts:/root/.ssh/known_hosts:ro 代替）
SSH_KNOWN_HOSTS=
# SSH 目标机（空格分隔，启动时自动 ssh-keyscan 进 known_hosts，缺失重试 3 次；1.21/1.41 自动映射到 192.168.1.21/41）
# 北京四的云主机名在容器内不解析，填 EIP（到控制台或用容器里 hcloud 查）
SSH_TARGETS=192.168.1.21 192.168.1.41
# 例（含两台 EIP，按实际填）：SSH_TARGETS=192.168.1.21 192.168.1.41 <0001-EIP> <0002-EIP>
# 自定义 ssh 配置（\n 表换行），追加到容器 ~/.ssh/config；以后加机器改这里即可，不用动 compose 文件
# 例：SSH_CONFIG_EXTRA=Host gpu01\n  HostName 192.168.1.82\n  User root
SSH_CONFIG_EXTRA=
# 邮件通知（msmtp 经 SMTP 发信；密码/授权码走这里，不进镜像，600 权限）
# QQ/163/Gmail 等用授权码不用登录密码；465 端口隐式 TLS，587 走 STARTTLS
# 例：SMTP_HOST=smtp.qq.com SMTP_PORT=587 SMTP_USER=you@qq.com SMTP_PASS=<授权码> SMTP_FROM=you@qq.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 默认收件人（send-mail 未传收件人时兜底，可空）
MAIL_DEFAULT_TO=
