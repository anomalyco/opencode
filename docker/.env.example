# 复制为 .env 后填值（.env 不进仓库，600 权限）
# 工具镜像（compose 参数，默认追 latest；要锁版本就写 digest pin，compose 文件无需再改）
# 例：TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools:latest
#     TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools@sha256:aa5f271a82a3b5dc0d8939c3d18b26b3ba76b74105be6b61d3934e46b8416238
TOOLS_IMAGE=swr.cn-north-9.myhuaweicloud.com/xieyucheng123/opencode-tools:latest
LITELLM_BASE_URL=
LITELLM_API_KEY=
GH_TOKEN=
OPENCODE_SERVER_PASSWORD=
CLOUDFLARE_API_TOKEN=
HCLOUD_AK=
HCLOUD_SK=
# SSH 私钥（base64 单行，空则跳过）：SSH_PRIVATE_KEY_B64=$(base64 -w0 < ~/.ssh/id_ed25519)
SSH_PRIVATE_KEY_B64=
# 可选：known_hosts 内容（单行；多主机用挂文件 ./config/home/.ssh/known_hosts:/root/.ssh/known_hosts:ro 代替）
SSH_KNOWN_HOSTS=
