FROM oven/bun:1.2-alpine

WORKDIR /app

RUN printf '{\n  "name": "@veritly/frontend",\n  "version": "1.0.0",\n  "private": true,\n  "type": "module"\n}\n' > package.json

COPY packages/app/dist /app/dist
COPY packages/app/server.ts /app/server.ts
COPY packages/app/script/frontend-health-runtime.ts /app/script/frontend-health-runtime.ts

ENV PORT=80
ENV FRONTEND_DIST_DIR=/app/dist
ENV FRONTEND_PUBLIC_OPENCODE_SERVER_URL=https://api.veritly.co.uk
ENV FRONTEND_PUBLIC_UNIVER_BACKEND_URL=https://univer.veritly.co.uk
ENV FRONTEND_PUBLIC_UNIVER_SDK_WS=wss://relay.veritly.co.uk/ws

EXPOSE 80

CMD ["bun", "run", "server.ts"]
