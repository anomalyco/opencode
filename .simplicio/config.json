{
  "$schema": "https://raw.githubusercontent.com/wesleysimplicio/simplicio-mapper/main/schema/config.schema.json",
  "project": {
    "name": "simpliciocode",
    "displayName": "SimplicioCode",
    "description": "AI-powered development tool (fork of OpenCode, rebranded as SimplicioCode)",
    "repo": "wesleysimplicio/simplicio-code"
  },
  "tools": {
    "mapper": {
      "package": "@wesleysimplicio/llm-project-mapper",
      "channel": "latest",
      "command": "npx -y @wesleysimplicio/llm-project-mapper@latest --yes --no-update-check --cli skip --append-gitignore no --skip-meta",
      "autoRunOnSessionStart": true
    },
    "devCli": {
      "package": "simplicio-cli",
      "channel": "latest",
      "command": "simplicio",
      "defaultModelEnv": "SIMPLICIO_MODEL"
    },
    "sprint": {
      "package": "simplicio-sprint",
      "channel": "latest",
      "command": "sendsprint",
      "trackers": ["jira", "azuredevops", "github"]
    },
    "prompt": {
      "package": "simplicio-prompt",
      "channel": "latest"
    }
  },
  "localAi": {
    "name": "Simplicio1",
    "default": true,
    "free": true,
    "tokenLimit": null,
    "autoSelect": true,
    "selection": {
      "preferRemoteWithBudget": "hf-deepseek-v4-pro",
      "remoteBudgetUsd": 5.00,
      "fallbackOrder": ["14b", "7b", "3b", "1.5b"]
    },
    "tiers": [
      {
        "id": "deepseek-v4-pro",
        "label": "Simplicio1 — DeepSeek V4 Pro (HF, budget $5)",
        "provider": "huggingface",
        "model": "deepseek-ai/DeepSeek-V4-Pro",
        "baseUrl": "https://api-inference.huggingface.co/models",
        "envToken": "HF_TOKEN",
        "budgetUsd": 5.00,
        "kind": "remote"
      },
      {
        "id": "14b",
        "label": "Simplicio1 — Qwen 2.5 Coder 14B (Local • Free)",
        "provider": "ollama",
        "model": "qwen2.5-coder:14b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 16,
        "kind": "local"
      },
      {
        "id": "7b",
        "label": "Simplicio1 — Qwen 2.5 Coder 7B (Local • Free)",
        "provider": "ollama",
        "model": "qwen2.5-coder:7b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 8,
        "kind": "local"
      },
      {
        "id": "3b",
        "label": "Simplicio1 — Qwen 2.5 Coder 3B (Local • Free)",
        "provider": "ollama",
        "model": "qwen2.5-coder:3b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 4,
        "kind": "local"
      },
      {
        "id": "1.5b",
        "label": "Simplicio1 — Qwen 2.5 Coder 1.5B (Local • Free)",
        "provider": "ollama",
        "model": "qwen2.5-coder:1.5b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 2,
        "kind": "local"
      }
    ]
  },
  "subscription": {
    "free": {
      "models": ["simplicio1-auto"],
      "sprintMode": "manual",
      "watcher": false
    },
    "pro": {
      "priceUsdMonth": 20,
      "tokensIncluded": "unlimited",
      "sprintMode": "automatic",
      "watcher": true,
      "remoteModels": ["claude-opus", "gpt-5", "gemini-2.5-pro"]
    }
  },
  "flow": {
    "cliPipeline": ["map", "task", "sprint"],
    "mandatoryBeforeProgramming": ["map"]
  },
  "schedule": {
    "updateCron": [
      { "label": "morning",   "brt": "10:00", "utc": "13:00", "cron": "0 13 * * *" },
      { "label": "afternoon", "brt": "17:30", "utc": "20:30", "cron": "30 20 * * *" }
    ]
  }
}
