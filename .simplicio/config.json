{
  "$schema": "https://raw.githubusercontent.com/wesleysimplicio/simplicio-mapper/main/schema/config.schema.json",
  "project": {
    "name": "simpliciocode",
    "displayName": "SimplicioCode",
    "description": "AI-powered development tool (fork of OpenCode, rebranded as SimplicioCode)",
    "repo": "wesleysimplicio/simplicio-code"
  },
  "tools": {
    "mapper": {
      "package": "@wesleysimplicio/llm-project-mapper",
      "channel": "latest",
      "command": "npx -y @wesleysimplicio/llm-project-mapper@latest --yes --no-update-check --cli skip --append-gitignore no --skip-meta",
      "autoRunOnSessionStart": true
    },
    "devCli": {
      "package": "simplicio-cli",
      "channel": "latest",
      "command": "simplicio",
      "defaultModelEnv": "SIMPLICIO_MODEL"
    },
    "sprint": {
      "package": "simplicio-sprint",
      "channel": "latest",
      "command": "sendsprint",
      "trackers": ["jira", "azuredevops", "github"]
    },
    "prompt": {
      "package": "simplicio-prompt",
      "channel": "latest"
    }
  },
  "localAi": {
    "name": "Simplicio1",
    "default": true,
    "free": true,
    "tokenLimit": null,
    "autoSelect": true,
    "selection": {
      "preferRemoteWithBudget": "hf-deepseek-v4-pro",
      "remoteBudgetUsd": 5.00,
      "fallbackOrder": ["14b", "7b", "3b", "1.5b"]
    },
    "tiers": [
      {
        "id": "deepseek-v4-pro",
        "label": "Simplicio1 Pro — DeepSeek V4 Pro (HF • budget $5)",
        "provider": "simplicio1-pro",
        "backend": "huggingface",
        "model": "deepseek-ai/DeepSeek-V4-Pro",
        "baseUrl": "https://api-inference.huggingface.co/v1",
        "envToken": "HF_TOKEN",
        "budgetUsd": 5.00,
        "kind": "remote"
      },
      {
        "id": "14b",
        "label": "Simplicio1 14B (Free • Local)",
        "provider": "simplicio1",
        "backend": "ollama",
        "model": "qwen2.5-coder:14b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 16,
        "kind": "local"
      },
      {
        "id": "7b",
        "label": "Simplicio1 7B (Free • Local)",
        "provider": "simplicio1",
        "backend": "ollama",
        "model": "qwen2.5-coder:7b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 8,
        "kind": "local"
      },
      {
        "id": "3b",
        "label": "Simplicio1 3B (Free • Local)",
        "provider": "simplicio1",
        "backend": "ollama",
        "model": "qwen2.5-coder:3b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 4,
        "kind": "local"
      },
      {
        "id": "1.5b",
        "label": "Simplicio1 1.5B (Free • Local)",
        "provider": "simplicio1",
        "backend": "ollama",
        "model": "qwen2.5-coder:1.5b",
        "baseUrl": "http://localhost:11434/v1",
        "minRamGb": 2,
        "kind": "local"
      }
    ]
  },
  "subscription": {
    "billing": {
      "provider": "stripe",
      "secretKeyEnv": "STRIPE_SECRET_KEY",
      "webhookSecretEnv": "STRIPE_WEBHOOK_SECRET",
      "priceIdPlusEnv": "STRIPE_PRICE_ID_PLUS",
      "priceIdProEnv": "STRIPE_PRICE_ID_PRO",
      "checkoutSuccessUrl": "https://opencode.ai/pricing/success",
      "checkoutCancelUrl": "https://opencode.ai/pricing/cancel",
      "customerPortalUrl": "https://billing.stripe.com/p/login/test_simplicio"
    },
    "security": {
      "jwtSecretEnv": "SIMPLICIO_JWT_SECRET",
      "jwtTtlSeconds": 900,
      "cachePath": "~/.config/simplicio/auth.json",
      "enforceInProductionEnv": "SIMPLICIO_ENFORCE"
    },
    "free": {
      "priceUsdMonth": 0,
      "models": ["simplicio1-local"],
      "sprintMode": "manual",
      "watcher": false,
      "remoteModels": false
    },
    "plus": {
      "priceUsdMonth": 20,
      "models": ["simplicio1-local", "simplicio1-pro"],
      "tokensIncluded": "unlimited",
      "sprintMode": "manual",
      "watcher": false,
      "remoteModels": true
    },
    "pro": {
      "priceUsdMonth": 50,
      "models": ["simplicio1-local", "simplicio1-pro"],
      "tokensIncluded": "unlimited",
      "sprintMode": "automatic",
      "watcher": true,
      "remoteModels": true
    }
  },
  "flow": {
    "cliPipeline": ["map", "task", "sprint"],
    "mandatoryBeforeProgramming": ["map"]
  },
  "schedule": {
    "updateCron": [
      { "label": "morning",   "brt": "10:00", "utc": "13:00", "cron": "0 13 * * *" },
      { "label": "afternoon", "brt": "17:30", "utc": "20:30", "cron": "30 20 * * *" }
    ]
  }
}
