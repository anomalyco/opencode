#!/usr/bin/env bash
set -euo pipefail
APP=Bolt

MUTED='\033[0;2m'
RED='\033[0;31m'
ORANGE='\033[38;5;214m'
NC='\033[0m' # No Color

usage() {
    cat <<EOF
Bolt Installer

Usage: install.sh [options]

Options:
    -h, --help              Display this help message
    -v, --version <version> Install a specific version (e.g., 0.0.0-beta-17236)
    -b, --binary <path>     Install from a local binary instead of downloading
        --no-modify-path    Don't modify shell config files (.zshrc, .bashrc, etc.)
        --no-voice          Skip /voice input setup (sox recorder plus whisper-cpp
                            and a local model, ~0.6 GB, for offline transcription
                            without an OpenAI key). Installed by default.

Examples:
    curl -fsSL https://raw.githubusercontent.com/bolt-builder/bolt-cli/dev/install | bash
    curl -fsSL https://raw.githubusercontent.com/bolt-builder/bolt-cli/dev/install | bash -s -- --version 0.0.1
    curl -fsSL https://raw.githubusercontent.com/bolt-builder/bolt-cli/dev/install | bash -s -- --no-voice
    ./install --binary /path/to/bolt
EOF
}

requested_version=${VERSION:-}
no_modify_path=false
binary_path=""
install_voice=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -v|--version)
            if [[ -n "${2:-}" ]]; then
                requested_version="$2"
                shift 2
            else
                echo -e "${RED}Error: --version requires a version argument${NC}"
                exit 1
            fi
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        --no-voice)
            install_voice=false
            shift
            ;;
        *)
            echo -e "${ORANGE}Warning: Unknown option '$1'${NC}" >&2
            shift
            ;;
    esac
done

INSTALL_DIR=$HOME/.bolt/bin
mkdir -p "$INSTALL_DIR"

# If --binary is provided, skip all download/detection logic
if [ -n "$binary_path" ]; then
    if [ ! -f "$binary_path" ]; then
        echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
        exit 1
    fi
    specific_version="local"
else
    raw_os=$(uname -s)
    os=$(echo "$raw_os" | tr '[:upper:]' '[:lower:]')
    case "$raw_os" in
      Darwin*) os="darwin" ;;
      Linux*) os="linux" ;;
      MINGW*|MSYS*|CYGWIN*) os="windows" ;;
    esac

    arch=$(uname -m)
    if [[ "$arch" == "aarch64" ]]; then
      arch="arm64"
    fi
    if [[ "$arch" == "x86_64" ]]; then
      arch="x64"
    fi

    if [ "$os" = "darwin" ] && [ "$arch" = "x64" ]; then
      rosetta_flag=$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)
      if [ "$rosetta_flag" = "1" ]; then
        arch="arm64"
      fi
    fi

    # Git Bash and MSYS2 run as emulated x64 on Windows ARM64, so `uname -m` reports x86_64.
    # The host CPU still shows in the `uname -s` suffix and in PROCESSOR_IDENTIFIER.
    if [ "$os" = "windows" ] && [ "$arch" = "x64" ]; then
      if [[ "$raw_os" == *-ARM64 || "${PROCESSOR_IDENTIFIER:-}" == ARM* ]]; then
        arch="arm64"
      fi
    fi

    combo="$os-$arch"
    case "$combo" in
      linux-x64|linux-arm64|darwin-x64|darwin-arm64|windows-x64|windows-arm64)
        ;;
      *)
        echo -e "${RED}Unsupported OS/Arch: $os/$arch${NC}"
        exit 1
        ;;
    esac

    is_musl=false
    if [ "$os" = "linux" ]; then
      if [ -f /etc/alpine-release ]; then
        is_musl=true
      fi

      if command -v ldd >/dev/null 2>&1; then
        if ldd --version 2>&1 | grep -qi musl; then
          is_musl=true
        fi
      fi
    fi

    needs_baseline=false
    if [ "$arch" = "x64" ]; then
      if [ "$os" = "linux" ]; then
        if ! grep -qwi avx2 /proc/cpuinfo 2>/dev/null; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "darwin" ]; then
        avx2=$(sysctl -n hw.optional.avx2_0 2>/dev/null || echo 0)
        if [ "$avx2" != "1" ]; then
          needs_baseline=true
        fi
      fi

      if [ "$os" = "windows" ]; then
        ps="(Add-Type -MemberDefinition \"[DllImport(\"\"kernel32.dll\"\")] public static extern bool IsProcessorFeaturePresent(int ProcessorFeature);\" -Name Kernel32 -Namespace Win32 -PassThru)::IsProcessorFeaturePresent(40)"
        out=""
        if command -v powershell.exe >/dev/null 2>&1; then
          out=$(powershell.exe -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        elif command -v pwsh >/dev/null 2>&1; then
          out=$(pwsh -NoProfile -NonInteractive -Command "$ps" 2>/dev/null || true)
        fi
        out=$(echo "$out" | tr -d '\r' | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')
        if [ "$out" != "true" ] && [ "$out" != "1" ]; then
          needs_baseline=true
        fi
      fi
    fi

    target="$os-$arch"
    if [ "$needs_baseline" = "true" ]; then
      target="$target-baseline"
    fi
    if [ "$is_musl" = "true" ]; then
      target="$target-musl"
    fi

    # release assets are named bolt-cli-<os>-<arch>[...] by packages/opencode/script/build.ts
    filename="bolt-cli-$target$archive_ext"


    if [ "$os" = "linux" ]; then
        if ! command -v tar >/dev/null 2>&1; then
             echo -e "${RED}Error: 'tar' is required but not installed.${NC}"
             exit 1
        fi
    else
        if ! command -v unzip >/dev/null 2>&1; then
            echo -e "${RED}Error: 'unzip' is required but not installed.${NC}"
            exit 1
        fi
    fi

    package_scope="@opencode"
    if [ -z "$requested_version" ]; then
        url="https://github.com/bolt-builder/bolt-cli/releases/latest/download/$filename"
        specific_version=$(curl -s https://api.github.com/repos/bolt-builder/bolt-cli/releases/latest | sed -n 's/.*"tag_name": *"v\([^"]*\)".*/\1/p')

        if [ -z "$specific_version" ] || [ -z "$package" ]; then
            echo -e "${RED}Failed to fetch version information${NC}"
            exit 1
        fi
        package_scope="${package%/cli}"
    else
        # Strip leading 'v' if present
        requested_version="${requested_version#v}"
        url="https://github.com/bolt-builder/bolt-cli/releases/download/v${requested_version}/$filename"
        specific_version=$requested_version
    fi

        # Verify the release exists before downloading
        http_status=$(curl -sI -o /dev/null -w "%{http_code}" "https://github.com/bolt-builder/bolt-cli/releases/tag/v${requested_version}")
        if [ "$http_status" = "404" ]; then
            echo -e "${RED}Error: Release v${requested_version} not found${NC}"
            echo -e "${MUTED}Available releases: https://github.com/bolt-builder/bolt-cli/releases${NC}"
            exit 1
        fi
    fi
fi

print_message() {
    local level=$1
    local message=$2
    local color=""

    case $level in
        info) color="${NC}" ;;
        warning) color="${NC}" ;;
        error) color="${RED}" ;;
    esac

    echo -e "${color}${message}${NC}"
}

check_version() {
    if command -v bolt >/dev/null 2>&1; then
        bolt_path=$(which bolt)

        ## Check the installed version
        installed_version=$(bolt --version 2>/dev/null || echo "")

        print_message info "${MUTED}Installed version: ${NC}$installed_version."
    fi
}

print_progress() {
    local bytes="$1"
    local length="$2"
    [ "$length" -gt 0 ] || return 0

    local width=50
    local percent=$(( bytes * 100 / length ))
    [ "$percent" -gt 100 ] && percent=100
    local on=$(( percent * width / 100 ))
    local off=$(( width - on ))

    local filled=$(printf "%*s" "$on" "")
    filled=${filled// /■}
    local empty=$(printf "%*s" "$off" "")
    empty=${empty// /･}

    printf "\r${ORANGE}%s%s %3d%%${NC}" "$filled" "$empty" "$percent" >&4
}

download_with_progress() {
    local url="$1"
    local output="$2"

    if [ -t 2 ]; then
        exec 4>&2
    else
        exec 4>/dev/null
    fi

    # Use an unpredictable name so a local attacker on a shared host can't
    # pre-create or race the FIFO path.
    local tracefile
    tracefile=$(mktemp -u "${TMPDIR:-/tmp}/bolt_install_trace.XXXXXX")
    mkfifo "$tracefile"

    # Hide cursor
    printf "\033[?25l" >&4

    trap "trap - RETURN; rm -f \"$headers\"; printf '\033[?25h' >&4; exec 4>&-" RETURN

    # Poll the file size on a timer so rendering cost stays fixed no matter how many bytes arrive.
    # Read the size with ls because busybox wc -c reads the whole file.
    curl -fsL -D "$headers" -o "$output" "$url" &
    local curl_pid=$!

    local length bytes
    while kill -0 "$curl_pid" 2>/dev/null; do
        if [ -f "$output" ]; then
            length=$(grep -i '^content-length:' "$headers" 2>/dev/null | tail -n 1 | tr -dc '0-9' || true)
            bytes=$(ls -ln "$output" | awk '{print $5}')
            print_progress "$bytes" "${length:-0}"
        fi
        sleep 0.1 2>/dev/null || sleep 1
    done

    local ret=0
    wait "$curl_pid" || ret=$?
    if [ "$ret" -eq 0 ]; then
        bytes=$(ls -ln "$output" | awk '{print $5}')
        print_progress "$bytes" "$bytes"
    fi
    echo "" >&4
    return $ret
}

download_and_install() {
    print_message info "\n${MUTED}Installing ${NC}Bolt ${MUTED}version: ${NC}$specific_version"
    # mktemp creates a private (0700), unpredictable directory; a fixed
    # PID-derived path under /tmp is guessable and racy on shared hosts.
    local tmp_dir
    tmp_dir=$(mktemp -d "${TMPDIR:-/tmp}/bolt_install.XXXXXX")

    if [[ "$os" == "windows" ]] || ! [ -t 2 ] || ! download_with_progress "$url" "$tmp_dir/$filename"; then
        # Fallback to standard curl on Windows, non-TTY environments, or if custom progress fails
        curl -f -# -L -o "$tmp_dir/$filename" "$url"
    fi

    tar -xzf "$tmp_dir/$filename" -C "$tmp_dir"
    local installed_binary="$APP"
    if [ "$os" = "windows" ]; then
        installed_binary="$APP.exe"
    fi

    binary="bolt"
    if [ "$os" = "windows" ]; then
        binary="bolt.exe"
    fi
    mv "$tmp_dir/$binary" "$INSTALL_DIR"
    chmod 755 "${INSTALL_DIR}/$binary"
    rm -rf "$tmp_dir"
}

install_from_binary() {
    print_message info "\n${MUTED}Installing ${NC}Bolt ${MUTED}from: ${NC}$binary_path"
    cp "$binary_path" "${INSTALL_DIR}/bolt"
    chmod 755 "${INSTALL_DIR}/bolt"
}

if [ -n "$binary_path" ]; then
    install_from_binary
else
    check_version
    download_and_install
fi
install_legacy_shim


path_added=false
add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        print_message info "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# bolt" >> "$config_file"
        echo "$command" >> "$config_file"
        print_message info "${MUTED}Successfully added ${NC}Bolt ${MUTED}to \$PATH in ${NC}$config_file"
    else
        print_message warning "Manually add the directory to $config_file (or similar):"
        print_message info "  $command"
    fi
}

XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

current_shell=$(basename "$SHELL")
case $current_shell in
    fish)
        config_files="$HOME/.config/fish/config.fish"
    ;;
    zsh)
        config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv"
    ;;
    bash)
        config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
    ash)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    sh)
        config_files="$HOME/.ashrc $HOME/.profile /etc/profile"
    ;;
    *)
        # Default case if none of the above matches
        config_files="$HOME/.bashrc $HOME/.bash_profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile"
    ;;
esac

if [[ "$no_modify_path" != "true" ]]; then
    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    # A new Mac has no ~/.zshrc, so create the shell's main config file rather than leaving opencode off PATH.
    if [[ -z $config_file ]]; then
        case $current_shell in
            zsh) new_config_file="${ZDOTDIR:-$HOME}/.zshrc" ;;
            fish) new_config_file="$HOME/.config/fish/config.fish" ;;
            *) new_config_file="" ;;
        esac
        if [[ -n $new_config_file ]] && mkdir -p "$(dirname "$new_config_file")" 2>/dev/null && touch "$new_config_file" 2>/dev/null; then
            config_file=$new_config_file
        fi
    fi

    if [[ -z $config_file ]]; then
        print_message warning "No config file found for $current_shell. You may need to manually add to PATH:"
        print_message info "  export PATH=$INSTALL_DIR:\$PATH"
    elif [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
        case $current_shell in
            fish)
                add_to_path "$config_file" "fish_add_path $INSTALL_DIR"
            ;;
            zsh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            bash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            ash)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            sh)
                add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH"
            ;;
            *)
                export PATH=$INSTALL_DIR:$PATH
                print_message warning "Manually add the directory to $config_file (or similar):"
                print_message info "  export PATH=$INSTALL_DIR:\$PATH"
            ;;
        esac
    fi
fi

if [ -n "${GITHUB_ACTIONS-}" ] && [ "${GITHUB_ACTIONS}" == "true" ]; then
    echo "$INSTALL_DIR" >> $GITHUB_PATH
    print_message info "Added $INSTALL_DIR to \$GITHUB_PATH"
fi

pkg_install() {
    local sudo_cmd=""
    # sudo -n keeps a piped `curl | bash` install from hanging on a password prompt.
    if [ "$(id -u)" != "0" ] && command -v sudo >/dev/null 2>&1; then
        sudo_cmd="sudo -n"
    fi
    if command -v brew >/dev/null 2>&1; then
        brew install "$1"
    elif command -v apt-get >/dev/null 2>&1; then
        $sudo_cmd apt-get install -y "$1"
    elif command -v dnf >/dev/null 2>&1; then
        $sudo_cmd dnf install -y "$1"
    elif command -v pacman >/dev/null 2>&1; then
        $sudo_cmd pacman -S --noconfirm "$1"
    elif command -v apk >/dev/null 2>&1; then
        $sudo_cmd apk add "$1"
    else
        return 1
    fi
}

install_voice_deps() {
    case "$(uname -s)" in
        Darwin*|Linux*) ;;
        *)
            print_message warning "Voice setup is only supported on macOS and Linux, skipping."
            return 0
            ;;
    esac

    # Recorder binary for push-to-talk capture.
    if command -v rec >/dev/null 2>&1 || command -v sox >/dev/null 2>&1 || command -v arecord >/dev/null 2>&1 || command -v ffmpeg >/dev/null 2>&1; then
        print_message info "${MUTED}Audio recorder already installed${NC}"
    else
        print_message info "${MUTED}Installing ${NC}sox${MUTED} (audio recorder for /voice)${NC}"
        if ! pkg_install sox; then
            print_message warning "Could not install sox automatically. Install sox, arecord, or ffmpeg manually to use /voice."
        fi
    fi

    # Local whisper.cpp so /voice works offline without an OpenAI key.
    if ! command -v whisper-cli >/dev/null 2>&1 && ! command -v whisper-cpp >/dev/null 2>&1; then
        print_message info "${MUTED}Installing ${NC}whisper-cpp${MUTED} (local transcription)${NC}"
        if ! pkg_install whisper-cpp; then
            print_message warning "Could not install whisper-cpp automatically. Build it from https://github.com/ggml-org/whisper.cpp or configure an OpenAI key; /voice will fall back to OpenAI."
            return 0
        fi
    fi

    # Model path must match the server default in packages/opencode/src/voice/transcription.ts.
    local model_dir="${XDG_DATA_HOME:-$HOME/.local/share}/bolt/models"
    local model="$model_dir/ggml-large-v3-turbo-q5_0.bin"
    if [ -f "$model" ]; then
        print_message info "${MUTED}Voice model already downloaded${NC}"
        return 0
    fi
    mkdir -p "$model_dir"
    print_message info "${MUTED}Downloading ${NC}whisper large-v3-turbo q5 (~0.6 GB)${MUTED} for offline voice input${NC}"
    if ! curl -# -f -L -o "$model.part" "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin"; then
        rm -f "$model.part"
        print_message warning "Model download failed; /voice will fall back to OpenAI (requires an API key)."
        return 0
    fi
    mv "$model.part" "$model"
    print_message info "${MUTED}Voice model installed at ${NC}$model"
}

# Voice setup is on by default but skipped in CI, where a 0.6 GB model
# download and system packages are wasted work.
if [[ "$install_voice" == "true" && "${GITHUB_ACTIONS-}" != "true" && "${CI-}" != "true" ]]; then
    install_voice_deps || true
fi

echo -e ""
logo_left=(
  ' /$$$$$$$   /$$$$$$  /$$    /$$$$$$'
  '| $$__  $$ /$$__  $$| $$   |__  $$__/'
  '| $$  \ $$| $$  \ $$| $$    | | $$   '
  '| $$$$$$$ | $$  | $$| $$      | $$   '
  '| $$__  $$| $$  | $$| $$      | $$   '
  '| $$  \ $$| $$  | $$| $$      | $$   '
  '| $$$$$$$/|  $$$$$$/| $$$$$$$$| $$   '
  '|_______/  \______/ |________/|__/   '
)
logo_right=(
  '      /$$$$$$  /$$       /$$$$$$'
  '     /$$__  $$| $$      |_  $$_/'
  '    | $$  \__/| $$        | $$  '
  '    | $$      | $$        | $$  '
  '    | $$      | $$        | $$  '
  '    | $$    $$| $$        | $$  '
  '    |  $$$$$$/| $$$$$$$$ /$$$$$$'
  '     \______/ |________/|______/'
)
for i in "${!logo_left[@]}"; do
  printf "${MUTED}  %s %s ${NC}\n" "${logo_left[i]}" "${logo_right[i]}"
done
echo -e ""
echo -e ""
echo -e "${MUTED}Bolt CLI includes free models, to start:${NC}"
echo -e ""
if [[ $path_added == "true" ]]; then
    echo -e "exec \$SHELL   ${MUTED}# Reload PATH (or open a new terminal)${NC}"
fi
echo -e "cd <project>  ${MUTED}# Open directory${NC}"
echo -e "bolt          ${MUTED}# Run command${NC}"
echo -e ""
echo -e "${MUTED}For more information visit ${NC}https://github.com/bolt-builder/bolt-cli"
echo -e ""
echo -e ""