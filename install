#!/usr/bin/env bash
# moks installer (source-oriented stub)
# Binary releases are not ready. This script does not download upstream OpenCode.
set -euo pipefail

APP=moks
INSTALL_DIR="${MOKS_INSTALL_DIR:-$HOME/.moks/bin}"

MUTED='\033[0;2m'
RED='\033[0;31m'
NC='\033[0m'

usage() {
    cat <<EOF
moks installer

Binary releases are not ready yet. Install from source:

  git clone https://github.com/artemysone/moks.git
  cd moks
  bun install
  bun dev

Optional later:
  MOKS_INSTALL_DIR=$INSTALL_DIR   # default: ~/.moks/bin
  ./install --binary /path/to/moks

moks is based on OpenCode (MIT) and is not officially affiliated with OpenCode.

Usage: install [options]

Options:
    -h, --help              Display this help message
    -b, --binary <path>     Install a local binary into $INSTALL_DIR
        --no-modify-path    Don't modify shell config files
EOF
}

no_modify_path=false
binary_path=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -b|--binary)
            if [[ -n "${2:-}" ]]; then
                binary_path="$2"
                shift 2
            else
                echo -e "${RED}Error: --binary requires a path argument${NC}"
                exit 1
            fi
            ;;
        --no-modify-path)
            no_modify_path=true
            shift
            ;;
        -v|--version)
            echo -e "${RED}Error: binary releases are not ready. Install from source (see --help).${NC}"
            exit 1
            ;;
        *)
            echo -e "${RED}Unknown option '$1'${NC}" >&2
            usage
            exit 1
            ;;
    esac
done

if [ -z "$binary_path" ]; then
    cat <<EOF

${APP}: binary releases are not ready yet.

Install from source:

  git clone https://github.com/artemysone/moks.git
  cd moks
  bun install
  bun dev

Docs: https://github.com/artemysone/moks/blob/dev/README.md
Fork facts: docs/FORK.md

Based on OpenCode (MIT). Not officially affiliated with OpenCode.

EOF
    exit 0
fi

if [ ! -f "$binary_path" ]; then
    echo -e "${RED}Error: Binary not found at ${binary_path}${NC}"
    exit 1
fi

mkdir -p "$INSTALL_DIR"
cp "$binary_path" "${INSTALL_DIR}/${APP}"
chmod 755 "${INSTALL_DIR}/${APP}"
echo -e "${MUTED}Installed ${NC}${APP}${MUTED} to ${NC}${INSTALL_DIR}/${APP}"

add_to_path() {
    local config_file=$1
    local command=$2

    if grep -Fxq "$command" "$config_file"; then
        echo "Command already exists in $config_file, skipping write."
    elif [[ -w $config_file ]]; then
        echo -e "\n# moks" >> "$config_file"
        echo "$command" >> "$config_file"
        echo -e "${MUTED}Added ${NC}${APP}${MUTED} to \$PATH in ${NC}$config_file"
    else
        echo "Manually add to $config_file:"
        echo "  $command"
    fi
}

if [[ "$no_modify_path" != "true" ]] && [[ ":$PATH:" != *":$INSTALL_DIR:"* ]]; then
    XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
    current_shell=$(basename "$SHELL")
    case $current_shell in
        fish) config_files="$HOME/.config/fish/config.fish" ;;
        zsh)  config_files="${ZDOTDIR:-$HOME}/.zshrc ${ZDOTDIR:-$HOME}/.zshenv $XDG_CONFIG_HOME/zsh/.zshrc $XDG_CONFIG_HOME/zsh/.zshenv" ;;
        bash) config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile $XDG_CONFIG_HOME/bash/.bashrc $XDG_CONFIG_HOME/bash/.bash_profile" ;;
        *)    config_files="$HOME/.bashrc $HOME/.bash_profile $HOME/.profile" ;;
    esac

    config_file=""
    for file in $config_files; do
        if [[ -f $file ]]; then
            config_file=$file
            break
        fi
    done

    if [[ -z $config_file ]]; then
        echo "No shell config found. Add to PATH:"
        echo "  export PATH=$INSTALL_DIR:\$PATH"
    else
        case $current_shell in
            fish) add_to_path "$config_file" "fish_add_path $INSTALL_DIR" ;;
            *)    add_to_path "$config_file" "export PATH=$INSTALL_DIR:\$PATH" ;;
        esac
    fi
fi

echo ""
echo "Run: ${APP}"
echo "Docs: https://github.com/artemysone/moks"
echo ""
